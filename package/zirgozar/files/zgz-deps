#
# zgz-deps - make sure the router has what this needs, on its own.
#
#   zgz-deps check     what is missing, and what actually works  (JSON)
#   zgz-deps install   install whatever is missing
#
# The package metadata already declares these, so a normal install pulls them
# in. This exists for the cases where that is not enough: a package installed
# by hand from a release page, an image built without the kernel modules, an
# upgrade that dropped one. None of it assumes any other program has
# already been here - it is a fresh OpenWrt that has to work.
#
# It reports two different things, and the difference matters. A package can
# be installed and the thing it provides still not work - a kernel module for
# a kernel that was replaced, an `ip` that is really busybox wearing the name.
# So there is a list of missing packages, and separately a set of questions
# put to the running system: can it transparently proxy, can it do policy
# routing, can it fetch over HTTPS. It is the second set that decides whether
# the tunnel will work, and it is the second set the page shows first.
#
# Nothing here installs, removes or upgrades xray-core. A router that already
# has one - because another program put it there - is a router that needs nothing,
# and touching that package would break the other program for no gain.

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

pkg_manager() {
	if command -v apk >/dev/null 2>&1 && [ -d /lib/apk ]; then
		echo apk
	elif command -v opkg >/dev/null 2>&1; then
		echo opkg
	else
		echo none
	fi
	return 0
}

# Is there an OpenVPN profile among the configs added by hand? A profile is
# kept as the text of the file, so one of its own lines - client, remote, or
# the block holding its certificate authority - starts a line of it.
has_ovpn_node() {
	uci -q show zirgozar 2>/dev/null | grep -qE "(^|='|^[[:space:]]*)(client|remote[[:space:]]|<ca>|<secret>)"
	return $?
}

# What the accounts in some text need from the router - the settings as a
# whole, or the links just added - read from stdin.
link_wanted() {
	_lw="$(cat)"
	if printf '%s\n' "$_lw" | grep -qE "l2tp(\+ipsec)?://"; then
		echo "xl2tpd ppp-mod-pppol2tp ucode-mod-socket"
		if printf '%s\n' "$_lw" | grep -qE "l2tp\+ipsec://|[?&](psk=|ipsec=1)"; then
			echo "strongswan-default strongswan-swanctl"
		fi
	fi
	# PPTP: pppd's own plugin, the kernel's PPTP and GRE, and MPPE, which
	# almost every PPTP server insists on.
	if printf '%s\n' "$_lw" | grep -q "pptp://"; then
		echo "ppp-mod-pptp kmod-mppe"
	fi
	# SSTP: sstp-client, and OpenSSL's legacy provider for the MD4 its
	# password hash is made with - without it the link is refused with
	# "Could not create password hash".
	if printf '%s\n' "$_lw" | grep -q "sstp://"; then
		echo "sstp-client kmod-mppe libopenssl-legacy"
	fi
	# IKEv2: strongSwan with the ciphers today's servers ask for (OpenSSL's
	# GCM and elliptic curves), EAP for a username and password - MD4 for
	# its MSCHAPv2, and MD5, which a server may ask for before anything else
	# and then not answer a refusal - and the kernel's XFRM device the
	# tunnel is carried on.
	if printf '%s\n' "$_lw" | grep -q "ikev2://"; then
		echo "strongswan-default strongswan-swanctl strongswan-mod-openssl strongswan-mod-eap-identity"
		echo "strongswan-mod-eap-mschapv2 strongswan-mod-md4 strongswan-mod-eap-md5 kmod-xfrm-interface"
		echo "kmod-crypto-gcm kmod-crypto-seqiv ucode-mod-socket"
	fi
	return 0
}

# What is needed, given how this router does firewalling.
wanted() {
	# A connection may be tested before it has been saved in UCI. Install
	# only that protocol's prerequisites when explicitly requested by it.
	if [ "${DEPS_PROTOCOL:-}" = ikev2 ]; then
		printf 'ikev2://required\n' | link_wanted
		return 0
	fi
	echo "dnsmasq-full curl ca-bundle ip-full"
	case "$(firewall_backend)" in
		nft) echo "kmod-nft-tproxy kmod-nft-socket" ;;
		ipt) echo "iptables-mod-tproxy iptables-mod-conntrack-extra" ;;
	esac
	# only needed to install a core later, so not worth failing over
	echo "unzip"
	uci -q show zirgozar 2>/dev/null | link_wanted
	# An OpenVPN config is carried by OpenVPN itself, and by nothing else.
	# Any build of it will do; the OpenSSL one when there is none.
	if [ ! -x /usr/sbin/openvpn ] && ! command -v openvpn >/dev/null 2>&1 && has_ovpn_node; then
		echo "openvpn-openssl"
	fi
	# A profile for a server that speaks only an old cipher - BF-CBC, CAST5,
	# DES - needs OpenSSL's legacy provider; zgz-bridge loads it when it is
	# there. An OpenVPN built on mbed TLS has no providers to load.
	if has_legacy_cipher && ! { _ovv="$(command -v openvpn 2>/dev/null || echo /usr/sbin/openvpn)"; [ -x "$_ovv" ] &&
	   ! "$_ovv" --version 2>/dev/null | head -1 | grep -q OpenSSL; }; then
		echo "libopenssl-legacy"
	fi
	return 0
}

has_legacy_cipher() {
	has_ovpn_node || return 1
	uci -q show zirgozar 2>/dev/null | grep -qiE "(^|='|^[[:space:]]*)cipher[[:space:]]+(BF|CAST5|DES|DESX|RC2|IDEA|SEED)-"
	return $?
}

installed() {
	case "$(pkg_manager)" in
		apk)  apk info -e "$1" 2>/dev/null | grep -q . ;;
		opkg) opkg list-installed "$1" 2>/dev/null | grep -q . ;;
		*) return 1 ;;
	esac
	return $?
}

missing() {
	for _p in $(wanted); do
		installed "$_p" || echo "$_p"
	done
	return 0
}

# ------------------------------------------------------------- does it work

# Not "is iproute2 installed" but "is the `ip` on the path the real one".
# busybox provides a cut-down `ip` under the same name that cannot add a local
# route, and that failure shows up as a tunnel which loads every rule
# perfectly and carries nothing.
have_ip_full() {
	ip -V 2>&1 | grep -qi 'iproute2'
	return $?
}

# The one that catches a fresh router with no certificates: every address this
# program fetches from is HTTPS, and without ca-bundle curl refuses them all
# with an error most people read as "the site is blocked".
have_https() {
	curl -fsS --connect-timeout 10 --max-time 20 -o /dev/null \
		"$(cfg https_probe 'https://raw.githubusercontent.com/Chocolate4U/Iran-v2ray-rules/release/geoip-lite.dat')" 2>/dev/null
	return $?
}

have_tproxy() {
	case "$(firewall_backend)" in
		nft) nft_probe tproxy ;;
		ipt) ipt_probe ;;
		*) return 1 ;;
	esac
	return $?
}

cmd_check() {
	forget_caps
	_missing="$(missing | tr '\n' ' ' | sed 's/ *$//')"

	printf '{"manager":"%s","backend":"%s","missing":[' \
		"$(pkg_manager)" "$(firewall_backend)"
	_first=1
	for _p in $_missing; do
		if [ "$_p" = dnsmasq-full ]; then
			install_dnsmasq_full "$_m" >>"$ZGZ_RUN/deps-install.log" 2>&1 || _failed="$_failed $_p"
			continue
		fi
		[ "$_first" = "1" ] || printf ','
		printf '"%s"' "$_p"
		_first=0
	done
	printf '],"can":{'
	printf '"tproxy":%s,' "$(have_tproxy && echo true || echo false)"
	printf '"policy_routing":%s,' "$(have_ip_full && echo true || echo false)"
	_https_rc=0
	have_https || _https_rc=$?
	printf '"https":%s,' "$([ "$_https_rc" = 0 ] && echo true || echo false)"
	printf '"unzip":%s' "$(command -v unzip >/dev/null 2>&1 && echo true || echo false)"
	printf '},"https_code":%s}\n' "$_https_rc"
	return 0
}

install_done() {
	_rc=$?
	pkg_unlock
	trap - EXIT
	if [ "$_rc" = 0 ]; then
		echo ok > "$ZGZ_RUN/deps-result.new"
	else
		printf 'error %s\n' "$(cat "$ZGZ_MESSAGE" 2>/dev/null || true)" > "$ZGZ_RUN/deps-result.new"
	fi
	mv -f "$ZGZ_RUN/deps-result.new" "$ZGZ_RUN/deps-result"
	rm -f "$ZGZ_RUN/deps.json"
}

cmd_install() {
	pkg_lock || return 1
	trap install_done EXIT
	trap 'exit 1' INT TERM
	: > "$ZGZ_RUN/deps-install.log"
	rm -f "$ZGZ_RUN/deps-result"
	clear_message
	_m="$(pkg_manager)"
	[ "$_m" != "none" ] || {
		say_message "This router has neither opkg nor apk, so nothing can be installed automatically."
		return 1
	}

	_missing="$(missing | tr '\n' ' ' | sed 's/ *$//')"
	if [ -z "$_missing" ]; then
		log "nothing missing"
		return 0
	fi

	log "installing: $_missing"

	# The package index lives in RAM and is empty after every reboot, so this
	# is not optional. It is also the step most likely to fail on a connection
	# that is being interfered with, which is worth saying plainly rather than
	# reporting as "install failed".
	case "$_m" in
		apk)
			case " $_missing " in *" kmod-"*|*" openvpn-"*) ensure_kmods_feed >>"$ZGZ_RUN/deps-install.log" 2>&1 || return 1 ;; esac
			;;
	esac
	pkg_refresh "$_m" "$ZGZ_RUN/deps-install.log" || return 1

	# One at a time, so that a name this OpenWrt happens not to have does not
	# take the rest of the list down with it.
	_failed=""
	for _p in $_missing; do
		# sstp-client carries an example /etc/ppp/chap-secrets that ppp
		# already owns. Refused, apk leaves it half installed and reports an
		# error on every install after it, whatever is being installed; so it
		# is let overwrite the file, and the router's own is put back.
		_force=""
		if [ "$_p" = sstp-client ]; then
			_force="--force-overwrite"
			cp -p /etc/ppp/chap-secrets "$ZGZ_RUN/chap-secrets.keep" 2>/dev/null || true
		fi
		case "$_m" in
			apk)  bounded 180 apk add $_force "$_p" >>"$ZGZ_RUN/deps-install.log" 2>&1 || _failed="$_failed $_p" ;;
			opkg) bounded 180 opkg install $_force "$_p" >>"$ZGZ_RUN/deps-install.log" 2>&1 || _failed="$_failed $_p" ;;
		esac
		if [ -n "$_force" ] && [ -f "$ZGZ_RUN/chap-secrets.keep" ]; then
			cp -p "$ZGZ_RUN/chap-secrets.keep" /etc/ppp/chap-secrets 2>/dev/null || true
			rm -f "$ZGZ_RUN/chap-secrets.keep"
		fi
	done

	# charon reads its plugins when it starts, and not again: one already
	# running goes on without an EAP or a cipher just installed, and the
	# next connection fails for a reason nothing says. Restarted, it has
	# them. A connection it was carrying is made again by its own service.
	case " $_missing " in
		*" strongswan-"*)
			if [ -S /var/run/charon.vici ] && [ -x /etc/init.d/swanctl ]; then
				bounded 30 /etc/init.d/swanctl restart >/dev/null 2>&1 || true
				log "strongSwan restarted to load what was just installed"
			fi
			;;
	esac

	forget_caps

	if [ -n "$_failed" ]; then
		pkg_failure "$ZGZ_RUN/deps-install.log"
		warn "could not install:$_failed"
		return 1
	fi

	_remaining="$(missing | tr '\n' ' ')"
	if [ -n "$_remaining" ]; then
		say_message "The package manager finished but required packages are still missing. See the installation log."
		return 1
	fi
	log "dependencies installed"
	return 0
}

# The router packages the links on stdin need and this router does not have,
# one a line: said on the node page when a node is added, beside a button that
# installs them.
cmd_for() {
	for _p in $(link_wanted); do
		installed "$_p" || echo "$_p"
	done | awk '!seen[$0]++'
	return 0
}

case "${1:-check}" in
	check)   cmd_check ;;
	install)
		DEPS_PROTOCOL="${2:-}"
		case "$DEPS_PROTOCOL" in ''|ikev2) cmd_install ;; *) exit 1 ;; esac
		;;
	for)     cmd_for ;;
	*) echo "usage: $0 check|install|for" >&2; exit 1 ;;
esac
