#!/bin/sh
#
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Part of Zirgozar - https://github.com/dreamboxone/zirgozar
#
# rpcd backend for luci-app-zirgozar (ubus object: luci.zirgozar)
#
# Every method here answers immediately. Anything that takes real time -
# downloading twenty-five megabytes of routing data, installing a core,
# choosing a server - is started in the background and watched through a job
# file, because rpcd reads this script's stdout until every writer has closed
# it: a child that keeps it open holds the browser's request open too, however
# quickly this script itself finishes.

ZGZ_LIB=/usr/libexec
. "$ZGZ_LIB/zgz-common.sh"
. /usr/share/libubox/jshn.sh

CONNECT="$ZGZ_LIB/zgz-connect"
PROBE="$ZGZ_LIB/zgz-probe"
NODES="$ZGZ_LIB/zgz-nodes"
GEO="$ZGZ_LIB/zgz-geo"
CORES="$ZGZ_LIB/zgz-cores"
DEPS="$ZGZ_LIB/zgz-deps"
STATS="$ZGZ_LIB/zgz-stats"
TEST="$ZGZ_LIB/zgz-test"
RULES="$ZGZ_LIB/zgz-rules"
ROUTER="$ZGZ_LIB/zgz-router"

JOB="$ZGZ_RUN/job"

meta_get() { sed -n "s/^$1=//p" "$ZGZ_BEST_META" 2>/dev/null | tail -1; }
prog_get() { sed -n "s/^$1=//p" "$ZGZ_PROGRESS" 2>/dev/null | tail -1; }

num() {
	case "$1" in
		''|*[!0-9]*) echo 0 ;;
		*) echo "$1" ;;
	esac
}

# Run something without holding this request open. rpcd reads our stdout until
# every writer closes it, so a child that keeps it would hang the browser call
# however fast we answer.
detach() {
	if command -v setsid >/dev/null 2>&1; then
		setsid "$@" </dev/null >/dev/null 2>&1 &
	else
		( "$@" </dev/null >/dev/null 2>&1 & ) &
	fi
	return 0
}

# A long job, with a name the page can show while it runs.
run_job() {
	_name="$1"; shift
	detach /bin/sh -c "echo '$_name' > '$JOB'; $* >/dev/null 2>&1; rm -f '$JOB'"
	return 0
}

# --------------------------------------------------------------------- state

method_state() {
	local running=0 connected=0 active=0 autostart=0 backend geo=0 pw=0 bridge_on=0 cpath=""

	# Asked three times a minute while a page is open, on routers where every
	# process started costs ten or twenty milliseconds. So the few questions
	# that need a program are asked once each, and everything that is only a
	# file - the chosen node, the progress, the core - is read by one awk that
	# writes the answer, rather than by a sed and a tail per field and a shell
	# JSON library on top: that came to three quarters of a second.
	tunnel_running && running=1

	backend="$(firewall_backend)"
	case "$backend" in
		nft) nft list table inet zirgozar >/dev/null 2>&1 && active=1 ;;
		ipt) iptables -t mangle -S ZGZ_PRE >/dev/null 2>&1 && active=1 ;;
	esac

	# Connected has to mean traffic is going through the tunnel, not merely
	# that a process is alive. The core can be running perfectly with no rules
	# in front of it, and then every byte leaves exactly as it did before while
	# the page reports a connection - which is the most misleading thing this
	# page could possibly do.
	[ "$running" = "1" ] && [ -s "$ZGZ_BEST" ] && [ "$active" = "1" ] && connected=1

	# what `/etc/init.d/zirgozar enabled` tests, done inline so that a busy procd
	# can never hold this request open
	for l in /etc/rc.d/S??zirgozar; do
		[ -L "$l" ] && autostart=1
	done

	geo_dir >/dev/null 2>&1 && geo=1
	passwall_running && pw=1
	# The core, as PassWall2 shows it at the top of its page, read from what
	# the service wrote when it started it - not by starting a core every few
	# seconds to learn its version number. Before any has run, the one that
	# would be.
	if [ ! -s "$ZGZ_RUN/core.info" ]; then
		for _x in $(cfg core_xray '') $(xray_paths); do
			[ -x "$_x" ] && { cpath="$_x"; break; }
		done
	fi
	if [ -s "$ZGZ_RUN/core.info" ] && grep -q '^bridge=' "$ZGZ_RUN/core.info" 2>/dev/null; then
		pgrep -f "$ZGZ_BRIDGE_JSON" >/dev/null 2>&1 && bridge_on=1
		# Vwarp is given its options on the command line, not that file.
		if [ "$bridge_on" = "0" ]; then
			_bb="$(sed -n 's/^bridge=//p' "$ZGZ_RUN/core.info" 2>/dev/null | head -1)"
			[ -n "$_bb" ] && pgrep -f "^$_bb --bind" >/dev/null 2>&1 && bridge_on=1
		fi
	fi

	# Where the tunnel comes out, for the flag beside the address: asked again
	# in the background when the node is not the one it was asked about, when
	# the last answer was no answer, and every quarter of an hour - a node's
	# way out can move. Only while connected, when there is a way out to ask.
	_ex=""
	if [ "$connected" = "1" ]; then
		_ex="$ZGZ_RUN/exit"
		if ! cmp -s "$ZGZ_BEST_META" "$_ex.meta" 2>/dev/null ||
		   [ -n "$(find "$_ex" -mmin +15 2>/dev/null)" ] ||
		   { ! grep -q '^cc=..$' "$_ex" 2>/dev/null && [ -n "$(find "$_ex" -mmin +1 2>/dev/null)" ]; }; then
			[ -d "$_ex.lock" ] || detach "$TEST" exit
		fi
		# The answer about another node is not shown at all.
		cmp -s "$ZGZ_BEST_META" "$_ex.meta" 2>/dev/null || _ex=""
	fi

	# A fingerprint of the web pages as they are on the router, for the pages
	# themselves to notice that the copy the browser kept is not this one -
	# after an update, and after a file was replaced by hand alike.
	_ui="$(ls -ln --full-time /www/luci-static/resources/view/zirgozar /www/luci-static/resources/zirgozar 2>/dev/null | md5sum 2>/dev/null | cut -c1-12)"

	uci -q show zirgozar.config 2>/dev/null | LC_ALL=C awk \
		-v exitf="$_ex" -v uistamp="$_ui" \
		-v running="$running" -v connected="$connected" -v autostart="$autostart" \
		-v backend="$backend" -v geo="$geo" -v pw="$pw" -v bridge_on="$bridge_on" -v cpath="$cpath" \
		-v vfile="$ZGZ_VERSION_FILE" -v sfile="$ZGZ_STATUS" -v mfile="$ZGZ_MESSAGE" -v jfile="$JOB" \
		-v meta="$ZGZ_BEST_META" -v prog="$ZGZ_PROGRESS" -v cinfo="$ZGZ_RUN/core.info" '
		function esc(s) {
			gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s)
			gsub(/\n/, "\\n", s); gsub(/\r/, "\\r", s); gsub(/\t/, "\\t", s)
			return s
		}
		function whole(f,   l, out, n) {
			out = ""; n = 0
			while ((getline l < f) > 0) out = out (n++ ? "\n" : "") l
			close(f)
			return out
		}
		# key=value files: the last value of a key wins, as with sed | tail -1.
		function kv(f, arr,   l, i) {
			while ((getline l < f) > 0) {
				i = index(l, "=")
				if (i > 1) arr[substr(l, 1, i - 1)] = substr(l, i + 1)
			}
			close(f)
		}
		function num(v) { return (v ~ /^[0-9]+$/) ? v + 0 : 0 }
		function b(v) { return (v == "1") ? "true" : "false" }
		function str(k, v) { printf ",\"%s\":\"%s\"", k, esc(v) }
		function int_(k, v) { printf ",\"%s\":%d", k, num(v) }
		function bool(k, v) { printf ",\"%s\":%s", k, b(v) }
		{
			# zirgozar.config.key='\''value'\''
			l = $0; sub(/^zirgozar\.config\./, "", l)
			i = index(l, "=")
			if (i > 1) { v = substr(l, i + 1); gsub(/^'\''|'\''$/, "", v); cfg[substr(l, 1, i - 1)] = v }
		}
		END {
			kv(meta, M); kv(prog, P); kv(cinfo, C)
			if (exitf != "") kv(exitf, X)
			ver = whole(vfile); if (ver == "") ver = "unknown"
			en = cfg["enabled"]; en = (en == "1" || en == "on" || en == "true" || en == "yes" || en == "enabled") ? "1" : "0"
			ri = cfg["route_ir"]; ri = (ri == "1" || ri == "on" || ri == "true" || ri == "yes" || ri == "enabled") ? "1" : "0"
			se = ("stats_enabled" in cfg) ? cfg["stats_enabled"] : "1"
			se = (se == "1" || se == "on" || se == "true" || se == "yes" || se == "enabled") ? "1" : "0"
			bb = C["bridge"]; sub(/.*\//, "", bb)
			"date +%s" | getline now; close("date +%s")
			printf "{\"version\":\"%s\"", esc(ver)
			bool("running", running); bool("connected", connected); bool("enabled", en); bool("autostart", autostart)
			str("status", whole(sfile)); str("message", whole(mfile)); str("job", whole(jfile))
			str("server", M["label"]); str("protocol", M["protocol"]); str("host", M["host"]); int_("latency_ms", M["latency_ms"])
			str("exit_cc", X["cc"]); str("exit_ip", X["ip"]); str("ui", uistamp)
			str("phase", P["phase"]); int_("total", P["total"]); int_("done", P["done"]); int_("alive", P["alive"]); int_("tested", P["tested"])
			str("core_path", ("path" in C && C["path"] != "") ? C["path"] : cpath)
			str("core_name", (C["name"] != "") ? C["name"] : "xray")
			str("core_version", C["version"]); bool("core_running", running)
			str("bridge", bb); str("bridge_version", C["bridge_version"]); bool("bridge_running", bridge_on)
			str("backend", backend); bool("route_ir", ri); bool("stats_enabled", se)
			bool("geo_ready", geo); bool("passwall", pw); int_("now", now)
			print "}"
		}'
}

# ------------------------------------------------------------------- traffic

method_traffic() {
	_t="$("$STATS" json 2>/dev/null)"
	[ -n "$_t" ] || _t='{"today":{"up":0,"down":0,"direct_up":0,"direct_down":0},"week":{"up":0,"down":0,"direct_up":0,"direct_down":0},"month":{"up":0,"down":0,"direct_up":0,"direct_down":0},"days":[]}'
	echo "$_t"
}

# --------------------------------------------------------------------- nodes

# Every server we know about, with whatever has been measured for it. The
# ranked file has the ones that completed a request; the reachable file has
# handshake times for the rest.
method_nodes() {
	# The node in use, by what it is rather than by its tag: a node chosen in
	# Basic Settings is read on its own, and its tag is not the one it has in
	# this list - "n0" there, whatever it is here - which marked the first node
	# of the list as the one in use.
	# No list yet - nothing read, or only nodes added by hand - is an empty
	# answer. Left to awk, it had already written the opening of the object
	# when it found no file, the fallback was written after it, and the page
	# was handed {"nodes":[{"nodes":[],"count":0} - which it cannot read.
	if [ ! -r "$ZGZ_CANDIDATES" ]; then
		echo '{"nodes":[],"count":0}'
		return 0
	fi
	_cur="$(meta_get label)|$(meta_get protocol)|$(meta_get host)|$(meta_get port)"
	awk -F'\t' -v cur="$_cur" \
		-v ranked="$ZGZ_RANKED" -v alive="$ZGZ_RUN/alive.tsv" '
		BEGIN {
			while ((getline line < ranked) > 0) {
				split(line, r, "\t")
				ms[r[2]] = r[1]
			}
			close(ranked)
			while ((getline line < alive) > 0) {
				split(line, a, "\t")
				hs[a[2]] = a[1] + 0
			}
			close(alive)
			printf "{\"nodes\":["
			n = 0
		}
		{
			if (n++ > 0) printf ","
			lab = $2
			gsub(/\\/, "\\\\", lab)
			gsub(/"/, "\\\"", lab)
			printf "{\"tag\":\"%s\",\"label\":\"%s\",\"protocol\":\"%s\",\"host\":\"%s\",\"port\":%d,\"ms\":%d,\"handshake\":%d,\"current\":%s}",
				$1, lab, $3, $4, $5,
				(($1 in ms) ? ms[$1] : 0),
				(($1 in hs) ? hs[$1] : 0),
				((!found && $2 "|" $3 "|" $4 "|" $5 == cur && (found = 1)) ? "true" : "false")
		}
		END { printf "],\"count\":%d}\n", n }
	' "$ZGZ_CANDIDATES" 2>/dev/null
}

method_nodeorigins() {
	local input tags tag origin
	read -r input
	[ -n "$input" ] || input='{}'
	json_load "$input" 2>/dev/null
	json_get_var tags tags
	json_init
	json_add_object origins
	for tag in $tags; do
		case "$tag" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
		origin="$("$NODES" origin "$tag" 2>/dev/null)" || origin=""
		[ -n "$origin" ] && json_add_string "$tag" "$origin"
	done
	json_close_object
	json_dump
}

# What the three per-node buttons have measured so far. Keys are
# "<id>.<kind>"; the numbers are milliseconds, with -1 for still running and
# -2 for a test that cannot be run on that node at all.
method_tests() {
	"$TEST" json 2>/dev/null || echo '{"tests":{}}'
}

# Which hand-added section is the node the tunnel is on, so that the web
# interface can refuse to delete it. Asked only when somebody presses Delete -
# it walks the sections and parses each link, which is not polling work.
method_inuse() {
	"$NODES" inuse 2>/dev/null || echo '{"section":"","host":"","port":"","active":false}'
}

# What this program has told the system log.
#
# All of it was already there; what was missing was any way to read it without
# an SSH session and knowing the incantation. Bounded to the last few hundred
# lines, because the whole of a router's log is not something to hand to a
# browser every five seconds.
method_log() {
	json_init
	# The runtime log, PassWall2's way: this program's own file, a date on
	# every line, emptied by the button on the page. Before this release
	# there was no file, so the system log stands in until there is one.
	# The file's being there is what counts, not its having something in it:
	# an emptied one is a log that was cleared, and reading the system log in
	# its place brought every cleared line straight back.
	if [ -e "$ZGZ_LOG" ]; then
		json_add_string "text" "$(tail -n 400 "$ZGZ_LOG" 2>/dev/null)"
	else
		json_add_string "text" "$(logread -e zirgozar 2>/dev/null | tail -300)"
	fi
	# And what the cores themselves said. procd hands their output to the
	# system log under the program's own name.
	json_add_string "core" "$(core_log | tail -300)"
	json_dump
}

# The cores' lines in the system log, from after the last one there was when
# the page's button cleared them. The system log itself cannot be emptied,
# so clearing remembers the line it stopped at. Once that line has rotated
# out of the log, so has everything older than it, and all of it is new.
CORE_LOG_MARK="$ZGZ_RUN/core-log.mark"

core_log_all() {
	logread 2>/dev/null | grep -E ' (xray|sing-box|sing-box-lx|hysteria)\[[0-9]+\]:'
	return 0
}

core_log() {
	M="$(cat "$CORE_LOG_MARK" 2>/dev/null)" core_log_all_marked
	return 0
}

core_log_all_marked() {
	core_log_all | awk 'BEGIN { m = ENVIRON["M"] }
		m != "" && $0 == m { c = NR; next }
		{ a[NR] = $0 }
		END { for (i = c + 1; i <= NR; i++) if (i in a) print a[i] }'
	return 0
}

# PassWall2's connection check: one request to a well-known site, timed.
# From the router, so what it measures is the router's own way out - which
# for a site the tunnel carries is the tunnel, once the router's own lookups
# go through it.
method_check() {
	local input url code t
	read -r input
	[ -n "$input" ] || input='{}'
	json_load "$input" 2>/dev/null
	json_get_var url url
	case "$url" in
		https://*|http://*) : ;;
		*) json_init; json_add_int "ms" 0; json_dump; return ;;
	esac
	t="$(curl -o /dev/null -I -sk --connect-timeout 3 --max-time 6 \
		-w '%{http_code} %{time_appconnect} %{time_connect}' "$url" 2>/dev/null)" || t=""
	code="${t%% *}"
	json_init
	if [ -n "$code" ] && [ "$code" != "000" ]; then
		json_add_int "ms" "$(printf '%s' "$t" | awk '{ v = ($2 > 0) ? $2 : $3; m = int(v * 1000 + 0.5); if (m < 1) m = 1; print m }')"
	else
		json_add_int "ms" 0
	fi
	json_dump
}

# What the Access Control page needs to offer choices rather than ask for
# names: the LAN interfaces, and the nodes added by hand, which are the only
# ones that stay put long enough for a rule to name one.
method_lan() {
	printf '{"interfaces":%s}
' "$(interfaces_json)"
}

# PassWall2's Export Config File: one hand-added node as a whole Xray client
# configuration, to be run somewhere else - a SOCKS port on 1080 and an HTTP
# port on 1081 in front of it. The node as saved, with its own chain and the
# Xray tab, but without what belongs to this router: the firewall's mark and
# the way the tunnel resolves a server's name.
method_nodeconfig() {
	local input sid rec proto out chains ZGZ_OUT_MARK=""
	read -r input
	[ -n "$input" ] || input='{}'
	json_load "$input" 2>/dev/null
	json_get_var sid sid
	case "$sid" in
		''|*[!A-Za-z0-9_]*) fail "no node given"; return ;;
	esac
	rec="$(node_records "$sid" 1 2>/dev/null | head -1)"
	[ -n "$rec" ] || { fail "unreadable"; return; }
	# Plain WARP, once it has an account, is a WireGuard peer Xray can carry.
	[ "$(printf '%s' "$rec" | cut -f3)" != "warp" ] ||
		rec="$(printf '%s\n' "$rec" | warp_natives)"
	[ -n "$rec" ] || { fail "not xray"; return; }
	proto="$(printf '%s' "$rec" | cut -f3)"
	case "$proto" in
		hysteria2|hysteria|tuic|openvpn|amneziawg|warp) fail "not xray"; return ;;
	esac
	out="$(printf '%s\n' "$rec" | DOMSTRAT="" decorate | cut -f6- | sed 's/^{/{"tag":"proxy",/')"
	chains="$(chain_outbounds "$out" | while read -r _co; do [ -n "$_co" ] && printf ',%s' "$_co"; done)"
	json_init
	json_add_boolean "ok" 1
	json_add_string "config" "$(printf '{"log":{"loglevel":"warning"},"inbounds":[{"tag":"socks","listen":"127.0.0.1","port":1080,"protocol":"socks","settings":{"udp":true},"sniffing":{"enabled":true,"destOverride":["http","tls","quic"]}},{"tag":"http","listen":"127.0.0.1","port":1081,"protocol":"http"}],"outbounds":[%s%s,{"tag":"direct","protocol":"freedom"},{"tag":"block","protocol":"blackhole"}]}' "$out" "$chains")"
	json_dump
}

# A WARP node's account, for its page: whether there is one, what kind, and
# whether warp-plus is there to use it. Whether a job is still making it, and
# the last thing said about it, come along so the page needs one call.
method_warp() {
	local input sid
	read -r input
	[ -n "$input" ] || input='{}'
	json_load "$input" 2>/dev/null
	json_get_var sid sid
	case "$sid" in
		''|*[!A-Za-z0-9_]*) fail "no node given"; return ;;
	esac
	_wi="$("$ZGZ_LIB/zgz-warp" info "$sid" 2>/dev/null)" || _wi=""
	[ -n "$_wi" ] || _wi='{"warp":false}'
	printf '{"info":%s,"job":"%s","message":"%s"}\n' "$_wi" \
		"$(json_escape "$(cat "$JOB" 2>/dev/null)")" \
		"$(json_escape "$(cat "$ZGZ_RUN/warp-$sid.message" 2>/dev/null)")"
}

# The Server-Side page's status line: which of the two cores is running its
# servers, and why one is not.
method_server() {
	_si="$ZGZ_RUN/server.info"
	json_init
	json_add_boolean "enabled" "$([ "$(uci -q get zirgozar_server.global.enable)" = "1" ] && echo 1 || echo 0)"
	json_add_boolean "xray" "$(pgrep -f 'zirgozar-server.json' >/dev/null 2>&1 && echo 1 || echo 0)"
	json_add_boolean "singbox" "$(pgrep -f 'zirgozar-server-sb.json' >/dev/null 2>&1 && echo 1 || echo 0)"
	json_add_string "xray_error" "$(sed -n 's/^xray_error=//p' "$_si" 2>/dev/null | tail -1)"
	json_add_string "singbox_error" "$(sed -n 's/^singbox_error=//p' "$_si" 2>/dev/null | tail -1)"
	json_add_string "ports" "$("$ZGZ_LIB/zgz-server" ports 2>/dev/null | tr '\n' ' ')"
	json_dump
}

# The Geo View page's two questions, answered by zgz-geo with Geoview.
method_geoview() {
	local input action value out
	read -r input
	json_load "$input" 2>/dev/null || true
	json_get_var action action
	json_get_var value value
	case "$action" in lookup|extract) : ;; *) action=lookup ;; esac
	out="$("$GEO" view "$action" "$value" 2>/dev/null)"
	json_init
	case "$out" in
		@nogeoview*) json_add_string "error" "nogeoview" ;;
		@nogeo*)     json_add_string "error" "nogeo" ;;
		@bad*)       json_add_string "error" "bad" ;;
		*)
			json_add_string "result" "$(printf '%s\n' "$out" | sed '/^--rules--$/,$d')"
			json_add_string "rules" "$(printf '%s\n' "$out" | sed '1,/^--rules--$/d')"
			;;
	esac
	json_dump
}

# The nodes of every subscription, for the node choice in Basic Settings.
method_subnodes() {
	"$NODES" subnodes 2>/dev/null | awk -F'\t' 'BEGIN { printf "{\"nodes\":["; n = 0 }
		NF >= 6 {
			for (i = 1; i <= NF; i++) { gsub(/\\/, "\\\\", $i); gsub(/"/, "\\\"", $i) }
			printf "%s{\"sub\":\"%s\",\"subname\":\"%s\",\"protocol\":\"%s\",\"host\":\"%s\",\"port\":%d,\"label\":\"%s\",\"fp\":\"%s\"}", (n++ ? "," : ""), $1, $2, $3, $4, $5, $6, $7
		}
		END { printf "]}\n" }'
}

method_subs() {
	# Before any subscription has been read there is no file - see method_nodes.
	if [ ! -r "$ZGZ_RUN/subs.status" ]; then
		echo '{"subs":[],"count":0}'
		return 0
	fi
	awk -F'\t' 'BEGIN { printf "{\"subs\":["; n = 0 }
		{
			if (n++ > 0) printf ","
			for (i = 1; i <= NF; i++) { gsub(/\\/, "\\\\", $i); gsub(/"/, "\\\"", $i) }
			printf "{\"name\":\"%s\",\"url\":\"%s\",\"count\":%d,\"when\":%d,\"error\":\"%s\",\"section\":\"%s\",\"rem\":%.0f,\"expire\":%.0f}",
				$1, $2, $3, $4, $5, $6, ($7 == "" ? -1 : $7), ($8 == "" ? -1 : $8)
		}
		END { printf "],\"count\":%d}\n", n }' \
		"$ZGZ_RUN/subs.status" 2>/dev/null
}

# ------------------------------------------------------------------- system

# Every network on this router with a device behind it, for the settings page
# to offer instead of asking the reader to know a device name and type it
# correctly.
#
# Answered here rather than from LuCI's own network model, which is the
# thorough way to ask and takes seconds on a router this size - three or four
# of them between pressing Settings and the page appearing. This is one ubus
# list and one call per interface, and the page already asks for this object.
interfaces_json() {
	_out=""
	_known=""
	_skip=""
	if [ -r /lib/functions/network.sh ]; then
		. /lib/functions/network.sh
		for _iface in $(ubus list 'network.interface.*' 2>/dev/null | sed 's/network\.interface\.//'); do
			_dev=""
			network_get_device _dev "$_iface" 2>/dev/null || _dev=""
			case "$_iface" in
				loopback|wan|wan6|wwan|wan_*) _skip="$_skip $_dev"; continue ;;
			esac
			if [ -n "$_dev" ] && [ "$_dev" != "lo" ]; then
				if [ -n "$_out" ]; then _out="$_out,"; fi
				_out="$_out{\"net\":\"$(json_escape "$_iface")\",\"dev\":\"$(json_escape "$_dev")\"}"
				_known="$_known $_dev"
			fi
		done
	fi
	# Then every other network device the kernel has - tailscale0, wg0, tun0 and
	# the like, which netifd is often not told about - except those that are
	# only a part of something listed: a port of a bridge, the WAN, and the
	# plumbing no one routes from.
	for _p in /sys/class/net/*; do
		_d="${_p##*/}"
		[ -e "$_p" ] || continue
		case "$_d" in
			lo|bonding_masters|ifb*|sit*|ip6tnl*|ip6gre*|gre*|gretap*|erspan*|teql*|dummy*|*mon|mon.*|phy*) continue ;;
		esac
		[ -e "$_p/master" ] && continue
		case " $_known $_skip " in *" $_d "*) continue ;; esac
		if [ -n "$_out" ]; then _out="$_out,"; fi
		_out="$_out{\"net\":\"$(json_escape "$_d")\",\"dev\":\"$(json_escape "$_d")\"}"
	done
	echo "[$_out]"
	return 0
}

method_system() {
	# What each project has published is read from a file here and refreshed
	# in the background, so that a page polling every five seconds never waits
	# on GitHub. The refresh itself does nothing when the file is fresh.
	detach "$CORES" latest

	# The dependency check loads a test ruleset into the kernel and fetches a
	# file over HTTPS - a second and more, and a request to GitHub on every
	# poll of a page left open. What it finds changes when something is
	# installed, so it is kept for ten minutes and thrown away by an install.
	_dc="$ZGZ_RUN/deps.json"
	_deps=""
	if [ -s "$_dc" ]; then
		_age=$(( $(date +%s) - $(date -r "$_dc" +%s 2>/dev/null || echo 0) ))
		[ "$_age" -ge 0 ] && [ "$_age" -lt 600 ] && _deps="$(cat "$_dc" 2>/dev/null)"
	fi
	if [ -z "$_deps" ]; then
		_deps="$("$DEPS" check 2>/dev/null)" || _deps=""
		[ -n "$_deps" ] && printf '%s\n' "$_deps" > "$_dc" 2>/dev/null
	fi

	printf '{"geo":%s,"cores":%s,"deps":%s,"interfaces":%s,"job":"%s","self":"%s"}\n' \
		"$("$GEO" status 2>/dev/null || echo '{}')" \
		"$("$CORES" list 2>/dev/null || echo '{}')" \
		"${_deps:-{\}}" \
		"$(interfaces_json)" \
		"$(cat "$JOB" 2>/dev/null)" \
		"$(json_escape "$(cat "$ZGZ_RUN/self-update" 2>/dev/null)")"
}

# -------------------------------------------------------------------- action

method_action() {
	local name arg input

	read -r input
	[ -n "$input" ] || input='{}'
	json_load "$input" 2>/dev/null
	json_get_var name name
	json_get_var arg arg

	case "$name" in
		connect)
			uci -q set zirgozar.config.enabled='1' && uci -q commit zirgozar
			# The switch turned on by hand outranks a scheduled stop.
			rm -f "$ZGZ_RUN/schedule.stopped"
			# Said here and not in the detached script: between forking and
			# that script's first write there is a gap, and through the whole
			# gap the page would still show whatever the last attempt ended
			# as - which reads as a button that did nothing.
			say_status selecting
			clear_message
			detach "$CONNECT"
			;;
		prepare)
			# The page was opened. Measure now so that pressing Connect is
			# instant, but only when there is nothing to use yet - opening a
			# page must never disturb a tunnel that is already running.
			if [ ! -s "$ZGZ_BEST" ]; then
				say_status selecting
				detach "$CONNECT" prepare
			fi
			;;
		reselect)
			say_status selecting
			clear_message
			detach "$CONNECT" force
			;;
		disconnect)
			uci -q set zirgozar.config.enabled='0' && uci -q commit zirgozar
			say_status idle
			# bounded is a function in the helper, so the detached shell has to
			# source it before it can use one.
			detach /bin/sh -c ". $ZGZ_LIB/zgz-common.sh; bounded 60 /etc/init.d/zirgozar stop"
			;;
		pick)
			# A server chosen by hand rather than by measurement.
			[ -n "$arg" ] || { fail "no server given"; return; }
			case "$arg" in *[!A-Za-z0-9_]*) fail "unknown node"; return ;; esac
			# It becomes the Node in Basic Settings, as Use beside a node
			# added by hand does. Picked only as the measured choice, it was
			# set aside at once whenever Basic Settings named a node of its
			# own - which is when Use is pressed most.
			_ref="$("$NODES" origin "$arg" 2>/dev/null | head -1)"
			# Pressed again while the first press is still taking effect: nothing
			# more to do. Each press restarted the tunnel, and a few quick ones
			# took it down as many times just as it had come up.
			if [ -n "$_ref" ] && [ "$(cfg node '')" = "$_ref" ] && [ "$(cfg_bool enabled 0)" = "1" ]; then
				case "$(cat "$ZGZ_STATUS" 2>/dev/null)" in
					starting|selecting|ready) json_init; json_add_boolean "ok" 1; json_dump; return ;;
				esac
			fi
			if [ -n "$_ref" ]; then
				uci -q set zirgozar.config.node="$_ref"
				uci -q set zirgozar.config.enabled='1'
				uci -q commit zirgozar
				rm -f "$ZGZ_RUN/schedule.stopped"
				clear_message
				say_status starting
				detach /bin/sh -c ". $ZGZ_LIB/zgz-common.sh; bounded 180 /etc/init.d/zirgozar restart"
			elif "$PROBE" pick "$arg" >/dev/null 2>&1; then
				# Not traceable to a node or a subscription: the measured
				# choice, with Basic Settings back on Auto so nothing sets it
				# aside.
				uci -q delete zirgozar.config.node
				uci -q set zirgozar.config.enabled='1' && uci -q commit zirgozar
				say_status starting
				detach "$CONNECT" next
			else
				fail "that server is not in the list any more"
				return
			fi
			;;
		refresh_nodes)
			# Every subscription, or the one named - PassWall2's "Manual
			# subscription All" and "Manual subscription".
			case "$arg" in
				'') arg=all ;;
				*[!A-Za-z0-9_]*) fail "unknown subscription"; return ;;
			esac
			# A subscription only just added in the page is not in the file
			# until it is saved and applied, and there is nothing to read.
			if [ "$arg" != "all" ] && ! uci -q get "zirgozar.$arg" >/dev/null 2>&1; then
				fail "Save and apply this subscription first"
				return
			fi
			# Pressing this says the subscriptions are wanted. With "Nodes to use"
			# on manually added configs only, every one of them would be read
			# and none used: the page would say a number were added and the list
			# would stay empty.
			if [ "$(cfg sources both)" = "own" ]; then
				uci -q set zirgozar.config.sources=both
				uci -q commit zirgozar
				say_message "Nodes to use was set to manually added configs only, so the subscriptions could not be used. It is now set to all configs."
			fi
			run_job "Reading the subscriptions" "$NODES update $arg"
			;;
		forget_nodes)
			# What one subscription brought, or all of them, deleted.
			case "$arg" in
				*[!A-Za-z0-9_]*) fail "unknown subscription"; return ;;
			esac
			"$NODES" forget $arg >/dev/null 2>&1
			;;
		add_links)
			# PassWall2's "Add the node via the link": one node per link.
			_n="$(printf '%s\n' "$arg" | "$NODES" addlinks 2>/dev/null)" || _n=0
			detach "$NODES" build
			json_init
			json_add_boolean "ok" 1
			json_add_int "added" "${_n:-0}"
			json_dump
			return
			;;
		delete_nodes|clear_nodes|copy_node|top_node|group_nodes|use_node)
			# The rest of its Node List. Node ids only, and a group name
			# without anything a shell or uci would read as more than a name.
			_ids="${arg#*;}"
			_grp=""
			[ "$name" = "group_nodes" ] && _grp="${arg%%;*}"
			if [ -n "$(printf '%s' "$_ids" | tr -d 'A-Za-z0-9_ ')" ] ||
			   [ -n "$(printf '%s' "$_grp" | tr -d 'A-Za-z0-9_ .-')" ]; then
				fail "unknown node"
				return
			fi
			"$NODES" fixnames >/dev/null 2>&1 || true
			case "$name" in
				delete_nodes) "$NODES" delete $_ids >/dev/null 2>&1 ;;
				clear_nodes)  "$NODES" clear >/dev/null 2>&1 ;;
				copy_node)    "$NODES" copy "$_ids" >/dev/null 2>&1 && detach "$NODES" build ;;
				top_node)     "$NODES" top "$_ids" >/dev/null 2>&1 ;;
				group_nodes)  "$NODES" group "$_grp" $_ids >/dev/null 2>&1 ;;
				use_node)
					# PassWall2's Use: the node in Basic Settings, applied.
					[ "$(uci -q get "zirgozar.$_ids")" = "node" ] || { fail "unknown node"; return; }
					# Already the node, and the tunnel on its way up or up
					# with it: a second press would only start it again.
					if [ "$(cfg node '')" = "$_ids" ] && [ "$(cfg_bool enabled 0)" = "1" ]; then
						case "$(cat "$ZGZ_STATUS" 2>/dev/null)" in
							starting|selecting|ready) json_init; json_add_boolean "ok" 1; json_dump; return ;;
						esac
					fi
					uci -q set zirgozar.config.node="$_ids" && uci -q commit zirgozar
					if [ "$(cfg_bool enabled 0)" = "1" ]; then
						say_status starting
						detach /bin/sh -c ". $ZGZ_LIB/zgz-common.sh; bounded 180 /etc/init.d/zirgozar restart"
					fi
					;;
			esac
			;;
		rebuild_nodes)
			# The list rebuilt from what has already been fetched. No
			# subscription is re-read, so this costs no network and is
			# over before the page has finished saving - which is what
			# makes it usable as "the file changed, catch up".
			detach "$NODES" build
			;;
		measure_all)
			# The first pass on its own: one handshake to every server on the
			# list, and nothing else. It fills in the Reachable column for a
			# list that has just grown without disturbing a tunnel that is
			# carrying traffic, which choosing again would.
			run_job "Checking which servers answer" "$PROBE sift"
			;;
		cores_latest)
			run_job "Checking for new versions" "$CORES latest force"
			;;
		geo_update)
			# WHICH;GEOIP-URL;GEOSITE-URL - the addresses as the page shows
			# them, which may not be saved yet. Until Save & Apply the router
			# still holds the old ones, and the file the person just chose was
			# not the one that came down: the lite pair picked, the full pair
			# downloaded. An address that is not plainly http(s) is left to
			# the setting. Handed over as arguments, never as shell text.
			_which="${arg%%;*}"
			_gip=""; _gsite=""
			case "$arg" in
				*\;*\;*) _gip="${arg#*;}"; _gsite="${_gip#*;}"; _gip="${_gip%%;*}" ;;
			esac
			case "$_which" in geoip|geosite|all) : ;; *) _which=all ;; esac
			case "$_gip" in http://*|https://*) : ;; *) _gip="" ;; esac
			case "$_gsite" in http://*|https://*) : ;; *) _gsite="" ;; esac
			detach /bin/sh -c 'echo "Downloading routing data" > "$1"; ZGZ_GEOIP_URL="$2" ZGZ_GEOSITE_URL="$3" "$4" update "$5" >/dev/null 2>&1; rm -f "$1"' \
				sh "$JOB" "$_gip" "$_gsite" "$GEO" "$_which"
			;;
		geo_remove)
			"$GEO" remove >/dev/null 2>&1
			;;
		geo_rollback)
			case "$arg" in geoip|geosite) : ;; *) fail "unknown file"; return ;; esac
			if ! "$GEO" rollback "$arg" >/dev/null 2>&1; then
				fail "That file could not be put back."
				return
			fi
			;;
		core_install)
			case "$arg" in
				xray|xray-patterniha|sing-box|sing-box-lx|hysteria|geoview|warp-plus|vwarp|aether|openvpn) run_job "Installing $arg" "$CORES install $arg" ;;
				# One particular Xray, picked from the list on the page.
				xray@v[0-9]*)
					_v="${arg#xray@}"
					case "$_v" in *[!0-9v.]*) fail "unknown core"; return ;; esac
					run_job "Installing xray" "$CORES install xray $_v"
					;;
				*) fail "unknown core"; return ;;
			esac
			;;
		app_update)
			# This program itself, from its latest release. Detached like any
			# long job, and more so than most: the install restarts rpcd and
			# the web server, which are what would otherwise be waiting on it.
			rm -f "$ZGZ_RUN/self-update"
			run_job "Updating Zirgozar" "$CORES install zirgozar"
			;;
		core_remove)
			case "$arg" in
				sing-box|sing-box-lx|hysteria|geoview|warp-plus|vwarp|xray-patterniha|aether|openvpn) "$CORES" remove "$arg" >/dev/null 2>&1 ;;
				*) fail "unknown core"; return ;;
			esac
			;;
		deps_install)
			# What was missing is about to change; the next look asks again.
			rm -f "$ZGZ_RUN/deps.json"
			run_job "Installing dependencies" "$DEPS install; rm -f '$ZGZ_RUN/deps.json'"
			;;
		stats_reset)
			"$STATS" reset >/dev/null 2>&1
			;;
		node_test)
			# "<kind>:<id>". Detached, because a real request through a
			# node takes seconds and rpcd holds the browser open for as
			# long as anything it started is still writing. The page reads
			# the answer back through the tests method.
			_kind="${arg%%:*}"; _id="${arg#*:}"
			case "$_kind" in
				ping|tcp|url) : ;;
				*) fail "unknown test"; return ;;
			esac
			[ -n "$_id" ] && [ "$_id" != "$arg" ] || { fail "no node given"; return; }
			detach "$TEST" "$_kind" "$_id"
			;;
		rebind_apply)
			"$ROUTER" rebind >/dev/null 2>&1
			;;
		set_clock)
			# Answered here rather than as "ok": pressing it a second time
			# has to be able to say it was already done.
			_r="$("$ROUTER" clock 2>/dev/null)"
			json_init
			json_add_boolean "ok" 1
			json_add_boolean "already" "$([ "$_r" = "already" ] && echo 1 || echo 0)"
			json_dump
			return
			;;
		warp_register|warp_forget)
			# A WARP node's account, made now or thrown away. Making one takes
			# Cloudflare most of a minute on a bad day, so it is a job.
			case "$arg" in
				''|*[!A-Za-z0-9_]*) fail "unknown node"; return ;;
			esac
			[ "$(uci -q get "zirgozar.$arg")" = "node" ] || { fail "Save and apply this config first"; return; }
			if [ "$name" = "warp_register" ]; then
				clear_message
				run_job "Registering a WARP account" "$ZGZ_LIB/zgz-warp register $arg"
			else
				"$ZGZ_LIB/zgz-warp" forget "$arg" >/dev/null 2>&1
			fi
			;;
		server_keys)
			# A REALITY key pair for a server on the Server-Side page.
			_k="$("$ZGZ_LIB/zgz-server" keys 2>/dev/null)" || _k=""
			[ -n "$_k" ] || { fail "Xray could not make a key pair."; return; }
			json_init
			json_add_boolean "ok" 1
			json_add_string "private" "${_k%% *}"
			json_add_string "public" "${_k#* }"
			json_dump
			return
			;;
		set_lang)
			# The language button in the page header. A plain uci commit
			# rather than a LuCI save, which would restart the tunnel for
			# the sake of a word on a button.
			case "$arg" in fa|en) : ;; *) fail "unknown language"; return ;; esac
			uci -q set zirgozar.config.lang="$arg" && uci -q commit zirgozar
			;;
		clear_log)
			# PassWall2's "Clear logs". Only the runtime log: the core's
			# own lines are the system log's, not this program's to empty.
			: > "$ZGZ_LOG" 2>/dev/null || true
			;;
		clear_core_log)
			# The node log: see core_log.
			core_log_all | tail -n 1 > "$CORE_LOG_MARK" 2>/dev/null || true
			;;
		clear_message)
			# The reader has read it. A message that cannot be put away
			# sits on the front page for the rest of the boot saying a
			# thing that stopped being true when it was acted on.
			clear_message
			;;
		*)
			fail "unknown action"
			return
			;;
	esac

	json_init
	json_add_boolean "ok" 1
	json_dump
}

fail() {
	json_init
	json_add_boolean "ok" 0
	json_add_string "error" "$1"
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "state";   json_close_object
		json_add_object "traffic"; json_close_object
		json_add_object "nodes";   json_close_object
		json_add_object "subs";    json_close_object
		json_add_object "subnodes"; json_close_object
		json_add_object "tests";   json_close_object
		json_add_object "inuse";   json_close_object
		json_add_object "log";     json_close_object
		json_add_object "lan";     json_close_object
		json_add_object "check"
			json_add_string "url" ""
		json_close_object
		json_add_object "system";  json_close_object
		json_add_object "geo";     json_close_object
		json_add_object "server";  json_close_object
		json_add_object "nodeconfig"
			json_add_string "sid" ""
		json_close_object
		json_add_object "warp"
			json_add_string "sid" ""
		json_close_object
		json_add_object "geoview"
		json_add_string "action" "lookup"
		json_add_string "value" ""
		json_close_object
		json_add_object "action"
			json_add_string "name" ""
			json_add_string "arg" ""
		json_close_object
		json_dump
		;;
	call)
		case "$2" in
			state)   method_state ;;
			traffic) method_traffic ;;
			nodes)   method_nodes ;;
			nodeorigins) method_nodeorigins ;;
			subs)    method_subs ;;
			subnodes) method_subnodes ;;
			tests)   method_tests ;;
			inuse)   method_inuse ;;
			log)     method_log ;;
			lan)     method_lan ;;
			check)   method_check ;;
			system)  method_system ;;
			geo)     "$GEO" status 2>/dev/null || echo '{}' ;;
			geoview) method_geoview ;;
			nodeconfig) method_nodeconfig ;;
			warp)    method_warp ;;
			server)  method_server ;;
			action)  method_action ;;
		esac
		;;
esac
