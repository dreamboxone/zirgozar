#
# zgz-refresh - subscription maintenance, or a separately scheduled health check.
#
# Two jobs, and the difference between them is the whole reason this is a
# separate script.
#
# Reading the list is cheap: one small request, a few kilobytes, and it only
# reaches flash on the days it actually changed. Doing it often is what keeps
# a free list useful, because servers appear and disappear through the day and
# a list fetched this morning may name nothing that still answers.
#
# Choosing again is not cheap. So it happens only when it would change
# something - when the tunnel is meant to be up and is not, which is exactly
# the case where the server chosen earlier has stopped working and a fresh
# list is worth acting on. And even then it tries the cheap repair first: the
# next server down a list that was measured minutes ago, which costs a restart
# rather than a fresh sweep.

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

NODES="${ZGZ_LIB:-/usr/libexec}/zgz-nodes"
CONNECT="${ZGZ_LIB:-/usr/libexec}/zgz-connect"

# Read the sources. A failure here is not worth reporting: the list already on
# disk stays, and the next quarter hour will try again.
if [ "${1:-}" != health ]; then
	"$NODES" fetch >/dev/null 2>&1 || true
fi

# The runtime log lives in RAM; keep it to its last few hundred lines.
log_trim

# Subscription maintenance and tunnel health use independent schedules.
[ "${1:-}" = health ] || exit 0

# Is the web interface actually reachable?
#
# Everything the pages do goes through one rpcd object, and rpcd only
# learns about it when it is told to reload. That happens at install
# time - and on a fresh router it has been seen to report success and
# leave the object unregistered. What that looks like is a page that
# draws perfectly and does nothing at all: no server list, no Connect,
# no settings saved, and not one word anywhere saying why, because every
# script behind those buttons is fine and none of them was ever called.
#
# It costs one ubus call every quarter of an hour to make that state
# repair itself instead of needing somebody to find it.
if command -v ubus >/dev/null 2>&1 && ! ubus list 2>/dev/null | grep -q "^luci.zirgozar$"; then
	log "the web interface is not registered with rpcd - reloading it"
	bounded 15 /etc/init.d/rpcd reload >/dev/null 2>&1 || true
	sleep 2
	if ! ubus list 2>/dev/null | grep -q "^luci.zirgozar$"; then
		bounded 20 /etc/init.d/rpcd restart >/dev/null 2>&1 || true
	fi
fi

[ "$(cfg enabled 0)" = "1" ] || exit 0

# The "Open and close Daemon": off, and the tunnel is left as it is -
# nothing is repaired and no other node is chosen behind the reader's back.
[ "$(cfg_bool start_daemon 1)" = "1" ] || exit 0

# Stopped on a schedule, and meant to stay stopped until the scheduled start
# or the main switch says otherwise.
[ -f "$ZGZ_RUN/schedule.stopped" ] && exit 0

zgz_lock || exit 0
trap zgz_unlock EXIT
trap 'exit 1' INT TERM
repair() {
	zgz_unlock
	trap - EXIT INT TERM
	exec "$CONNECT" "$@"
}

_key="$(sha256sum "$ZGZ_BEST" 2>/dev/null)" || _key=''
if [ "$(cat "$ZGZ_RUN/health.key" 2>/dev/null)" != "$_key" ]; then
	rm -f "$ZGZ_RUN/health.fail" "$ZGZ_RUN/health.slow" "$ZGZ_RUN/health.baseline" "$ZGZ_RUN/health.sweep"
	printf '%s\n' "$_key" > "$ZGZ_RUN/health.key"
fi

# Already carrying traffic - leave it alone. Reconnecting a working tunnel to
# chase a server that measured faster would drop every connection in progress
# to win a few milliseconds.
if tunnel_running; then
	# ...but a core that is running with no rules in front of it is not a
	# tunnel, it is a process. That happens after a firewall reload wipes the
	# ruleset, and from the inside it looks exactly like being connected while
	# every byte leaves in the clear.
	if ! "${ZGZ_LIB:-/usr/libexec}/zgz-rules" status 2>/dev/null | grep -q '^active:[ \t]*yes'; then
		log "the tunnel is running but its rules are gone - putting them back"
		"${ZGZ_LIB:-/usr/libexec}/zgz-rules" up >/dev/null 2>&1 || true
		"${ZGZ_LIB:-/usr/libexec}/zgz-dns" up >/dev/null 2>&1 || true
	fi
	# And a tunnel that is running with its rules in place can still be
	# carrying nothing at all. A node that completes a TCP handshake and
	# then passes no traffic satisfies both of the checks above for ever,
	# and what that looks like from the sofa is a router with no internet
	# on it and a page that says everything is fine. So ask the only
	# question that settles it: does a request actually get through?
	#
	# Twice before acting. One failed request is a blip, and reconnecting
	# on a blip drops every connection in progress to fix nothing.
	if _ms="$("$ZGZ_LIB/zgz-test" live 2>/dev/null)"; then
		rm -f "$ZGZ_RUN/health.fail"
		case "$_ms" in ''|*[!0-9]*) exit 0 ;; esac
		_baseline="$(cat "$ZGZ_RUN/health.baseline" 2>/dev/null)" || _baseline=0
		case "$_baseline" in ''|*[!0-9]*) _baseline=0 ;; esac
		if [ "$_baseline" -eq 0 ] || [ "$_ms" -lt "$_baseline" ]; then
			_baseline="$_ms"
			echo "$_baseline" > "$ZGZ_RUN/health.baseline"
		fi
		_min="$(cfg health_slow_ms 1500)"
		case "$_min" in ''|*[!0-9]*) _min=1500 ;; esac
		[ "$_min" -ge 500 ] && [ "$_min" -le 30000 ] || _min=1500
		if [ "$(cfg_bool health_switch_slow 1)" != 1 ] || [ -n "$(cfg node '')" ] ||
		   [ "$_ms" -lt "$_min" ] || [ "$_ms" -le $((_baseline * 2)) ]; then
			rm -f "$ZGZ_RUN/health.slow"
			exit 0
		fi
		_slow="$(cat "$ZGZ_RUN/health.slow" 2>/dev/null)" || _slow=0
		case "$_slow" in ''|*[!0-9]*) _slow=0 ;; esac
		_slow=$((_slow + 1)); echo "$_slow" > "$ZGZ_RUN/health.slow"
		[ "$_slow" -ge 2 ] || exit 0
		_now="$(date +%s)"
		_last="$(cat "$ZGZ_RUN/health.sweep" 2>/dev/null)" || _last=0
		case "$_last" in ''|*[!0-9]*) _last=0 ;; esac
		[ $((_now - _last)) -ge 600 ] || exit 0
		# A transient spike must pass another request before a full sweep.
		_confirm="$("$ZGZ_LIB/zgz-test" live 2>/dev/null)" || exit 0
		case "$_confirm" in ''|*[!0-9]*) exit 0 ;; esac
		[ "$_confirm" -ge "$_min" ] && [ "$_confirm" -gt $((_baseline * 2)) ] || exit 0
		echo "$_now" > "$ZGZ_RUN/health.sweep"
		log "the current node is repeatedly slow - checking alternatives"
		repair degraded "$_key"
		exit 0
	fi

	_fails="$(cat "$ZGZ_RUN/health.fail" 2>/dev/null || echo 0)"
	case "$_fails" in
		''|*[!0-9]*) _fails=0 ;;
	esac
	_fails=$((_fails + 1))
	echo "$_fails" > "$ZGZ_RUN/health.fail"
	if [ "$_fails" -lt 2 ]; then
		log "the tunnel carried nothing this time - waiting for the next health check"
		exit 0
	fi

	log "the tunnel is up but has carried nothing twice running - choosing again"
	rm -f "$ZGZ_RUN/health.fail"
	# A subscription's node found again by testing its look-alikes is tested
	# again: the one that worked then may be the one that does not now.
	rm -f "$ZGZ_RUN/resolve.cache"
	repair force
fi

log "the tunnel should be up and is not - repairing"
repair next
