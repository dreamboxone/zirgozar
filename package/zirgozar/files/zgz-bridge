#
# zgz-bridge - make a protocol Xray cannot speak look like one it can.
#
#   zgz-bridge needed    exit 0 when the chosen server needs a bridge
#   zgz-bridge command   print the command line to run it
#   zgz-bridge config    write the bridge's configuration, print its path
#
# hysteria2, tuic, anytls, snell, naive, OpenConnect and Tailscale are not
# Xray protocols. Rather than run a second routing
# engine for them - with its own idea of DNS, its own transparent proxy
# arrangement and its own firewall rules to keep in step - one of them is run
# here for a single server and asked only to offer it as a SOCKS port on
# loopback. Xray then reaches that port with an ordinary socks outbound.
#
# So the tunnel is always Xray. The bridge is a detail of one outbound, and
# everything else in the program - measuring, routing, statistics, the rules -
# carries on exactly as it does for a vless server and does not need to know.
#
# A WARP node is warp-plus's, whichever engine carries the tunnel: it finds a
# WARP address by scanning, puts a second WARP or Psiphon behind the first,
# and sends junk ahead of a WireGuard handshake - none of which a core does.
#
# An OpenVPN node is OpenVPN's, the same way. It is not a SOCKS port but a
# tunnel device, and the core's way out for it is bound to that device.

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

NODE="$ZGZ_ETC/bridge.json"
PORT="$(cfg bridge_port 10808)"

jget() {
	sed -n "s/.*\"$1\"[ \t]*:[ \t]*\"\([^\"]*\)\".*/\1/p" "$NODE" 2>/dev/null | head -1
	return 0
}

jnum() {
	sed -n "s/.*\"$1\"[ \t]*:[ \t]*\([0-9][0-9]*\).*/\1/p" "$NODE" 2>/dev/null | head -1
	return 0
}

jbool() {
	grep -q "\"$1\"[ \t]*:[ \t]*true" "$NODE" 2>/dev/null && echo true || echo false
	return 0
}

# The sing-box that runs the helper. AmneziaWG's obfuscation exists only in
# sing-box-lx, so for that node nothing else will do, and naive is in no other
# build either; OpenConnect and Tailscale are in the builds made with them.
# Every other kind runs on whichever sing-box there is.
bridge_singbox() {
	_bt="$(jget type)"
	case "$_bt" in
		amneziawg) _btag=with_awg; _bc="$(singbox_lx_path)" ;;
		naive) _btag=with_naive_outbound; _bc="$(singbox_lx_path)" ;;
		openconnect) _btag=with_openconnect; _bc="$(singbox_path) $(singbox_lx_path)" ;;
		tailscale) _btag=with_tailscale; _bc="$(singbox_path) $(singbox_lx_path)" ;;
		*) find_singbox; return ;;
	esac
	for _bs in $_bc; do
		[ -x "$_bs" ] && "$_bs" version 2>/dev/null | grep -q "$_btag" && { echo "$_bs"; return 0; }
	done
	return 1
}

cmd_needed() {
	[ -s "$NODE" ] || return 1
	return 0
}

# --------------------------------------------------------------- sing-box

singbox_config() {
	_type="$(jget type)"
	# An OpenVPN profile has too many parts - certificates, keys, a wrapped
	# control channel - for a line of shell to build; zgz-sbconfig does it, and
	# decrypts the key on the way.
	case "$_type" in openvpn|amneziawg|hysteria2|hysteria|tuic|anytls|snell|naive|ssh|ssplugin|openconnect|tailscale) _uc=1 ;; *) _uc="" ;; esac
	if [ -n "$_uc" ]; then
		command -v ucode >/dev/null 2>&1 || return 1
		if [ "$_type" = "tailscale" ]; then
			mkdir -p "$ZGZ_ETC/tailscale"
			chmod 700 "$ZGZ_ETC/tailscale" 2>/dev/null || true
		fi
		_pin=""
		sb_certpin "$_sb" && _pin=1
		ucode "$ZGZ_LIB/zgz-sbconfig" mode=bridge bridge="$NODE" bridgeport="$PORT" etc="$ZGZ_ETC" certpin="$_pin" \
			lib="$ZGZ_LIB" rsdir="$ZGZ_RUN/rs" mark="$ZGZ_OUT_MARK" > "$ZGZ_BRIDGE_JSON.new" 2>"$ZGZ_RUN/bridge.err" || {
			rm -f "$ZGZ_BRIDGE_JSON.new"
			say_message "$(sed -n 's/^error: //p' "$ZGZ_RUN/bridge.err" | head -1)"
			return 1
		}
		chmod 600 "$ZGZ_BRIDGE_JSON.new"
		mv -f "$ZGZ_BRIDGE_JSON.new" "$ZGZ_BRIDGE_JSON"
		return 0
	fi
	_server="$(jget server)"
	_port="$(jnum port)"
	_sni="$(jget sni)"
	[ -n "$_sni" ] || _sni="$_server"
	_insecure="$(jbool insecure)"

	case "$_type" in
		hysteria2)
			_pass="$(jget password)"
			_obfs="$(jget obfs)"
			_obfspw="$(jget obfs_password)"
			_ob=""
			if [ -n "$_obfs" ]; then
				_ob=",\"obfs\":{\"type\":\"$(json_escape "$_obfs")\",\"password\":\"$(json_escape "$_obfspw")\"}"
			fi
			# A subscription's bandwidth and way out, when it gives them.
			_bw=""
			[ -n "$(jnum up_mbps)" ] && _bw="$_bw,\"up_mbps\":$(jnum up_mbps)"
			[ -n "$(jnum down_mbps)" ] && _bw="$_bw,\"down_mbps\":$(jnum down_mbps)"
			[ -n "$(jget iface)" ] && _bw="$_bw,\"bind_interface\":\"$(json_escape "$(jget iface)")\""
			_out="{\"type\":\"hysteria2\",\"tag\":\"out\",\"server\":\"$(json_escape "$_server")\",\"server_port\":$_port,\"password\":\"$(json_escape "$_pass")\"$_ob$_bw,\"tls\":{\"enabled\":true,\"server_name\":\"$(json_escape "$_sni")\",\"insecure\":$_insecure}}"
			;;
		tuic)
			_uuid="$(jget uuid)"
			_pass="$(jget password)"
			_cc="$(jget congestion_control)"
			[ -n "$_cc" ] || _cc=bbr
			_bw=""
			[ -n "$(jget iface)" ] && _bw=",\"bind_interface\":\"$(json_escape "$(jget iface)")\""
			_out="{\"type\":\"tuic\",\"tag\":\"out\"$_bw,\"server\":\"$(json_escape "$_server")\",\"server_port\":$_port,\"uuid\":\"$(json_escape "$_uuid")\",\"password\":\"$(json_escape "$_pass")\",\"congestion_control\":\"$(json_escape "$_cc")\",\"tls\":{\"enabled\":true,\"server_name\":\"$(json_escape "$_sni")\",\"insecure\":$_insecure,\"alpn\":[\"h3\"]}}"
			;;
		*)
			return 1
			;;
	esac

	cat > "$ZGZ_BRIDGE_JSON" <<EOF
{
  "log": { "disabled": true },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "in",
      "listen": "127.0.0.1",
      "listen_port": $PORT
    }
  ],
  "outbounds": [ $_out ]
}
EOF
	return 0
}

# --------------------------------------------------------------- warp-plus

# A WARP node, or a WireGuard node it carries: warp-plus's own configuration
# file, which its -c reads. The licence is in there rather than on the command
# line, where anyone with a shell on the router could read it.
#
# Its account is kept on flash, beside the settings, so that a reboot does not
# register a new one - and with nothing but its owner able to read it, because
# the private key is in it.
warp_config() {
	[ "$(jget type)" = "warp" ] || return 1
	# warp-plus reads a configuration file; Vwarp is given its options on the
	# command line, kept in the same file so that the command can be read back.
	_vw=0
	[ "${1:-}" = "vwarp" ] && _vw=1
	_wid="$(jget id)"
	_wdir="$(warp_dir "$_wid")"
	mkdir -p "$_wdir"
	chmod 700 "$ZGZ_ETC/warp" "$_wdir" 2>/dev/null || true
	_verbose=0
	[ "$(cfg loglevel warning)" = "debug" ] && _verbose=1
	VWARP="$_vw" BIND="127.0.0.1:$PORT" CACHE="$_wdir" MARK="$ZGZ_OUT_MARK" VERBOSE="$_verbose" \
	WGFILE="$ZGZ_BRIDGE_JSON.conf" \
		LC_ALL=C awk -v WARPCONF=1 -f "$ZGZ_LIB/zgz-parse" < "$NODE" > "$ZGZ_BRIDGE_JSON.new" 2>/dev/null || {
		rm -f "$ZGZ_BRIDGE_JSON.new"
		return 1
	}
	chmod 600 "$ZGZ_BRIDGE_JSON.new" "$ZGZ_BRIDGE_JSON.conf" 2>/dev/null || true
	mv -f "$ZGZ_BRIDGE_JSON.new" "$ZGZ_BRIDGE_JSON"
	return 0
}

# A YAML string in single quotes, where a quote is written twice.
yq() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
	return 0
}

# -------------------------------------------------------------------- SSR

# Mihomo, for one SSR server: a mixed port on loopback and everything to it.
ssr_config() {
	[ "$(jget type)" = "ssr" ] || return 1
	mkdir -p "$ZGZ_RUN/mihomo"
	{
		printf 'mixed-port: %s\nbind-address: 127.0.0.1\nallow-lan: false\n' "$PORT"
		printf 'mode: rule\nlog-level: warning\nipv6: true\nrouting-mark: %s\n' "$ZGZ_OUT_MARK"
		printf 'geodata-auto-update: false\n'
		printf 'proxies:\n  - name: out\n    type: ssr\n'
		printf '    server: %s\n    port: %s\n' "$(yq "$(jget server)")" "$(jnum port)"
		printf '    cipher: %s\n    password: %s\n' "$(yq "$(jget method)")" "$(yq "$(jget password)")"
		printf '    obfs: %s\n    protocol: %s\n' "$(yq "$(jget obfs)")" "$(yq "$(jget protocol)")"
		[ -z "$(jget obfs_param)" ] || printf '    obfs-param: %s\n' "$(yq "$(jget obfs_param)")"
		[ -z "$(jget protocol_param)" ] || printf '    protocol-param: %s\n' "$(yq "$(jget protocol_param)")"
		printf '    udp: true\nrules:\n  - MATCH,out\n'
	} > "$ZGZ_BRIDGE_JSON.mihomo.yaml"
	chmod 600 "$ZGZ_BRIDGE_JSON.mihomo.yaml" 2>/dev/null || true
	return 0
}

# shadowsocks-rust's client, for one server: SOCKS on loopback, TCP and UDP.
ssrust_config() {
	[ "$(jget type)" = "ssrust" ] || return 1
	printf '{"server":"%s","server_port":%s,"method":"%s","password":"%s","local_address":"127.0.0.1","local_port":%s,"mode":"tcp_and_udp","outbound_fwmark":%s}\n' \
		"$(jget server)" "$(jnum port)" "$(jget method)" \
		"$(sed -n 's/.*"password":"\(\([^"\\]\|\\.\)*\)".*/\1/p' "$NODE" | head -1)" \
		"$PORT" "$ZGZ_OUT_MARK" > "$ZGZ_BRIDGE_JSON.ssrust.json"
	chmod 600 "$ZGZ_BRIDGE_JSON.ssrust.json" 2>/dev/null || true
	return 0
}

own_program_missing() {
	say_message "$1"
	warn "$2"
	return 1
}

# ---------------------------------------------------------------- OpenVPN

# The official client, from the router's own packages: openvpn-openssl, or
# openvpn-mbedtls - Router requirements installs the first when there is an
# OpenVPN config and neither.
find_openvpn() {
	for _ov in "$(command -v openvpn 2>/dev/null)" /usr/sbin/openvpn; do
		[ -n "$_ov" ] && [ -x "$_ov" ] && { echo "$_ov"; return 0; }
	done
	return 1
}

# The profile as zgz-parse kept it, and after it this program's own lines:
# its device, no routes of its own (the core decides what goes in), the mark
# the firewall lets past, no scripts, and the device kept through a reconnect
# so that the core's way out, bound to it, does not vanish under it.
# Written where only root can read it: the password and the key are in it.
ovpn_config() {
	[ "$(jget type)" = "openvpn" ] || return 1
	if grep -q '"tap":true' "$NODE"; then
		say_message "This OpenVPN profile uses a TAP device (dev tap). Only TUN profiles are supported."
		return 1
	fi
	# Read by an earlier version, which kept only parts of the profile.
	if ! grep -q '"profile":"' "$NODE"; then
		say_message "This OpenVPN config was read by an earlier version. Open it on the Node List page and press Save, so that it is read again."
		return 1
	fi
	if grep -q '"needs_auth":true' "$NODE"; then
		say_message "This OpenVPN profile asks for a user name and password. Enter them in the settings of the config."
		return 1
	fi
	_ovf="$ZGZ_BRIDGE_JSON.ovpn"
	_old="$(umask)"
	umask 077
	AUTHFILE="$_ovf.auth" PASSFILE="$_ovf.pass" \
		LC_ALL=C awk -v OVPNCONF=1 -f "$ZGZ_LIB/zgz-parse" < "$NODE" > "$_ovf.new" 2>/dev/null || {
		umask "$_old"
		rm -f "$_ovf.new"
		return 1
	}
	_verb=3
	[ "$(cfg loglevel warning)" = "debug" ] && _verb=4
	# A static-key profile - no TLS, one shared key. OpenVPN 2.7 still runs
	# it, but only when told to in so many words; 2.8 will not at all.
	if grep -qE '^(<secret>|secret[[:space:]])' "$_ovf.new" &&
	   ! grep -qE '^(client|tls-client|tls-server)([[:space:]]|$)' "$_ovf.new"; then
		echo "allow-deprecated-insecure-static-crypto" >> "$_ovf.new"
	fi
	# The cipher of a server too old to negotiate one - an OpenVPN 2.3 or
	# earlier, a SoftEther, most free lists. Its profile says "cipher X", and
	# OpenVPN 2.6 no longer takes that as an offer: the server answers "no
	# shared cipher" and refuses. sing-box, which carried these before, did
	# take it. So X joins the ciphers offered and is the one fallen back on,
	# unless the profile says otherwise - and only when this OpenVPN has it.
	# BF-CBC and the other old ones are in OpenSSL 3's legacy provider, which
	# is loaded for them when the router has it (libopenssl-legacy).
	_oc="$(sed -n 's/^cipher[[:space:]]\{1,\}\([^[:space:]]*\).*/\1/p' "$_ovf.new" | tail -1)"
	_ovb="$(find_openvpn)"
	_ohas=""
	if [ -n "$_oc" ] && [ "$_oc" != "none" ]; then
		if "$_ovb" --show-ciphers 2>/dev/null | grep -qi "^$_oc[[:space:]]"; then
			_ohas=1
		elif ! grep -q '^providers[[:space:]]' "$_ovf.new" &&
		     "$_ovb" --providers legacy default --show-ciphers 2>/dev/null | grep -qi "^$_oc[[:space:]]"; then
			echo "providers legacy default" >> "$_ovf.new"
			_ohas=1
		else
			log "OpenVPN: this OpenVPN has no $_oc, the cipher the profile names - a server that knows no other will refuse it"
		fi
	fi
	if [ -n "$_ohas" ]; then
		_odc="$(sed -n 's/^\(data-ciphers\|ncp-ciphers\)[[:space:]]\{1,\}\([^[:space:]]*\).*/\2/p' "$_ovf.new" | tail -1)"
		[ -n "$_odc" ] || _odc="AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305"
		case ":$(echo "$_odc" | tr 'a-z' 'A-Z'):" in
			*":$(echo "$_oc" | tr 'a-z' 'A-Z'):"*) : ;;
			*) echo "data-ciphers $_odc:$_oc" >> "$_ovf.new" ;;
		esac
		grep -q '^data-ciphers-fallback[[:space:]]' "$_ovf.new" ||
			echo "data-ciphers-fallback $_oc" >> "$_ovf.new"
	fi
	# OpenVPN waits two minutes on a server that does not answer before it
	# tries again or moves to the next one, and a first attempt that hangs
	# is common enough here: a second one, seconds later, very often goes
	# straight through. Ten seconds, unless the profile says otherwise.
	if ! grep -qE '^(server-poll-timeout|connect-timeout)[[:space:]]' "$_ovf.new"; then
		echo "server-poll-timeout 10" >> "$_ovf.new"
	fi
	# Reached through another node: the core's SOCKS port that leaves by it
	# - see ovpn_via. Last, so it wins over a proxy the profile names.
	if [ -n "$(ovpn_via)" ] && grep -q "\"ovpn-via\"" "$ZGZ_CONFIG_JSON" 2>/dev/null; then
		echo "socks-proxy 127.0.0.1 $(cfg bridge_port 10808)" >> "$_ovf.new"
	fi
	cat >> "$_ovf.new" <<EOF
dev $ZGZ_OVPN_DEV
dev-type tun
route-noexec
ignore-unknown-option dns-updown
dns-updown disable
mark $ZGZ_OUT_MARK
script-security 1
persist-tun
auth-nocache
suppress-timestamps
verb $_verb
EOF
	umask "$_old"
	mv -f "$_ovf.new" "$_ovf"
	return 0
}

# ------------------------------------------------------------------- main

cmd_config() {
	cmd_needed || { echo "no bridge needed" >&2; return 1; }
	if bridge_is_l2tp; then
		"$ZGZ_LIB/zgz-l2tp" check || return 1
		echo "$NODE"
		return 0
	fi
	if bridge_is_ppp; then
		"$ZGZ_LIB/zgz-pppvpn" check || return 1
		echo "$NODE"
		return 0
	fi
	if bridge_is_aether; then
		"$ZGZ_LIB/zgz-aether" check || return 1
		echo "$NODE"
		return 0
	fi

	if [ "$(jget type)" = "openvpn" ]; then
		if ! find_openvpn >/dev/null; then
			say_message "An OpenVPN config needs OpenVPN on the router. Press Install dependencies under Router requirements."
			warn "no openvpn installed to carry the OpenVPN node"
			return 1
		fi
		ovpn_config || return 1
		echo "$ZGZ_BRIDGE_JSON.ovpn"
		return 0
	fi

	if [ "$(jget type)" = "warp" ]; then
		if ! _wpp="$(warp_program "$(cat "$NODE")")"; then
			if warp_needs_vwarp "$(cat "$NODE")"; then
				say_message "This WARP node uses MASQUE or noize, which need Vwarp. Install it on the App Update page."
			else
				say_message "A WARP node needs warp-plus. Install it on the App Update page."
			fi
			warn "no warp-plus or Vwarp installed to carry the WARP node"
			return 1
		fi
		warp_config "${_wpp%% *}" || return 1
		echo "$ZGZ_BRIDGE_JSON"
		return 0
	fi

	case "$(jget type)" in
		ssr)
			[ -x "$(mihomo_path)" ] || { own_program_missing "An SSR config needs Mihomo. Install it on the App Update page." "no mihomo installed to carry the SSR node"; return 1; }
			ssr_config || return 1
			echo "$ZGZ_BRIDGE_JSON.mihomo.yaml"
			return 0
			;;
		ssrust)
			[ -x "$(sslocal_path)" ] || { own_program_missing "This Shadowsocks config is set to use shadowsocks-rust. Install it on the App Update page." "no shadowsocks-rust installed to carry the node"; return 1; }
			ssrust_config || return 1
			echo "$ZGZ_BRIDGE_JSON.ssrust.json"
			return 0
			;;
	esac
	if _sb="$(bridge_singbox)"; then
		if singbox_config; then
			echo "$ZGZ_BRIDGE_JSON"
			return 0
		fi
	fi

	if [ "$(jget type)" = "amneziawg" ]; then
		say_message "AmneziaWG needs sing-box-lx, the build that has it. Install it on the App Update page."
		warn "no sing-box-lx installed to carry amneziawg"
		return 1
	fi
	if [ "$(jget type)" = "naive" ]; then
		say_message "A naive config needs sing-box-lx, the build that has it. Install it on the App Update page."
		warn "no sing-box-lx installed to carry naive"
		return 1
	fi
	say_message "The chosen node speaks $(jget type), which Xray cannot. Install sing-box on the settings page, or pick another node."
	warn "no core installed that can carry $(jget type)"
	return 1
}

# What zirgozar.init hands to procd. Printed rather than run, so that the service
# is a procd instance like any other and gets its respawning for free.
cmd_command() {
	cmd_needed || return 1
	if bridge_is_l2tp; then
		"$ZGZ_LIB/zgz-l2tp" check || return 1
		echo "$ZGZ_LIB/zgz-l2tp run"
		return 0
	fi
	if bridge_is_ppp; then
		"$ZGZ_LIB/zgz-pppvpn" check || return 1
		echo "$ZGZ_LIB/zgz-pppvpn run"
		return 0
	fi
	if bridge_is_aether; then
		"$ZGZ_LIB/zgz-aether" check || return 1
		echo "$ZGZ_LIB/zgz-aether run"
		return 0
	fi
	if [ "$(jget type)" = "openvpn" ]; then
		_ov="$(find_openvpn)" || return 1
		ovpn_config || return 1
		echo "$_ov --config $ZGZ_BRIDGE_JSON.ovpn"
		return 0
	fi
	if [ "$(jget type)" = "warp" ]; then
		_wpp="$(warp_program "$(cat "$NODE")")" || return 1
		warp_config "${_wpp%% *}" || return 1
		if [ "${_wpp%% *}" = "vwarp" ]; then
			echo "${_wpp#* } $(cat "$ZGZ_BRIDGE_JSON")"
		else
			echo "${_wpp#* } -c $ZGZ_BRIDGE_JSON"
		fi
		return 0
	fi
	if [ "$(jget type)" = "ssr" ]; then
		_mh="$(mihomo_path)"
		[ -x "$_mh" ] && ssr_config || return 1
		echo "$_mh -d $ZGZ_RUN/mihomo -f $ZGZ_BRIDGE_JSON.mihomo.yaml"
		return 0
	fi
	if [ "$(jget type)" = "ssrust" ]; then
		_sl="$(sslocal_path)"
		[ -x "$_sl" ] && ssrust_config || return 1
		echo "$_sl -c $ZGZ_BRIDGE_JSON.ssrust.json"
		return 0
	fi
	if _sb="$(bridge_singbox)" && singbox_config; then
		echo "$_sb run -c $ZGZ_BRIDGE_JSON"
		return 0
	fi
	return 1
}

case "${1:-}" in
	needed)  cmd_needed ;;
	config)  cmd_config ;;
	command) cmd_command ;;
	*) echo "usage: $0 needed|config|command" >&2; exit 1 ;;
esac
