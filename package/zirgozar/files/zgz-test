#
# zgz-test - measure one node, on demand, three different ways.
#
#   zgz-test ping <id>    ICMP round trip to the node's address
#   zgz-test tcp  <id>    TCP handshake to the node's real port
#   zgz-test url  <id>    a whole HTTP request carried by the node
#   zgz-test current      can the node the tunnel is on carry a request?
#   zgz-test exit         where the tunnel comes out: address and country
#   zgz-test json         every answer collected so far
#   zgz-test clear        forget them
#
# The three tests offered beside each node, and they are
# three because they answer three different questions and disagree often.
#
#   ping  is the network layer and nothing else. It says how far away the
#         address is. It says nothing about the server: one behind Cloudflare
#         answers at the edge whatever state the server is in, and plenty of
#         working servers drop ICMP entirely, which reads here as no answer.
#
#   tcp   is a handshake to the port the tunnel will actually use. It proves
#         something is listening and how long the round trip takes, and it is
#         the honest measure of distance. It still says nothing about whether
#         the credentials are right or the protocol is spoken correctly.
#
#   url   is a complete request through the node - the core is started, a
#         local SOCKS port is offered, and one small page is fetched through
#         it. This is the only one of the three that proves the node works.
#         It is also the slowest, which is why it is not what the first pass
#         uses when a hundred nodes have to be sifted.
#
# <id> is a tag from the candidate list, or the uci section of a node added by
# hand - which is the case that matters, because a node typed in a minute ago
# has not been through a refresh yet and is in no list.
#
# Answers land in files rather than on stdout: the web interface starts these
# in the background and reads them afterwards, so that a browser is never left
# holding a request open for the six seconds a real one takes.
#
#   -2  this test cannot be run on this node
#   -1  running
#    0  no answer
#   >0  milliseconds

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

PARSE="$ZGZ_LIB/zgz-parse"
DIR="$ZGZ_RUN/tests"
PORT=24900

mkdir -p "$DIR" 2>/dev/null || true

# tag<TAB>label<TAB>proto<TAB>host<TAB>port<TAB>payload for one node, wherever
# it happens to live.
row_for() {
	_id="$1"

	if [ -s "$ZGZ_CANDIDATES" ]; then
		_r="$(awk -F'\t' -v t="$_id" '$1 == t { print; exit }' "$ZGZ_CANDIDATES")"
		[ -n "$_r" ] && { printf '%s\n' "$_r"; return 0; }
	fi

	# A section of /etc/config/zirgozar, parsed here and now. The link may
	# have been typed thirty seconds ago and belong to no list yet.
	command -v uci >/dev/null 2>&1 || return 1
	# With its own chain when it has one: the test is of the node as the
	# tunnel would use it.
	_r="$(node_records "$_id" 1 2>/dev/null | head -1)"
	[ -n "$_r" ] || return 1
	printf '%s\n' "$_r"
	return 0
}

subscription_test_engine() {
	local origin section protocol="$2" choice
	case "$1" in sub:*) origin="$1" ;; *) origin="$("$ZGZ_LIB/zgz-nodes" origin "$1" 2>/dev/null)" ;; esac
	case "$origin" in sub:*:*) section="${origin#sub:}"; section="${section%%:*}" ;; *) return 0 ;; esac
	[ "$protocol" != shadowsocks ] || protocol=ss
	choice="$(uci -q get "zirgozar.$section.${protocol}_type" 2>/dev/null)" || choice=''
	case "$choice" in xray|singbox) printf '%s\n' "$choice" ;; esac
}

put() { echo "$2" > "$DIR/$1" 2>/dev/null || true; return 0; }

# ------------------------------------------------------------------- ping

do_ping() {
	_out="$DIR/$1.ping"
	_host="$2"
	echo -1 > "$_out"
	if ! _o="$(ping -c 3 -W 2 -q "$_host" 2>/dev/null)"; then
		echo 0 > "$_out"
		return 0
	fi
	# busybox prints "round-trip min/avg/max = 1.2/3.4/5.6 ms"; iputils prints
	# "rtt min/avg/max/mdev = ...". The average is the second number either
	# way, and taking the first would report the luckiest of three packets.
	_v="$(printf '%s' "$_o" | awk -F'[ /]+' '
		/min\/avg/ {
			c = 0
			for (i = 1; i <= NF; i++)
				if ($i ~ /^[0-9]+\.?[0-9]*$/) {
					c++
					if (c == 2) { printf "%d", $i + 0.5; exit }
				}
		}')"
	case "$_v" in
		''|*[!0-9]*) _v=0 ;;
	esac
	[ "$_v" -gt 0 ] 2>/dev/null || _v=1
	echo "$_v" > "$_out"
	return 0
}

# -------------------------------------------------------------------- tcp

do_tcp() {
	_out="$DIR/$1.tcp"
	_host="$2"; _port="$3"
	echo -1 > "$_out"
	case "$_host" in *:*) _host="[$_host]" ;; esac
	_t="$(curl -s -o /dev/null --connect-timeout 5 --max-time 5 \
		-w '%{time_connect}' "http://$_host:$_port/" 2>/dev/null)" || true
	if [ -z "$_t" ]; then
		echo 0 > "$_out"
		return 0
	fi
	awk -v t="$_t" 'BEGIN { m = int(t * 1000 + 0.5); if (t > 0 && m < 1) m = 1; printf "%d", m }' \
		> "$_out" 2>/dev/null || echo 0 > "$_out"
	return 0
}

# -------------------------------------------------------------------- url

# One whole request through one outbound, in milliseconds. 0 means it did not
# complete, which is the only answer that matters.
#
# One at a time. Two of these at once would both try to listen on the same
# loopback port, the second core would refuse to start, and the answer - an
# honest-looking "no answer" - would be about this program and not about the
# node. Waiting a few seconds for the other one to finish is the only answer
# that is true.
url_ms() {
	_payload="$1"

	_waited=0
	while ! mkdir "$DIR/.url-lock" 2>/dev/null; do
		_waited=$((_waited + 1))
		if [ "$_waited" -gt 15 ]; then
			# Something died holding it. Take it rather than wedging for good.
			rm -rf "$DIR/.url-lock" 2>/dev/null || true
			mkdir "$DIR/.url-lock" 2>/dev/null || true
			break
		fi
		sleep 1
	done

	_cfg="$ZGZ_RUN/one-test.json"
	# The node as the tunnel would run it: the Xray tab applied, dialling
	# through the pre-proxy unless it is the pre-proxy, and its name resolved
	# through the direct resolver rather than through the tunnel - the tunnel
	# being, very often, the thing whose node is in question.
	_gp="$(global_preproxy)" || _gp=""
	_ghp=""
	if [ -n "$_gp" ]; then
		_ghp="$(section_links "$_gp" | LC_ALL=C awk -v LIMIT=1 -f "$PARSE" 2>/dev/null |
			head -1 | cut -f4,5 | tr '\t' '|')"
	fi
	_out="$(printf 'x\tx\tx\t%s\t%s\t%s\n' "${2:-}" "${3:-}" "$_payload" |
		DOMSTRAT="$(node_domain_strategy)" decorate "${_gp:+chain-$_gp}" "$_ghp" | cut -f6-)"
	set -- $(direct_dns)
	if [ "$1" = "tcp" ]; then _dns="{\"address\":\"tcp://$2:$3\"}"; else _dns="{\"address\":\"$2\",\"port\":$3}"; fi
	printf '{"log":{"loglevel":"none"},"inbounds":[{"tag":"in","listen":"127.0.0.1","port":%d,"protocol":"socks","settings":{"udp":false}}],"outbounds":[%s%s,{"tag":"direct","protocol":"freedom","streamSettings":{"sockopt":{"mark":255}}}],"dns":{"tag":"dns-module","servers":[%s],"queryStrategy":"%s"},"routing":{"rules":[{"type":"field","inboundTag":["dns-module"],"outboundTag":"direct"},{"type":"field","inboundTag":["in"],"outboundTag":"out"}]}}' \
		"$PORT" "$(printf '%s' "$_out" | sed 's/^{/{"tag":"out",/')" \
		"$(chain_outbounds "$_out" | while read -r _co; do [ -n "$_co" ] && printf ',%s' "$_co"; done)" \
		"$_dns" "$(node_domain_strategy)" > "$_cfg"

	# Measured by the core the tunnel runs on - see test_core.
	if ! _x="$(test_core "$_cfg")"; then
		rm -f "$_cfg"
		rmdir "$DIR/.url-lock" 2>/dev/null || true
		echo -2
		return 1
	fi
	_eng="${_x%% *}"; _x="${_x#* }"

	_geo="$(geo_dir)" || _geo=""
	if [ -n "$_geo" ]; then
		XRAY_LOCATION_ASSET="$_geo" "$_x" $(core_run_args "$_eng" "$_cfg") >/dev/null 2>&1 &
	else
		"$_x" $(core_run_args "$_eng" "$_cfg") >/dev/null 2>&1 &
	fi
	_pid=$!
	# Otherwise the core's own start-up is charged to the node.
	sleep 1

	_ms=0
	if _t="$(curl -s -o /dev/null -x "socks5h://127.0.0.1:$PORT" \
		--connect-timeout 8 --max-time 8 \
		-w '%{time_total}' "$(cfg test_url 'http://www.gstatic.com/generate_204')" 2>/dev/null)"
	then
		_ms="$(awk -v t="$_t" 'BEGIN { m = int(t * 1000 + 0.5); if (t > 0 && m < 1) m = 1; printf "%d", m }')"
		# Asked a second time: the first request pays for opening the tunnel -
		# a WireGuard handshake is most of it - and the second is the round
		# trip through the node and nothing else.
		if [ "${URL_REPEAT:-0}" = "1" ]; then
			if _t="$(curl -s -o /dev/null -x "socks5h://127.0.0.1:$PORT" 				--connect-timeout 8 --max-time 8 				-w '%{time_total}' "$(cfg test_url 'http://www.gstatic.com/generate_204')" 2>/dev/null)"
			then
				_ms="$(awk -v t="$_t" 'BEGIN { m = int(t * 1000 + 0.5); if (t > 0 && m < 1) m = 1; printf "%d", m }')"
			fi
		fi
	fi

	kill "$_pid" 2>/dev/null || true
	wait "$_pid" 2>/dev/null || true
	rm -f "$_cfg"
	rmdir "$DIR/.url-lock" 2>/dev/null || true

	echo "${_ms:-0}"
	[ "${_ms:-0}" -gt 0 ] 2>/dev/null || return 1
	return 0
}

endpoint_url_ms() (
	# An isolated protocol helper: no UCI changes, shared bridge files or
	# system routes. Serialize its loopback port and always reap the process.
	local work pid='' core='' waited=0 target time before attempt capability=with_openconnect
	while ! mkdir "$DIR/.oc-lock" 2>/dev/null; do
		waited=$((waited + 1)); [ "$waited" -le 15 ] || { echo -2; exit 1; }
		sleep 1
	done
	work="$(mktemp -d "$DIR/oc-test.XXXXXX")" || { rmdir "$DIR/.oc-lock"; echo -2; exit 1; }
	trap '[ -z "$pid" ] || { kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; }; rm -f "$work"/*; rmdir "$work" "$DIR/.oc-lock" 2>/dev/null || true' EXIT
	trap 'exit 1' INT TERM
	[ "${2:-openconnect}" != hysteria2 ] || capability=with_quic
	for core in "$(singbox_path)" "$(singbox_lx_path)"; do
		[ -x "$core" ] && "$core" version 2>/dev/null | grep -q "$capability" && break
		core=''
	done
	[ -n "$core" ] && command -v ucode >/dev/null 2>&1 || { echo -2; exit 1; }
	umask 077
	printf '%s\n' "$1" > "$work/node.json"
	ucode "$ZGZ_LIB/zgz-sbconfig" mode=bridge bridge="$work/node.json" bridgeport=24901 mark=255 lib="$ZGZ_LIB" etc="$ZGZ_ETC" > "$work/config.json" 2> "$work/error" &&
		"$core" check -c "$work/config.json" >> "$work/error" 2>&1 || { echo -2; exit 1; }
	"$core" run -c "$work/config.json" > "$work/run.log" 2>&1 &
	pid=$!
	sleep 2
	target="$(cfg test_url 'http://www.gstatic.com/generate_204')"
	attempt=0
	while [ "$attempt" -lt 20 ]; do
		before="$(wc -c < "$work/run.log")"
		if time="$(curl -fsS -o /dev/null --socks5-hostname 127.0.0.1:24901 --connect-timeout 8 --max-time 15 -w '%{time_total}' "$target" 2>/dev/null)"; then
			awk -v t="$time" 'BEGIN { m=int(t*1000+0.5); print (m<1 ? 1 : m) }'; exit 0
		fi
		# Some gateways refuse the stock plaintext probe. Explicit user URLs
		# remain authoritative, with one HTTPS control for the default.
		if [ "$target" = 'http://www.gstatic.com/generate_204' ] &&
		   time="$(curl -fsS -o /dev/null --socks5-hostname 127.0.0.1:24901 --connect-timeout 8 --max-time 15 -w '%{time_total}' https://www.google.com/generate_204 2>/dev/null)"; then
			awk -v t="$time" 'BEGIN { m=int(t*1000+0.5); print (m<1 ? 1 : m) }'; exit 0
		fi
		# The SOCKS listener can open before endpoint authentication finishes.
		# Retry only a fresh readiness error, never an authenticated failure.
		[ "$(wc -c < "$work/run.log")" -gt "$before" ] &&
			tail -4 "$work/run.log" | grep -q 'endpoint is not ready yet' &&
			! grep -q 'client terminated' "$work/run.log" || { echo 0; exit 1; }
		attempt=$((attempt + 1)); sleep 1
	done
	echo 0; exit 1
)

do_url() {
	_out="$DIR/$1.url"
	_proto="$2"; _payload2="$3"
	echo -1 > "$_out"

	# Protocol helpers keep their temporary processes separate from the live
	# bridge. Unsupported protocols must not be reported as failed accounts.
	case "$_proto" in
		openconnect|hysteria2)
			endpoint_url_ms "$_payload2" "$_proto" > "$_out" 2>/dev/null || true
			return 0 ;;
		l2tp|pptp|sstp|ikev2)
			_l2tp_ms="$(printf '%s\n' "$_payload2" | "$ZGZ_LIB/$(tunnel_helper "$_proto")" test url 2>/dev/null)" || _l2tp_ms=0
			printf '%s\n' "$_l2tp_ms" > "$_out"
			return 0 ;;
		aether)
			_aether_ms="$(printf '%s\n' "$_payload2" | "$ZGZ_LIB/zgz-aether" test "$1" 2>/dev/null)" || _aether_ms=0
			printf '%s\n' "$_aether_ms" > "$_out"
			return 0 ;;
		hysteria|tuic|anytls|snell|naive|tailscale|ssh|ssplugin|ssr|ssrust|mieru|shadowquic|trusttunnel|openvpn|amneziawg) echo -2 > "$_out"; return 0 ;;
		# WARP is the exception: warp-plus is one small program and is stood
		# up for the test, because without it the column could only ever
		# say that it cannot say.
		warp)
			_wsec="${6:-}"
			if [ -n "$_wsec" ] && command -v uci >/dev/null 2>&1 &&
			   [ "$(uci -q get "zirgozar.$_wsec" 2>/dev/null)" = "node" ]; then
				"$ZGZ_LIB/zgz-warp" test "$_wsec" > "$_out" 2>/dev/null || echo 0 > "$_out"
			else
				echo -2 > "$_out"
			fi
			return 0
			;;
	esac

	url_ms "$_payload2" "$4" "$5" > "$_out" 2>/dev/null || true
	return 0
}

# ---------------------------------------------------------------- the tunnel

# Can the node the tunnel is actually on carry a request?
#
# Asked of the outbound the running service uses, not of a row in the
# candidate list - so for a protocol Xray cannot speak this exercises the
# bridge too, which is the part that would be broken.
#
# This is the question nothing used to ask. "The process is alive and the
# rules are in place" was taken for health, and a node that completes a TCP
# handshake and then carries nothing satisfies both for ever: the network is
# redirected into it, nothing gets through, and every quarter of an hour the
# healer looked at it and said all was well.
cmd_current() {
	if [ ! -s "$ZGZ_BEST" ]; then
		echo 0
		return 1
	fi
	url_ms "$(cat "$ZGZ_BEST")" \
		"$(sed -n 's/^host=//p' "$ZGZ_BEST_META" 2>/dev/null | tail -1)" \
		"$(sed -n 's/^port=//p' "$ZGZ_BEST_META" 2>/dev/null | tail -1)"
	return $?
}

cmd_live() {
	_sp="$(cfg node_socks_port 1070)"
	[ "$_sp" != 0 ] || { cmd_current; return $?; }
	case "$_sp" in ''|*[!0-9]*) echo 0; return 1 ;; esac
	[ "$_sp" -ge 1 ] && [ "$_sp" -le 65535 ] || { echo 0; return 1; }
	_probe_urls="$(cfg test_url 'http://www.gstatic.com/generate_204')"
	if [ "$_probe_urls" = 'http://www.gstatic.com/generate_204' ]; then
		case "$(bridge_type)" in openconnect|hysteria2) _probe_urls="$_probe_urls https://www.google.com/generate_204" ;; esac
	fi
	for _probe_url in $_probe_urls; do
	if _time="$(curl -fsS -o /dev/null --socks5-hostname "127.0.0.1:$_sp" \
		--connect-timeout 5 --max-time 10 -w '%{time_total}' \
		"$_probe_url" 2>/dev/null)"; then
		awk -v t="$_time" 'BEGIN { m=int(t*1000+0.5); print (m<1 ? 1 : m) }'
		return 0
	fi
	done
	echo 0
	return 1
}

# A listening core is not proof of internet access. Probe only the running
# instance, never a temporary candidate or the router's direct connection.
cmd_connectivity() {
	local identity lock result code port now
	identity="$(connectivity_identity)" || return 1
	lock="$ZGZ_RUN/connectivity.lock"
	[ -z "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ] || rmdir "$lock" 2>/dev/null || true
	mkdir "$lock" 2>/dev/null || return 0
	port="$(cfg node_socks_port 1070)"
	result=0
	case "$port" in
		''|0|*[!0-9]*) : ;;
		*)
			if [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; then
				code="$(curl -fsS -o /dev/null --socks5-hostname "127.0.0.1:$port" \
					--connect-timeout 5 --max-time 10 -w '%{http_code}' \
					https://www.google.com/generate_204 2>/dev/null)" &&
					[ "$code" = 204 ] && result=1
			fi ;;
	esac
	if [ "$(connectivity_identity)" = "$identity" ]; then
		now="$(date +%s)"
		printf '%s %s %s\n' "$identity" "$now" "$result" > "$ZGZ_RUN/connectivity.$$"
		mv -f "$ZGZ_RUN/connectivity.$$" "$ZGZ_RUN/connectivity"
	fi
	rmdir "$lock" 2>/dev/null || true
}

# ------------------------------------------------------------------ exit

# Where the tunnel comes out: the address the rest of the internet sees and
# its country, for the status card's flag. Asked of Cloudflare's trace page,
# which every node can reach and which answers with both and nothing else,
# through the node's own SOCKS port - so it is the tunnel's way out that is
# asked about, whatever the router's own traffic is doing. The node the answer
# is about is kept beside it, so that another node is asked about afresh.
EXIT="$ZGZ_RUN/exit"

cmd_exit() {
	_identity="$(exit_identity)" || return 0
	# A lock left by a run that was killed is not one anybody holds.
	[ -z "$(find "$EXIT.lock" -maxdepth 0 -mmin +1 2>/dev/null)" ] || rmdir "$EXIT.lock" 2>/dev/null || true
	mkdir "$EXIT.lock" 2>/dev/null || return 0
	_sp="$(cfg node_socks_port 1070)"
	_tr=""
	case "$_sp" in
		''|*[!0-9]*) : ;;
		*) _tr="$(curl -s --connect-timeout 8 --max-time 12 --socks5-hostname "127.0.0.1:$_sp" \
			https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)" || _tr="" ;;
	esac
	_cc="$(printf '%s\n' "$_tr" | sed -n 's/^loc=\([A-Z][A-Z]\)$/\1/p' | head -1)"
	_ip="$(printf '%s\n' "$_tr" | sed -n 's/^ip=\([0-9A-Fa-f:.]*\)$/\1/p' | head -1)"
	if [ "$(exit_identity)" = "$_identity" ]; then
		printf 'identity=%s\ncc=%s\nip=%s\n' "$_identity" "$_cc" "$_ip" > "$EXIT.$$"
		mv -f "$EXIT.$$" "$EXIT"
	fi
	rmdir "$EXIT.lock" 2>/dev/null || true
	return 0
}

# ------------------------------------------------------------------ report

cmd_json() {
	printf '{"tests":{'
	_first=1
	for _f in "$DIR"/*; do
		[ -f "$_f" ] || continue
		_k="$(basename "$_f")"
		_v="$(cat "$_f" 2>/dev/null)"
		# Anything that is not one of the two markers or a plain number is a
		# file something else wrote, and a number invented from it would be
		# worse than none.
		case "$_v" in
			-1|-2) : ;;
			''|*[!0-9]*) _v=0 ;;
		esac
		[ "$_first" = "1" ] || printf ','
		printf '"%s":%s' "$(json_escape "$_k")" "${_v:-0}"
		_first=0
	done
	printf '}}\n'
	return 0
}

cmd_run() {
	_kind="$1"; _id="$2"
	_row="$(row_for "$_id")" || {
		put "$_id.$_kind" -2
		return 0
	}
	_proto="$(printf '%s' "$_row" | cut -f3)"
	_host="$(printf '%s' "$_row" | cut -f4)"
	_port="$(printf '%s' "$_row" | cut -f5)"
	_payload="$(printf '%s' "$_row" | cut -f6-)"

	# A TCP handshake to a port that only speaks UDP can never be answered, and
	# a cross would say the node is dead when it is not.
	case "$_kind:$_proto" in
		tcp:l2tp|tcp:pptp|tcp:sstp|tcp:ikev2)
			put "$_id.tcp" -1
			_l2tp_ms="$(printf '%s\n' "$_payload" | "$ZGZ_LIB/$(tunnel_helper "$_proto")" test tcp 2>/dev/null)" || _l2tp_ms=0
			put "$_id.tcp" "$_l2tp_ms"
			return 0 ;;
		ping:aether)
			case "$_host" in ''|auto) put "$_id.ping" -2; return 0 ;; esac
			;;
		tcp:aether)
			case "$_host" in ''|auto) put "$_id.tcp" -2; return 0 ;; esac
			case "$_payload" in *'"transport":"h2"'*) : ;; *) put "$_id.tcp" -2; return 0 ;; esac
			case "$_payload" in
				*'"protocol":"masque"'*|*'"protocol":"wg-over-masque"'*|*'"protocol":"mim"'*) : ;;
				*) put "$_id.tcp" -2; return 0 ;;
			esac
			;;
		tcp:wireguard)
			# There is no TCP port to shake hands with, so the column holds
			# the next best thing that is true: how long a request takes to
			# go through the node once the tunnel is open.
			put "$_id.tcp" -1
			URL_REPEAT=1 url_ms "$_payload" "$_host" "$_port" > "$DIR/$_id.tcp" 2>/dev/null || true
			return 0
			;;
		tcp:hysteria2|tcp:hysteria|tcp:tuic|tcp:anytls|tcp:snell|tcp:naive|tcp:tailscale|tcp:ssh|tcp:ssplugin|tcp:ssr|tcp:ssrust|tcp:mieru|tcp:shadowquic|tcp:trusttunnel|tcp:openvpn|tcp:amneziawg|tcp:warp)
			# Not something Xray can carry, and the column has no other
			# honest answer for them.
			put "$_id.tcp" -2
			return 0
			;;
		ping:warp)
			# Which WARP address it uses is warp-plus's choice, unless the
			# node names one - and then that one can be pinged.
			case "$_payload" in
				*'"endpoint":""'*) put "$_id.ping" -2; return 0 ;;
			esac
			;;
	esac

	case "$_kind" in
		ping) do_ping "$_id" "$_host" ;;
		tcp)
			# A handshake from the router, which with Localhost Proxy on
			# would go through the tunnel and measure the tunnel instead.
			_lp="$(cfg_bool localhost_proxy 1)"
			if [ "$_lp" = "1" ]; then
				"$ZGZ_LIB/zgz-rules" local pause >/dev/null 2>&1 || true
			fi
			do_tcp "$_id" "$_host" "$_port"
			if [ "$_lp" = "1" ]; then
				"$ZGZ_LIB/zgz-rules" local resume >/dev/null 2>&1 || true
			fi
			;;
		url)  TEST_ENGINE="$(subscription_test_engine "$_id" "$_proto")" do_url "$_id" "$_proto" "$_payload" "$_host" "$_port" "$_id" ;;
		*) echo "usage: $0 ping|tcp|url <id>" >&2; return 1 ;;
	esac
	return 0
}

# zgz-test first: of the nodes on stdin (tag<TAB>label<TAB>proto<TAB>host<TAB>
# port<TAB>payload), the first that carries a request - or, when none does,
# the first of them. How the node chosen from a subscription is found again
# when the list no longer holds it and several look the same: on a list such
# as patterniha's every node shares one address, and the one taken by its
# address alone may be the one that does not work here.
cmd_first() {
	_ff="$ZGZ_RUN/first.$$"
	cat > "$_ff"
	_fw=""
	while IFS= read -r _fr; do
		[ -n "$_fr" ] || continue
		case "$(printf '%s' "$_fr" | cut -f3)" in
			vless|vmess|trojan|shadowsocks|socks|http|wireguard) : ;;
			*) continue ;;
		esac
		if url_ms "$(printf '%s' "$_fr" | cut -f6-)" "$(printf '%s' "$_fr" | cut -f4)" \
			"$(printf '%s' "$_fr" | cut -f5)" >/dev/null 2>&1; then
			_fw="$_fr"
			break
		fi
	done < "$_ff"
	[ -n "$_fw" ] || _fw="$(head -1 "$_ff")"
	rm -f "$_ff"
	[ -n "$_fw" ] || return 1
	printf '%s\n' "$_fw"
	return 0
}

case "${1:-json}" in
	first) cmd_first ;;
	ping|tcp|url)
		[ -n "${2:-}" ] || { echo "usage: $0 $1 <id>" >&2; exit 1; }
		cmd_run "$1" "$2"
		;;
	current) cmd_current ;;
	live)    cmd_live ;;
	connectivity) cmd_connectivity ;;
	exit)    cmd_exit ;;
	json)  cmd_json ;;
	clear) rm -f "$DIR"/* 2>/dev/null || true ;;
	*) echo "usage: $0 ping|tcp|url <id>|current|exit|json|clear" >&2; exit 1 ;;
esac
