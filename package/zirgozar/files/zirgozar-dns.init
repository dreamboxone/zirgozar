#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Started explicitly after the DNS guard is installed, never enabled at boot.
USE_PROCD=1
STOP=9
ZGZ_LIB=/usr/libexec
. "$ZGZ_LIB/zgz-common.sh"

start_service() {
	[ -f "$ZGZ_RUN/resolver.enabled" ] && [ -s "$ZGZ_RUN/resolver.conf" ] || return 1
	local binary
	binary="$(command -v dnsmasq)" || return 1
	procd_open_instance resolver
	procd_set_param command "$binary" --keep-in-foreground --conf-file="$ZGZ_RUN/resolver.conf"
	procd_set_param respawn 3600 2 5
	procd_set_param file "$ZGZ_RUN/resolver.conf"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance hosts
	procd_set_param command "$ZGZ_LIB/zgz-dns-local" watch
	procd_set_param respawn 3600 2 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
