#
# zgz-parse - turn share links into something the rest of this can measure
# and run.
#
# Reads links on stdin, one per line, and writes one tab separated record per
# usable server:
#
#     <tag> <label> <protocol> <host> <port> <payload>
#
# For everything Xray speaks natively the payload is the complete outbound
# object, minus its tag. For hysteria2, tuic and WARP - which Xray does not
# speak - the payload is a small description that zgz-bridge turns into a
# local SOCKS listener, and the tag names a socks outbound pointed at it.
#
# Host and port are their own columns because the first thing that happens to
# a hundred candidates is a handshake to each, and re-parsing JSON in shell a
# hundred times to find out where to knock is the sort of thing that makes a
# router feel slow.
#
# Blank lines, comments and anything it does not understand are skipped in
# silence: a subscription is a moving target, and one malformed entry must
# never cost us the other ninety-nine.
#
# Must be run with LC_ALL=C. base64 decoding here reassembles bytes one at a
# time, and an awk in a UTF-8 locale would re-encode every byte above 127 and
# quietly corrupt every non-English server name.

# ---------------------------------------------------------------- base64

function b64init(   i, chars) {
	chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for (i = 1; i <= 64; i++) B64[substr(chars, i, 1)] = i - 1
	for (i = 1; i < 256; i++) CHR[i] = sprintf("%c", i)
	CHR[0] = ""
	# The other direction, for the one place that has to know what a byte is
	# worth rather than what it looks like: trimming a name without cutting a
	# UTF-8 character in half.
	for (i = 1; i < 256; i++) ORD[CHR[i]] = i
}

# Decoding in awk rather than by piping to base64 is worth the twenty lines:
# a hundred vmess links is a hundred forks otherwise, which on a router costs
# more than everything else this script does put together.
function b64(s,   out, i, c, bits, nbits, n) {
	gsub(/-/, "+", s)
	gsub(/_/, "/", s)
	out = ""; bits = 0; nbits = 0
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (!(c in B64)) continue
		bits = bits * 64 + B64[c]
		nbits += 6
		if (nbits >= 8) {
			nbits -= 8
			n = int(bits / exp2(nbits))
			bits = bits - n * exp2(nbits)
			out = out CHR[n % 256]
		}
	}
	return out
}

# The other direction, for the one thing kept whole inside a record: an
# OpenVPN profile, which has every character a TSV line or a JSON string could
# trip on. Bytes, under LC_ALL=C, as the decoder reads them.
function b64enc(s,   chars, out, i, n, a, b, c, v) {
	chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	out = ""
	n = length(s)
	for (i = 1; i <= n; i += 3) {
		a = ORD[substr(s, i, 1)] + 0
		b = (i + 1 <= n) ? ORD[substr(s, i + 1, 1)] + 0 : 0
		c = (i + 2 <= n) ? ORD[substr(s, i + 2, 1)] + 0 : 0
		v = a * 65536 + b * 256 + c
		out = out substr(chars, int(v / 262144) + 1, 1) substr(chars, int(v / 4096) % 64 + 1, 1)
		out = out ((i + 1 <= n) ? substr(chars, int(v / 64) % 64 + 1, 1) : "=")
		out = out ((i + 2 <= n) ? substr(chars, v % 64 + 1, 1) : "=")
	}
	return out
}

function exp2(n,   r, i) {
	r = 1
	for (i = 0; i < n; i++) r = r * 2
	return r
}

# ------------------------------------------------------------- text utils

function jesc(s) {
	gsub(/\\/, "\\\\", s)
	gsub(/"/, "\\\"", s)
	gsub(/\t/, " ", s)
	gsub(/\r/, "", s)
	gsub(/\n/, " ", s)
	return s
}

function hex(h,   d, i, c, v) {
	d = 0
	for (i = 1; i <= length(h); i++) {
		c = tolower(substr(h, i, 1))
		v = index("0123456789abcdef", c) - 1
		if (v < 0) return -1
		d = d * 16 + v
	}
	return d
}

function urldec(s,   out, i, c, h, v) {
	out = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (c == "%" && i + 2 <= length(s)) {
			v = hex(substr(s, i + 1, 2))
			if (v >= 0) { out = out CHR[v]; i += 2; continue }
		}
		out = out c
	}
	return out
}

# A server name is decoration. It arrives with channel advertising, control
# characters and occasionally a whole line of emoji in it, so keep it short
# and printable and let the rest go.
function clean_label(s,   c) {
	s = urldec(s)
	gsub(/[[:cntrl:]]/, " ", s)
	gsub(/\|.*$/, "", s)
	gsub(/^[ \t]+|[ \t]+$/, "", s)
	if (length(s) > 48) {
		s = substr(s, 1, 48)
		# This runs in the C locale, where length() counts bytes, so 48 is 48
		# bytes and a Persian, Arabic or Chinese name is two or three bytes a
		# character. Cutting at a fixed count therefore lands in the middle of
		# a character about as often as not, and half a character is not a
		# shorter name - it is a byte sequence that is no longer UTF-8, and it
		# travels all the way to the web interface as a broken one. So walk
		# back off any continuation bytes, and then off the lead byte whose
		# body has just been removed.
		while (length(s) > 0) {
			c = ORD[substr(s, length(s), 1)]
			if (c >= 128 && c < 192) { s = substr(s, 1, length(s) - 1); continue }
			if (c >= 192) s = substr(s, 1, length(s) - 1)
			break
		}
		gsub(/[ \t]+$/, "", s)
	}
	return s
}

# Pull one key out of a query string.
function qs(query, key,   n, parts, i, kv) {
	n = split(query, parts, "&")
	for (i = 1; i <= n; i++) {
		kv = index(parts[i], "=")
		if (kv > 0 && substr(parts[i], 1, kv - 1) == key)
			return urldec(substr(parts[i], kv + 1))
	}
	return ""
}

# Split "host:port", or "[v6]:port", into HOST and PORT. Returns 0 when there
# is no port to be had, which is the one thing that makes a link unusable.
function hostport(s,   p) {
	sub(/\/+$/, "", s)
	p = match(s, /:[0-9]+$/)
	if (p <= 0) return 0
	HOST = substr(s, 1, p - 1)
	PORT = substr(s, p + 1) + 0
	gsub(/^\[|\]$/, "", HOST)
	if (HOST == "" || PORT <= 0 || PORT > 65535) return 0
	return 1
}

# ------------------------------------------------------------ streamSettings

function stream(net, sec, host, path, sni, fp, alpn, pbk, sid, spx, svc, hdr, mode,   s, t, n, a, i, pqv) {
	# One link's pqv is its own, like its cipher suites.
	pqv = XPQV; XPQV = ""
	if (net == "") net = "tcp"
	if (net == "h2") net = "http"
	if (net == "splithttp") net = "xhttp"
	s = "\"network\":\"" jesc(net) "\""

	if (sec == "tls" || sec == "reality") {
		s = s ",\"security\":\"" jesc(sec) "\""
		t = "\"serverName\":\"" jesc(sni != "" ? sni : host) "\""
		# Only the fingerprints uTLS actually has, checked against Xray 26.3
		# rather than guessed at. An unknown one is not ignored by the core -
		# it refuses to build the outbound at all, and that costs the whole
		# server over a cosmetic field. Dropping just the fingerprint leaves a
		# server that works; passing it on leaves nothing.
		#
		# ("unsafe" is a real value and means Go's own TLS rather than uTLS.
		# It looks like a mistake and is not one.)
		if (fp ~ /^(chrome|firefox|safari|ios|android|edge|360|qq|random|randomized|randomizednoalpn|unsafe|hellogolang)$/)
			t = t ",\"fingerprint\":\"" jesc(fp) "\""
		# The cipher suites, as v2rayN's PattN writes them into a link -
		# "cs", names joined by colons. Paired with the "unsafe" fingerprint
		# they change what the first packet of TLS looks like, which is what
		# gets it past a filter that knows the usual one. One link's are its
		# own: they are forgotten once read.
		if (sec == "tls" && XCS ~ /^[A-Za-z0-9_:]+$/)
			t = t ",\"cipherSuites\":\"" XCS "\""
		XCS = ""
		# ECH as a link writes it, "ech" - a configuration, or a domain and the
		# DNS that publishes it. The node's own ECH setting, if it has one,
		# still wins.
		if (sec == "tls" && XECH != "" && XECH !~ /[[:cntrl:]"\\]/)
			t = t ",\"echConfigList\":\"" XECH "\""
		XECH = ""
		if (alpn != "") {
			n = split(alpn, a, ",")
			t = t ",\"alpn\":["
			for (i = 1; i <= n; i++) {
				gsub(/^[ \t]+|[ \t]+$/, "", a[i])
				t = t (i > 1 ? "," : "") "\"" jesc(a[i]) "\""
			}
			t = t "]"
		}
		if (sec == "reality") {
			if (pbk != "") t = t ",\"publicKey\":\"" jesc(pbk) "\""
			if (sid != "") t = t ",\"shortId\":\"" jesc(sid) "\""
			if (spx != "") t = t ",\"spiderX\":\"" jesc(spx) "\""
			# The post-quantum check of the server, as a link writes it -
			# "pqv", the ML-DSA-65 public key in base64url. Xray verifies the
			# REALITY server's signature with it, and refuses the whole
			# outbound over one that is not exactly a key: 1952 bytes, 2603
			# characters unpadded. Without it the node still connects, only
			# unverified, so a value that is not a key is left out rather
			# than costing the node.
			sub(/=+$/, "", pqv)
			if (pqv ~ /^[A-Za-z0-9_-]+$/ && length(pqv) == 2603)
				t = t ",\"mldsa65Verify\":\"" pqv "\""
			s = s ",\"realitySettings\":{" t "}"
		} else {
			# No allowInsecure here, however tempting. Xray removed it in 26.x
			# and now refuses any outbound that still carries it, so writing it
			# would not loosen verification - it would reject every TLS server
			# on the list outright, on the newest core, for all of them at
			# once. A server whose certificate does not verify simply fails
			# its measurement and is passed over, which is the right outcome.
			s = s ",\"tlsSettings\":{" t "}"
		}
	} else {
		s = s ",\"security\":\"none\""
	}

	if (net == "ws") {
		s = s ",\"wsSettings\":{\"path\":\"" jesc(path != "" ? path : "/") "\""
		if (host != "") s = s ",\"headers\":{\"Host\":\"" jesc(host) "\"}"
		s = s "}"
	} else if (net == "grpc") {
		s = s ",\"grpcSettings\":{\"serviceName\":\"" jesc(svc != "" ? svc : path) "\""
		if (mode == "multi") s = s ",\"multiMode\":true"
		s = s "}"
	} else if (net == "http") {
		s = s ",\"httpSettings\":{\"path\":\"" jesc(path != "" ? path : "/") "\""
		if (host != "") s = s ",\"host\":[\"" jesc(host) "\"]"
		s = s "}"
	} else if (net == "xhttp") {
		s = s ",\"xhttpSettings\":{\"path\":\"" jesc(path != "" ? path : "/") "\""
		if (host != "") s = s ",\"host\":\"" jesc(host) "\""
		if (mode != "") s = s ",\"mode\":\"" jesc(mode) "\""
		# `extra` is where xhttp keeps everything that has no query parameter
		# of its own: the padding range, xmux, the separate download
		# connection. It travels in the link as one whole JSON object, so it
		# is passed through as JSON and not quoted into a string - and it is
		# passed through at all because dropping it means connecting on terms
		# the server was not told about. Real links carry it: every xhttp
		# server seen so far sets xPaddingBytes.
		#
		# Only something shaped like an object is taken. A malformed one would
		# be refused by the core along with the whole outbound, which costs
		# that one server - the same as any other unusable entry, and handled
		# the same way.
		if (XEXTRA ~ /^\{.*\}$/ && XEXTRA !~ /[[:cntrl:]]/)
			s = s ",\"extra\":" XEXTRA
		s = s "}"
	} else if (net == "httpupgrade") {
		s = s ",\"httpupgradeSettings\":{\"path\":\"" jesc(path != "" ? path : "/") "\""
		if (host != "") s = s ",\"host\":\"" jesc(host) "\""
		s = s "}"
	} else if (net == "tcp" && hdr == "http") {
		s = s ",\"tcpSettings\":{\"header\":{\"type\":\"http\",\"request\":{\"path\":[\"" \
		    jesc(path != "" ? path : "/") "\"]"
		if (host != "") s = s ",\"headers\":{\"Host\":[\"" jesc(host) "\"]}"
		s = s "}}}"
	} else if (net == "kcp") {
		s = s ",\"kcpSettings\":{\"header\":{\"type\":\"" jesc(hdr != "" ? hdr : "none") "\"}"
		if (path != "") s = s ",\"seed\":\"" jesc(path) "\""
		s = s "}"
	}
	# Xray's finalmask as a link carries it, "fm": PattN's fragment of the TLS
	# hello, cut where a filter is not looking. The Xray tab's own fragment is
	# not added on top of a link that brings one - see decorate.
	if (XFM ~ /^\{.*\}$/ && XFM !~ /[[:cntrl:]]/)
		s = s ",\"finalmask\":" XFM
	XFM = ""
	return s
}

# ------------------------------------------------------------------ output

# PassWall2's keyword filter on node names, with its five modes: -v FMODE,
# and the two lists from the environment, one keyword a line. A keyword
# matches anywhere in the name, exactly as written.
#   1 drop what matches the discard list
#   2 keep only what matches the keep list
#   3 drop what matches the discard list, unless it matches the keep list
#   4 keep only what matches the keep list, unless it matches the discard list
function fhit(label, arr, cnt,   i) {
	for (i = 1; i <= cnt; i++)
		if (arr[i] != "" && index(label, arr[i]) > 0) return 1
	return 0
}

function flist(s, arr,   cnt, i, k, m) {
	cnt = split(s, arr, "\n")
	m = 0
	for (i = 1; i <= cnt; i++) {
		k = arr[i]
		gsub(/\r/, "", k)
		gsub(/^[ \t]+|[ \t]+$/, "", k)
		if (k != "") arr[++m] = k
	}
	return m
}

function filtered(label) {
	if (FMODE == "" || FMODE == "0") return 0
	if (!fready) {
		ndisc = flist(ENVIRON["ZGZ_FDISCARD"], fdisc)
		nkeep = flist(ENVIRON["ZGZ_FKEEP"], fkeep)
		fready = 1
	}
	if (FMODE == "1") return fhit(label, fdisc, ndisc)
	if (FMODE == "2") return !fhit(label, fkeep, nkeep)
	if (FMODE == "3") return fhit(label, fdisc, ndisc) && !fhit(label, fkeep, nkeep)
	if (FMODE == "4") return !fhit(label, fkeep, nkeep) || fhit(label, fdisc, ndisc)
	return 0
}

# --------------------------------------------------------- a node's own settings
#
# What the edit page of a node added by hand sets beyond its link - the ones
# PassWall2 has on its node page and a share link has no place for. They
# arrive as "#!zgz-x.<key>=<value>" lines in front of the node (see
# node_extras in zgz-common.sh) and are put into every outbound made from it:
#
#   ech            tlsSettings.echConfigList
#   tls_pin        tlsSettings.pinnedPeerCertSha256
#   cert_name      tlsSettings.verifyPeerCertByName
#   tls_pem        tlsSettings.certificates, to verify the server with
#   cipher_suites  tlsSettings.cipherSuites
#   user_agent     the User-Agent header of ws, httpupgrade, xhttp and the
#                  HTTP-header TCP; grpcSettings.user_agent
#   finalmask      streamSettings.finalmask, as written
#   tcp_fast_open  sockopt.tcpFastOpen
#   tcp_mptcp      sockopt.tcpMptcp
#   domain_strategy sockopt.domainStrategy
#   happy_eyeballs sockopt.happyEyeballs
#
# Only an outbound Xray knows - one with a "protocol". The nodes another core
# carries have none of these.
function node_extras(p,   ss, sec, t, sock, net, ws, k, v, pem, n, a, i, arr, h) {
	if (substr(jtrim(p), 1, 1) != "{" || jstr(p, "protocol") == "") return p
	ss = jraw(p, "streamSettings")
	if (ss == "") ss = "{}"
	sec = jstr(ss, "security")
	if (sec == "tls") {
		t = jraw(ss, "tlsSettings")
		if (t == "") t = "{}"
		if (NX["ech"] != "")           t = jset(t, "echConfigList", "\"" jesc(NX["ech"]) "\"")
		if (NX["tls_pin"] != "")       t = jset(t, "pinnedPeerCertSha256", "\"" jesc(NX["tls_pin"]) "\"")
		if (NX["cert_name"] != "")     t = jset(t, "verifyPeerCertByName", "\"" jesc(NX["cert_name"]) "\"")
		if (NX["cipher_suites"] != "") t = jset(t, "cipherSuites", "\"" jesc(NX["cipher_suites"]) "\"")
		if (NX["tls_pem"] != "") {
			# A bar where each line of the certificate ended.
			n = split(NX["tls_pem"], a, "|")
			arr = ""
			for (i = 1; i <= n; i++) {
				gsub(/^[ \t\r]+|[ \t\r]+$/, "", a[i])
				if (a[i] != "") arr = arr (arr != "" ? "," : "") "\"" jesc(a[i]) "\""
			}
			if (arr != "") t = jset(t, "certificates", "[{\"usage\":\"verify\",\"certificate\":[" arr "]}]")
		}
		ss = jset(ss, "tlsSettings", t)
	}
	if (NX["user_agent"] != "") {
		net = tolower(jstr(ss, "network"))
		v = "\"" jesc(NX["user_agent"]) "\""
		if (net == "ws" || net == "httpupgrade" || net == "xhttp" || net == "splithttp") {
			k = (net == "ws") ? "wsSettings" : ((net == "httpupgrade") ? "httpupgradeSettings" : "xhttpSettings")
			ws = jraw(ss, k)
			if (ws == "") ws = "{}"
			h = jraw(ws, "headers")
			if (h == "") h = "{}"
			ws = jset(ws, "headers", jset(h, "User-Agent", v))
			ss = jset(ss, k, ws)
		} else if (net == "grpc") {
			ws = jraw(ss, "grpcSettings")
			if (ws == "") ws = "{}"
			ss = jset(ss, "grpcSettings", jset(ws, "user_agent", v))
		}
	}
	if (NX["finalmask"] ~ /^[ \t]*\{.*\}[ \t]*$/) ss = jset(ss, "finalmask", NX["finalmask"])
	sock = jraw(ss, "sockopt")
	if (sock == "") sock = "{}"
	if (NX["tcp_fast_open"] == "1")  sock = jset(sock, "tcpFastOpen", "true")
	if (NX["tcp_mptcp"] == "1")      sock = jset(sock, "tcpMptcp", "true")
	if (NX["domain_strategy"] ~ /^(AsIs|UseIP|UseIPv4|UseIPv6|UseIPv4v6|UseIPv6v4|ForceIP|ForceIPv4|ForceIPv6|ForceIPv4v6|ForceIPv6v4)$/)
		sock = jset(sock, "domainStrategy", "\"" NX["domain_strategy"] "\"")
	if (NX["happy_eyeballs"] == "1")
		sock = jset(sock, "happyEyeballs", "{\"tryDelayMs\":250,\"prioritizeIPv6\":false,\"interleave\":1,\"maxConcurrentTry\":4}")
	if (sock != "{}") ss = jset(ss, "sockopt", sock)
	if (ss != "{}") p = jset(p, "streamSettings", ss)
	return p
}

# The same server turns up in two subscriptions more often than not. Testing
# it twice costs a slot in a batch that another server could have used.
function emit(label, proto, payload,   key, tag) {
	if (HOST == "" || PORT + 0 <= 0) return
	if (NXN > 0) payload = node_extras(payload)
	if (label == "") label = HOST ":" PORT
	if (filtered(label)) return
	key = proto "|" HOST "|" PORT "|" payload
	if (key in seen) return
	seen[key] = 1
	if (n >= LIMIT) return
	# -v KEEPLINE=1: the list is being sifted rather than read, and what
	# survives is the link itself, to be read with the rest later.
	if (KEEPLINE) { print RAWLINE; n++; return }
	tag = "n" n
	printf "%s\t%s\t%s\t%s\t%d\t%s\n", tag, jesc(label), proto, HOST, PORT, payload
	n++
}

# ---------------------------------------------------------------- vmess://

# base64 of a flat JSON object: add, port, id, aid, net, type, host, path,
# tls, sni, scy, ps.
function do_vmess(body,   j, k, v, o, label) {
	j = b64(body)
	if (j !~ /"add"/) return
	# One link must never inherit the previous one's xhttp settings.
	XEXTRA = ""
	split("", o)
	# a flat object, so a plain key scan needs no JSON parser
	while (match(j, /"[A-Za-z0-9_-]+"[ \t]*:[ \t]*("[^"]*"|-?[0-9.]+|true|false|null)/)) {
		k = substr(j, RSTART, RLENGTH)
		v = k
		sub(/^"/, "", k); sub(/".*/, "", k)
		sub(/^[^:]*:[ \t]*/, "", v)
		gsub(/^"|"$/, "", v)
		o[k] = v
		j = substr(j, RSTART + RLENGTH)
	}
	HOST = o["add"]; PORT = o["port"] + 0
	gsub(/^\[|\]$/, "", HOST)
	label = clean_label(o["ps"])
	XCS = o["cs"]

	emit(label, "vmess", mk_vmess(o["id"], o["aid"], o["scy"], \
		stream(o["net"], (o["tls"] != "" ? o["tls"] : "none"), o["host"], o["path"], \
		       o["sni"], o["fp"], o["alpn"], "", "", "", o["path"], o["type"], o["mode"])))
}

# ---------------------------------------------------------------- vless://

function do_vless(body,   label, uuid, query, p, sec, flow, enc) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	uuid = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return

	sec = qs(query, "security"); if (sec == "") sec = "none"
	flow = qs(query, "flow")
	enc = qs(query, "encryption"); if (enc == "") enc = "none"
	XEXTRA = qs(query, "extra")
	XCS = qs(query, "cs")
	XFM = qs(query, "fm")
	XECH = qs(query, "ech")
	XPQV = qs(query, "pqv")

	emit(label, "vless", mk_vless(uuid, enc, flow, \
		stream(qs(query, "type"), sec, qs(query, "host"), qs(query, "path"), \
		       qs(query, "sni"), qs(query, "fp"), qs(query, "alpn"), \
		       qs(query, "pbk"), qs(query, "sid"), qs(query, "spx"), \
		       qs(query, "serviceName"), qs(query, "headerType"), qs(query, "mode"))))
}

# --------------------------------------------------------------- trojan://

function do_trojan(body,   label, pass, query, p, sec) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	pass = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return

	# trojan is TLS by definition; a link that does not say still means it. One
	# that says none means none: a trojan over Cloudflare's plain-HTTP ports,
	# which patterniha's Xray carries and the official one refuses.
	sec = qs(query, "security"); if (sec == "") sec = "tls"
	XEXTRA = qs(query, "extra")
	XCS = qs(query, "cs")
	XFM = qs(query, "fm")
	XECH = qs(query, "ech")

	emit(label, "trojan", mk_trojan(pass, \
		stream(qs(query, "type"), sec, qs(query, "host"), qs(query, "path"), \
		       qs(query, "sni"), qs(query, "fp"), qs(query, "alpn"), \
		       "", "", "", qs(query, "serviceName"), qs(query, "headerType"), \
		       qs(query, "mode"))))
}

# ------------------------------------------------------------------- ss://
# either base64(method:pass@host:port) or SIP002 base64(method:pass)@host:port

function do_ss(body,   label, p, cred, method, pass, dec, plug) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { plug = substr(body, p + 1); body = substr(body, 1, p - 1) }

	p = index(body, "@")
	if (p > 0) {
		cred = substr(body, 1, p - 1)
		dec = b64(cred)
		# SIP002 keeps the userinfo base64'd; some writers leave it plain
		if (dec ~ /:/) cred = dec
		else cred = urldec(cred)
		if (!hostport(substr(body, p + 1))) return
	} else {
		dec = b64(body)
		p = index(dec, "@")
		if (p <= 0) return
		cred = substr(dec, 1, p - 1)
		if (!hostport(substr(dec, p + 1))) return
	}

	p = index(cred, ":")
	if (p <= 0) return
	method = substr(cred, 1, p - 1)
	pass = substr(cred, p + 1)
	if (method == "") return

	# An obfuscation plugin needs a helper binary this does not ship. Better
	# to drop the entry than to select it and have the tunnel refuse to start.
	if (qs(plug, "plugin") != "") return

	emit(label, "shadowsocks", mk_ss(method, pass))
}

# --------------------------------------------------- socks:// and http://

# The query is this program's own, written by the node page: the transport,
# as a vless link writes it, and uot=1 for UDP carried inside the TCP
# connection. Links from elsewhere have none and come out as they always did.
#
# UDP over TCP is sing-box's, not Xray's: Xray reads past the key and sends UDP
# the ordinary SOCKS way, and wanted_engine hands a node that asks for it to
# sing-box, which zgz-sbconfig tells to do it.
function do_proxy(body, proto,   label, p, cred, user, pass, dec, q, query) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }

	p = index(body, "@")
	if (p > 0) {
		cred = substr(body, 1, p - 1)
		dec = b64(cred)
		if (dec ~ /:/) cred = dec
		else cred = urldec(cred)
		if (!hostport(substr(body, p + 1))) return
		q = index(cred, ":")
		if (q > 0) { user = substr(cred, 1, q - 1); pass = substr(cred, q + 1) }
	} else {
		if (!hostport(body)) return
	}

	XEXTRA = qs(query, "extra")
	emit(label, proto, mk_proxy(proto, user, pass, \
		stream(qs(query, "type"), "none", qs(query, "host"), qs(query, "path"), \
		       "", "", "", "", "", "", qs(query, "serviceName"), qs(query, "headerType"), \
		       qs(query, "mode")), \
		proto == "socks" && qs(query, "uot") == "1"))
}

# ------------------------------------------------- hysteria2:// and tuic://
#
# Xray does not speak either. The payload here describes the node; zgz-bridge
# turns it into a local SOCKS listener run by sing-box or by hysteria itself,
# and the outbound Xray ends up with is a plain socks pointed at that port.
# Nothing else in the program has to know the difference.

function do_hysteria2(body,   label, auth, query, p) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	auth = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return

	emit(label, "hysteria2", \
		"{\"type\":\"hysteria2\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
		",\"password\":\"" jesc(auth) "\"" \
		",\"sni\":\"" jesc(qs(query, "sni")) "\"" \
		",\"obfs\":\"" jesc(qs(query, "obfs")) "\"" \
		",\"obfs_password\":\"" jesc(qs(query, "obfs-password")) "\"" \
		",\"insecure\":" (qs(query, "insecure") == "1" ? "true" : "false") "}")
}

function do_tuic(body,   label, cred, uuid, pass, query, p, q) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	cred = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return
	q = index(cred, ":")
	if (q <= 0) return
	uuid = substr(cred, 1, q - 1)
	pass = substr(cred, q + 1)

	emit(label, "tuic", \
		"{\"type\":\"tuic\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
		",\"uuid\":\"" jesc(uuid) "\",\"password\":\"" jesc(pass) "\"" \
		",\"sni\":\"" jesc(qs(query, "sni")) "\"" \
		",\"congestion_control\":\"" jesc(qs(query, "congestion_control")) "\"" \
		",\"alpn\":\"" jesc(qs(query, "alpn")) "\"" \
		",\"insecure\":" (qs(query, "allow_insecure") == "1" ? "true" : "false") "}")
}

# ------------------------------------------------------------------ warp://
#
# Cloudflare WARP, carried by warp-plus or Vwarp: a client that registers its
# own free account, finds a WARP address that answers from here, and can put a
# second WARP or Psiphon behind the first - or, with Vwarp, reach WARP over
# MASQUE instead of WireGuard. Like hysteria2, the payload describes the node
# and zgz-bridge runs the client as a SOCKS port on loopback.
#
#   warp://[KEY@]ENDPOINT?mode=warp|gool|psiphon|masque&country=AT&scan=1
#          &rtt=1000&ipv=4|6&dns=1.1.1.1&reserved=1,2,3&noize=medium#name
#
# ENDPOINT is host:port, or "auto" - or nothing - for the client to choose. For
# MASQUE it is an address on 443, the port MASQUE always uses, and "auto" is
# Cloudflare's first MASQUE address. KEY is a WARP+ licence. Scanning is on
# unless scan=0 says otherwise, and only for WireGuard with no endpoint given:
# one that is given is the one meant. noize is Vwarp's disguise for the first
# packets - minimal, light, medium, heavy, stealth, gfw or firewall - and asks
# for Vwarp. Hiddify writes the same shape, licence and endpoint included, and
# its own parameters are left alone.
#
# Which account the node uses is its id: the section of a node added by hand,
# so that each has an account of its own, kept under /etc/zirgozar/warp.
function do_aether(body,   label, query, p, proto, scan, ip, transport, outer, inner, id, payload, keys, n, i, k, v) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	proto = qs(query, "protocol"); if (proto == "") proto = "wg"
	if (proto !~ /^(wg|masque|gool|mim|wg-over-masque)$/) return
	scan = qs(query, "scan"); if (scan == "") scan = "balanced"
	if (scan !~ /^(turbo|balanced|thorough|stealth|ironclad)$/) return
	ip = qs(query, "ip"); if (ip == "") ip = "v4"
	if (ip !~ /^(v4|v6|both)$/) return
	transport = qs(query, "transport"); if (transport == "") transport = "h3"
	if (transport !~ /^(h2|h3)$/) return
	outer = qs(query, "outer"); inner = qs(query, "inner")
	HOST = ""; PORT = 0
	if (outer != "" && !hostport(outer)) return
	if (inner != "" && !hostport(inner)) return
	if (body != "" && !hostport(body)) return
	if (outer != "") hostport(outer)
	else if (body == "") { HOST = "auto"; PORT = 443 }
	id = NX["aether_id"]; if (id !~ /^[A-Za-z0-9_]+$/) id = "aether"
	payload = "{\"type\":\"aether\",\"id\":\"" id "\",\"protocol\":\"" proto "\",\"scan\":\"" scan "\",\"ip\":\"" ip "\",\"transport\":\"" transport "\",\"endpoint\":\"" jesc(body) "\",\"outer\":\"" jesc(outer) "\",\"inner\":\"" jesc(inner) "\""
	n = split("noize dns exit_loc fragment fragment_size fragment_delay ech ech_dns ech_domain api_address api_ech api_ech_dns fingerprint sni psiphon psiphon_mode region tor tor_bridges tor_relays bridges cdn_ips cdn_sni cdn_sets psiphon_bundled", keys, " ")
	for (i = 1; i <= n; i++) {
		k = keys[i]; v = qs(query, k)
		if (v != "") payload = payload ",\"" k "\":\"" jesc(v) "\""
	}
	if (label == "") label = "Aether"
	emit(label, "aether", payload "}")
}

function do_warp(body,   label, query, p, key, ep, mode, country, scan, rtt, ipv, dns, res, id, noize, mt) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	sub(/\/+$/, "", body)
	p = index(body, "@")
	if (p > 0) { key = urldec(substr(body, 1, p - 1)); body = substr(body, p + 1) }
	if (key == "") key = qs(query, "key")
	if (key !~ /^[A-Za-z0-9-]*$/) key = ""

	mode = tolower(qs(query, "mode"))
	if (mode == "" || mode == "normal") mode = "warp"
	if (mode == "wiw" || mode == "warp-in-warp") mode = "gool"
	if (mode == "cfon") mode = "psiphon"
	if (mode !~ /^(warp|gool|psiphon|masque)$/) return

	ep = ""
	if (body != "" && tolower(body) != "auto") {
		# MASQUE is always 443; an address on its own means that.
		if (mode == "masque" && body !~ /:[0-9]+$/) body = body ":443"
		if (!hostport(body)) return
		ep = (index(HOST, ":") ? "[" HOST "]" : HOST) ":" PORT
	} else if (mode == "masque") {
		HOST = "162.159.198.1"; PORT = 443
		ep = HOST ":" PORT
	} else {
		# Where to knock when the router has to say something about a node
		# whose address warp-plus will choose: the first WARP address there is.
		HOST = "162.159.192.1"; PORT = 2408
	}

	country = toupper(qs(query, "country"))
	if (mode != "psiphon") country = ""
	else if (country !~ /^[A-Z][A-Z]$/) country = "AT"

	scan = qs(query, "scan")
	scan = (ep != "") ? 0 : (scan == "" ? 1 : (scan == "1" || scan == "true"))
	rtt = qs(query, "rtt") + 0
	if (rtt < 100 || rtt > 10000) rtt = 1000
	ipv = qs(query, "ipv")
	if (ipv !~ /^[46]$/) ipv = ""
	dns = qs(query, "dns")
	if (dns !~ /^[0-9A-Fa-f:.]+$/) dns = "1.1.1.1"
	res = wg_reserved(qs(query, "reserved"))
	gsub(/[][]/, "", res)
	# What Xray's own MASQUE is carried over: HTTP/2 on TCP unless the link
	# says h3, because UDP to Cloudflare's MASQUE address is very often what
	# a filter here drops.
	mt = (qs(query, "mt") == "h3") ? "h3" : "h2"
	noize = tolower(qs(query, "noize"))
	if (noize !~ /^(minimal|light|medium|heavy|stealth|gfw|firewall)$/) noize = ""
	# MASQUE is Vwarp's, and Vwarp disguises it unless told otherwise.
	if (mode == "masque" && noize == "" && qs(query, "noize") != "off") noize = "medium"

	id = NX["warp_id"]
	if (id == "") id = qs(query, "id")
	if (id !~ /^[A-Za-z0-9_]+$/) id = "default"
	if (label == "") label = (mode == "gool") ? "WARP in WARP" : ((mode == "psiphon") ? "WARP + Psiphon " country : ((mode == "masque") ? "WARP MASQUE" : "WARP"))

	emit(label, "warp", \
		"{\"type\":\"warp\",\"mode\":\"" mode "\",\"id\":\"" id "\"" \
		",\"endpoint\":\"" jesc(ep) "\",\"key\":\"" key "\"" \
		",\"scan\":" (scan ? "true" : "false") ",\"rtt\":" rtt \
		",\"ipv\":\"" ipv "\",\"country\":\"" country "\"" \
		",\"dns\":\"" dns "\",\"reserved\":\"" res "\",\"noize\":\"" noize "\"" \
		(mode == "masque" ? ",\"mt\":\"" mt "\"" : "") "}")
}

# A WireGuard node carried by warp-plus rather than by Xray - the node's own
# "Carry with warp-plus" setting. warp-plus sends a burst of junk ahead of every
# handshake, which is what gets WireGuard past a filter that drops it on
# sight. The node goes to warp-plus as the .conf it reads, a bar where each
# line ends, and keeps the outbound Xray would have used beside it, for when it
# is a link in a chain - which warp-plus, with a socket of its own, cannot be.
function mk_wpwg(secret, addrs, pubkey, psk, keepalive, mtu, reserved,   a, conf, xr) {
	xr = mk_wg(secret, addrs, pubkey, psk, keepalive, mtu, reserved)
	a = addrs
	gsub(/[][" ]/, "", a)
	gsub(/,/, ", ", a)
	gsub(/[][ ]/, "", reserved)
	conf = "[Interface]|PrivateKey = " secret "|Address = " a \
	       (mtu + 0 > 0 ? "|MTU = " (mtu + 0) : "") \
	       "|[Peer]|PublicKey = " pubkey \
	       (psk != "" ? "|PresharedKey = " psk : "") \
	       "|AllowedIPs = 0.0.0.0/0, ::/0" \
	       "|Endpoint = " (index(HOST, ":") ? "[" HOST "]" : HOST) ":" PORT \
	       (reserved != "" ? "|Reserved = " reserved : "")
	return "{\"type\":\"warp\",\"mode\":\"wgconf\",\"id\":\"wg\"" \
	       ",\"endpoint\":\"" jesc((index(HOST, ":") ? "[" HOST "]" : HOST) ":" PORT) "\"" \
	       ",\"conf\":\"" jesc(conf) "\",\"xray\":" xr "}"
}

# warp-plus's configuration for one warp record - see WARPCONF below. Only
# what is set is written: warp-plus refuses a country outside Psiphon's list
# even when Psiphon is off, and refuses -4 and -6 together.
function warp_conf(d,   mode, out, ep, key, f, n, lines, i, v) {
	d = jtrim(d)
	if (jstr(d, "type") != "warp") exit 1
	mode = jstr(d, "mode")
	out = "{\"bind\":\"" jesc(ENVIRON["BIND"]) "\",\"cache-dir\":\"" jesc(ENVIRON["CACHE"]) "\""
	# Its own packets carry the mark the firewall lets past, so that with
	# Localhost Proxy on they do not go round into the tunnel they are.
	if (ENVIRON["MARK"] != "") out = out ",\"fwmark\":\"" (ENVIRON["MARK"] + 0) "\""
	v = jstr(d, "dns")
	out = out ",\"dns\":\"" (v ~ /^[0-9A-Fa-f:.]+$/ ? v : "1.1.1.1") "\""
	if (ENVIRON["VERBOSE"] == "1") out = out ",\"verbose\":true"
	if (mode == "wgconf") {
		f = ENVIRON["WGFILE"]
		if (f == "") exit 1
		n = split(jstr(d, "conf"), lines, "|")
		printf "" > f
		for (i = 1; i <= n; i++) print lines[i] > f
		close(f)
		if (ENVIRON["VWARP"] == "1")
			print "--bind " ENVIRON["BIND"] " --cache-dir " ENVIRON["CACHE"] \
			      (ENVIRON["MARK"] != "" ? " --fwmark " (ENVIRON["MARK"] + 0) : "") " --wgconf " f
		else
			print out ",\"wgconf\":\"" jesc(f) "\"}"
		return
	}
	if (mode !~ /^(warp|gool|psiphon|masque)$/) exit 1
	if (ENVIRON["VWARP"] == "1") { vwarp_args(d, mode); return }
	# MASQUE is Vwarp's alone.
	if (mode == "masque") exit 1
	ep = jstr(d, "endpoint")
	key = jstr(d, "key")
	if (ep != "") out = out ",\"endpoint\":\"" jesc(ep) "\""
	if (key ~ /^[A-Za-z0-9-]+$/) out = out ",\"key\":\"" key "\""
	if (mode == "gool") out = out ",\"gool\":true"
	if (mode == "psiphon") {
		v = jstr(d, "country")
		out = out ",\"cfon\":true,\"country\":\"" (v ~ /^[A-Z][A-Z]$/ ? v : "AT") "\""
	}
	if (ep == "" && jbool(d, "scan")) {
		v = jnum(d, "rtt")
		out = out ",\"scan\":true,\"rtt\":\"" (v >= 100 ? v : 1000) "ms\""
	}
	v = jstr(d, "ipv")
	if (v == "4" || v == "6") out = out ",\"" v "\":true"
	v = jstr(d, "reserved")
	if (v ~ /^[0-9]+,[0-9]+,[0-9]+$/) out = out ",\"reserved\":\"" v "\""
	print out "}"
}

# The same for Vwarp, which reads its options from the command line: its
# configuration file is another shape, and one with no noize in it switches
# the disguise off rather than leaving it to the options. Every value is
# checked to be one word, because the line is split on spaces to run it.
function vwarp_args(d, mode,   out, v, ep) {
	out = "--bind " ENVIRON["BIND"] " --cache-dir " ENVIRON["CACHE"]
	if (ENVIRON["MARK"] != "") out = out " --fwmark " (ENVIRON["MARK"] + 0)
	v = jstr(d, "dns")
	out = out " --dns " (v ~ /^[0-9A-Fa-f:.]+$/ ? v : "1.1.1.1")
	if (ENVIRON["VERBOSE"] == "1") out = out " --verbose"
	ep = jstr(d, "endpoint")
	if (ep !~ /^[][0-9A-Za-z:._-]*$/) ep = ""
	if (mode == "masque") {
		if (ep == "") ep = "162.159.198.1:443"
		out = out " --masque --endpoint " ep
	} else if (ep != "") {
		out = out " --endpoint " ep
	}
	v = jstr(d, "key")
	if (v ~ /^[A-Za-z0-9-]+$/) out = out " --key " v
	if (mode == "gool") out = out " --gool"
	if (mode == "psiphon") {
		v = jstr(d, "country")
		out = out " --cfon --country " (v ~ /^[A-Z][A-Z]$/ ? v : "AT")
	}
	if (mode != "masque" && ep == "" && jbool(d, "scan")) {
		v = jnum(d, "rtt")
		out = out " --scan --rtt " (v >= 100 ? v : 1000) "ms"
	}
	v = jstr(d, "ipv")
	if (v == "4") out = out " --ipv4"
	else if (v == "6") out = out " -6"
	v = jstr(d, "reserved")
	if (v ~ /^[0-9]+,[0-9]+,[0-9]+$/) out = out " --reserved " v
	v = jstr(d, "noize")
	# Off unless asked for: Vwarp 2.2 turns noize on with --noize alone, and
	# refuses an empty --noize-preset= outright.
	if (v ~ /^(minimal|light|medium|heavy|stealth|gfw|firewall)$/) out = out " --noize --noize-preset " v
	print out
}

# A WARP account as Xray's own WireGuard outbound - see WARPWG below. Only
# plain WARP has one: WARP in WARP and Psiphon are things warp-plus does, not
# things a WireGuard peer can be told to do. The address it is sent to is the
# node's endpoint, or the first WARP address there is; the reserved bytes are
# the account's own unless the node names others.
function warp_wg(d,   p, cfg, peer, ifc, v4, v6, pk, pub, ep, res) {
	p = ENVIRON["PAYLOAD"]
	if (jstr(p, "mode") == "masque") { warp_masque(d, p); return }
	if (jstr(p, "mode") == "wgconf") {
		if (!hostport(jstr(p, "endpoint")) || jraw(p, "xray") == "") exit 1
		printf "%s\t%s\twireguard\t%s\t%d\t%s\n", ENVIRON["TAG"], ENVIRON["LABEL"], HOST, PORT, jraw(p, "xray")
		return
	}
	if (jstr(p, "mode") != "warp") exit 1
	d = jtrim(d)
	pk = jstr(d, "private_key")
	cfg = jraw(d, "config")
	peer = jfirst(jraw(cfg, "peers"))
	pub = jstr(peer, "public_key")
	ifc = jraw(jraw(cfg, "interface"), "addresses")
	v4 = jstr(ifc, "v4")
	v6 = jstr(ifc, "v6")
	if (pk == "" || pub == "" || v4 == "") exit 1
	ep = jstr(p, "endpoint")
	if (ep == "") ep = "162.159.192.1:2408"
	if (!hostport(ep)) exit 1
	res = jstr(p, "reserved")
	res = (res != "") ? wg_reserved(res) : wg_reserved(jstr(cfg, "client_id"))
	printf "%s\t%s\twireguard\t%s\t%d\t%s\n", ENVIRON["TAG"], ENVIRON["LABEL"], HOST, PORT, \
		mk_wg(pk, "[\"" v4 "/32\"" (v6 != "" ? ",\"" v6 "/128\"" : "") "]", pub, "", 5, 1280, res)
}

# A MASQUE account - the masque_config.json Vwarp writes when it registers -
# as Xray's own MASQUE outbound, which Xray has had since 26.10 (patterniha's
# build first). The account's key is the client certificate, and the
# server's key is pinned in place of a certificate authority, which is how
# Cloudflare's WARP over MASQUE is checked. Vwarp's noize has no equivalent
# here, so a node set to use it stays Vwarp's.
function warp_masque(d, p,   pk, pub, v4, v6, ep) {
	d = jtrim(d)
	pk = jstr(d, "private_key")
	# The server's key arrives as PEM; its base64 body is what Xray reads
	# just as well, without the line breaks a JSON string turns into spaces.
	pub = jraw(d, "endpoint_pub_key")
	gsub(/-----(BEGIN|END) [A-Z ]*-----/, "", pub)
	gsub(/\\n|\\r|["\t ]/, "", pub)
	v4 = jstr(d, "ipv4")
	v6 = jstr(d, "ipv6")
	if (pk == "" || pub == "" || v4 == "") exit 1
	ep = jstr(p, "endpoint")
	if (ep == "" && jstr(d, "endpoint_v4") != "") ep = jstr(d, "endpoint_v4") ":443"
	if (ep == "") ep = "162.159.198.1:443"
	if (!hostport(ep)) exit 1
	printf "%s\t%s\tmasque\t%s\t%d\t%s\n", ENVIRON["TAG"], ENVIRON["LABEL"], HOST, PORT, \
		mk_masque(pk, pub, "\"" v4 "\"" (v6 != "" ? ",\"" v6 "\"" : ""), jstr(p, "mt") == "h3")
}

# H3 is MASQUE over QUIC, as Cloudflare's own client does it; otherwise the
# ALPN asks for HTTP/2, which Xray carries over TCP.
function mk_masque(pk, pub, addrs, h3) {
	return "{\"protocol\":\"masque\",\"settings\":{\"address\":\"" jesc(HOST) "\",\"port\":" PORT "}," \
	       "\"streamSettings\":{\"network\":\"masque\",\"security\":\"tls\"," \
	       "\"tlsSettings\":{\"serverName\":\"consumer-masque.cloudflareclient.com\"" (h3 ? "" : ",\"alpn\":[\"h2\"]") "}," \
	       "\"masqueSettings\":{\"warp\":{\"privateKey\":\"" jesc(pk) "\",\"publicKey\":\"" jesc(pub) "\"," \
	       "\"address\":[" addrs "]}}}}"
}

# ------------------------------------------------------------------- JSON
#
# A subscription is not always a list of links. Providers hand out Xray
# configurations, sing-box configurations, Clash proxy lists, and files that
# are simply an array of nodes - and one of the things those carry, WireGuard,
# has no share link at all in most of them.
#
# What follows is enough of a JSON reader to walk those files: find a named
# member of an object, split an array into its elements, and unquote a string.
# It is not a validator and does not try to be. Anything it cannot make sense
# of is skipped in silence, exactly as a malformed link is.
#
# Every node it finds becomes the same record the link parser emits, so the
# duplicate check, the limit, the measuring and the configuration writer are
# one piece of code for both.

function jws(s, i) {
	while (i <= length(s) && index(" \t\r\n", substr(s, i, 1)) > 0) i++
	return i
}

function jtrim(s) {
	sub(/^[ \t\r\n]+/, "", s)
	sub(/[ \t\r\n]+$/, "", s)
	return s
}

# One past the end of the value starting at i. Strings are walked with their
# escapes, so a brace inside a string cannot be mistaken for structure - which
# is the whole reason this is a scanner and not a regular expression.
function jend(s, i,   c, depth) {
	i = jws(s, i)
	c = substr(s, i, 1)
	if (c == "\"") {
		i++
		while (i <= length(s)) {
			c = substr(s, i, 1)
			if (c == "\\") { i += 2; continue }
			if (c == "\"") return i + 1
			i++
		}
		return i
	}
	if (c == "{" || c == "[") {
		depth = 0
		while (i <= length(s)) {
			c = substr(s, i, 1)
			if (c == "\"") { i = jend(s, i); continue }
			if (c == "{" || c == "[") depth++
			else if (c == "}" || c == "]") {
				depth--
				if (depth <= 0) return i + 1
			}
			i++
		}
		return i
	}
	while (i <= length(s) && index(",}] \t\r\n", substr(s, i, 1)) == 0) i++
	return i
}

# The raw text of one member of an object, or nothing.
function jraw(s, key,   i, c, k, e, ke) {
	i = jws(s, 1)
	if (substr(s, i, 1) != "{") return ""
	i++
	while (i <= length(s)) {
		i = jws(s, i)
		c = substr(s, i, 1)
		if (c == "}" || c == "") return ""
		if (c != "\"") { i++; continue }
		ke = jend(s, i)
		k = substr(s, i + 1, ke - i - 2)
		i = jws(s, ke)
		if (substr(s, i, 1) != ":") continue
		i = jws(s, i + 1)
		e = jend(s, i)
		if (k == key) return substr(s, i, e - i)
		i = jws(s, e)
		if (substr(s, i, 1) == ",") i++
	}
	return ""
}

# A JSON string as text. A \u escape is dropped rather than guessed at: this
# runs in the C locale so that base64 stays byte exact, and inventing UTF-8
# here would be the one place that breaks it.
function junq(v,   out, i, c) {
	if (v == "") return ""
	if (substr(v, 1, 1) != "\"") return v
	v = substr(v, 2, length(v) - 2)
	out = ""
	for (i = 1; i <= length(v); i++) {
		c = substr(v, i, 1)
		if (c == "\\") {
			i++
			c = substr(v, i, 1)
			if (c == "n" || c == "t" || c == "r") c = " "
			else if (c == "u") { i += 4; c = "" }
		}
		out = out c
	}
	return out
}

function jstr(s, key) { return junq(jraw(s, key)) }

function jnum(s, key,   v) {
	v = jraw(s, key)
	gsub(/"/, "", v)
	return v + 0
}

function jbool(s, key,   v) {
	v = jraw(s, key)
	return (v == "true")
}

# Fills out[1..n] with the elements of an array. awk hands arrays over by
# reference, which is the only reason this can both fill one and count it.
function jsplit(a, out,   i, e, m, c) {
	m = 0
	i = jws(a, 1)
	if (substr(a, i, 1) != "[") return 0
	i++
	while (i <= length(a)) {
		i = jws(a, i)
		c = substr(a, i, 1)
		if (c == "]" || c == "") break
		if (c == ",") { i++; continue }
		e = jend(a, i)
		if (e <= i) break
		m++
		out[m] = substr(a, i, e - i)
		i = e
	}
	return m
}

function jfirst(a,   parts, m) {
	m = jsplit(a, parts)
	if (m < 1) return ""
	return parts[1]
}

# An array of strings as a comma list, which is the shape a share link would
# have written and the shape stream() expects.
function jjoin(a,   parts, m, i, out) {
	if (a == "") return ""
	m = jsplit(a, parts)
	if (m < 1) return junq(a)
	out = ""
	for (i = 1; i <= m; i++) out = out (i > 1 ? "," : "") junq(parts[i])
	return out
}

# The same object without one of its members. Used to take the tag off an
# Xray outbound, because the configuration writer supplies its own and two
# tags in one object is a file the core may read either way.
function jdrop(s, key,   i, out, ke, k, e, val, first, c) {
	i = jws(s, 1)
	if (substr(s, i, 1) != "{") return s
	i++
	out = "{"
	first = 1
	while (i <= length(s)) {
		i = jws(s, i)
		c = substr(s, i, 1)
		if (c == "}" || c == "") break
		if (c != "\"") { i++; continue }
		ke = jend(s, i)
		k = substr(s, i + 1, ke - i - 2)
		i = jws(s, ke)
		if (substr(s, i, 1) != ":") continue
		i = jws(s, i + 1)
		e = jend(s, i)
		val = substr(s, i, e - i)
		if (k != key) {
			out = out (first ? "" : ",") "\"" k "\":" val
			first = 0
		}
		i = jws(s, e)
		if (substr(s, i, 1) == ",") i++
	}
	return out "}"
}

# The same object with one member set, replacing it if it was there.
function jset(s, key, val,   o) {
	o = jdrop(s, key)
	if (o == "{}") return "{\"" key "\":" val "}"
	return substr(o, 1, length(o) - 1) ",\"" key "\":" val "}"
}

# An array with one more element on the end.
function jappend(a, item) {
	a = jtrim(a)
	if (a == "" || a == "[]" || substr(a, 1, 1) != "[") return "[" item "]"
	return substr(a, 1, length(a) - 1) "," item "]"
}

# ------------------------------------------------------------- decorating
#
# What the Xray tab adds to an outbound, the way PassWall2 adds it:
#
#   dialerProxy  the outbound dials out through another one - the pre-proxy
#   finalmask    fragment on the TCP side, noise on the UDP side
#   mux          several connections carried in one
#
# Fragment and noise go only on the hop that actually meets the network. An
# outbound that dials through a pre-proxy is carried inside that pre-proxy's
# own connection, and fragmenting a hello nobody on the wire can see would be
# work for nothing - so the mask goes on the pre-proxy instead, which is
# decorated as a first hop in its own right.
#
# The transports each mask applies to are PassWall2's: fragment for raw, ws,
# httpupgrade, grpc and xhttp; noise for mKCP and for xhttp over HTTP/3.
#
# Mux is left off where it cannot work: a VLESS flow (Vision does its own
# thing with UDP and refuses Mux), xhttp (which has its own), WireGuard, and
# the bridge - a loopback SOCKS port in front of a core that is not Xray.
function decorate(p, hp,   proto, ss, sock, net, fm, tcp, udp, first, d, wgs) {
	if (substr(jtrim(p), 1, 1) != "{") return p
	proto = tolower(jstr(p, "protocol"))
	# One already stored without the setting - see mk_wg - gets it here.
	if (proto == "wireguard") {
		wgs = jraw(p, "settings")
		if (wgs != "" && jraw(wgs, "noKernelTun") == "")
			p = jset(p, "settings", jset(wgs, "noKernelTun", "true"))
	}
	if (proto == "socks" && p ~ /"address":"127\.0\.0\.1"/) return p
	# An OpenVPN node: out of its tunnel device, which is already its first
	# and only hop - nothing to dial through, fragment or multiplex.
	if (proto == "freedom" && p ~ /"interface":/) return p

	ss = jraw(p, "streamSettings")
	if (ss == "") ss = "{}"
	sock = jraw(ss, "sockopt")
	if (sock == "") sock = "{}"

	d = (LAND_DIALER != "") ? LAND_DIALER : ENVIRON["DIALER"]
	if (d != "" && jraw(sock, "dialerProxy") == "" && !(ENVIRON["SKIPHP"] != "" && hp == ENVIRON["SKIPHP"]))
		sock = jset(sock, "dialerProxy", "\"" d "\"")
	first = (jraw(sock, "dialerProxy") == "")
	# How the server's own name is resolved: through the core's DNS, which
	# asks the direct resolver, rather than through the router's - which
	# while connected is this tunnel asking itself. Only on the first hop: a
	# node reached through a pre-proxy has its name resolved at the far end.
	if (first && ENVIRON["DOMSTRAT"] != "" && jraw(sock, "domainStrategy") == "")
		sock = jset(sock, "domainStrategy", "\"" ENVIRON["DOMSTRAT"] "\"")
	# The core's own connections carry a mark the firewall lets past, so
	# that the router's traffic can be sent into the tunnel without the
	# tunnel's own traffic following it in.
	if (ENVIRON["SOMARK"] != "" && jraw(sock, "mark") == "")
		sock = jset(sock, "mark", ENVIRON["SOMARK"] + 0)

	net = tolower(jstr(ss, "network"))
	if (net == "") net = "tcp"
	# Twice over is once: a mask already on the outbound is not added again.
	if (first && proto != "wireguard") {
		tcp = ""; udp = ""
		if (ENVIRON["FRAG"] != "" && net ~ /^(tcp|raw|ws|httpupgrade|grpc|xhttp|splithttp)$/ &&
		    jraw(ss, "finalmask") !~ /"type":[ \t]*"fragment"/)
			tcp = ENVIRON["FRAG"]
		if (ENVIRON["NOISE"] != "" && (net ~ /^(kcp|mkcp)$/ || (net ~ /^(xhttp|splithttp)$/ && ss ~ /"alpn":[ \t]*\[[^]]*"h3"/)) &&
		    jraw(ss, "finalmask") !~ /"type":[ \t]*"noise"/)
			udp = ENVIRON["NOISE"]
		if (tcp != "" || udp != "") {
			fm = jraw(ss, "finalmask")
			if (fm == "") fm = "{}"
			if (tcp != "") fm = jset(fm, "tcp", jappend(jraw(fm, "tcp"), tcp))
			if (udp != "") fm = jset(fm, "udp", jappend(jraw(fm, "udp"), udp))
			ss = jset(ss, "finalmask", fm)
		}
	}
	if (sock != "{}") ss = jset(ss, "sockopt", sock)
	if (ss != "{}") p = jset(p, "streamSettings", ss)

	if (ENVIRON["MUX"] != "" && jraw(p, "mux") == "" &&
	    proto ~ /^(vmess|vless|trojan|shadowsocks|socks|http)$/ &&
	    p !~ /"flow":[ \t]*"[^"]+"/ && net !~ /^(xhttp|splithttp)$/)
		p = jset(p, "mux", ENVIRON["MUX"])
	return p
}

# --------------------------------------------------------------- builders
#
# One definition of each outbound, shared by the link parsers above and the
# JSON converters below. Two definitions would drift, and the one that drifted
# would be the one nobody was testing.

function mk_vless(uuid, enc, flow, sset) {
	return "{\"protocol\":\"vless\",\"settings\":{\"vnext\":[{" \
	       "\"address\":\"" jesc(HOST) "\",\"port\":" PORT ",\"users\":[{" \
	       "\"id\":\"" jesc(uuid) "\",\"encryption\":\"" jesc(enc != "" ? enc : "none") "\"" \
	       (flow != "" ? ",\"flow\":\"" jesc(flow) "\"" : "") "}]}]}," \
	       "\"streamSettings\":{" sset "}}"
}

function mk_vmess(id, aid, scy, sset) {
	return "{\"protocol\":\"vmess\",\"settings\":{\"vnext\":[{" \
	       "\"address\":\"" jesc(HOST) "\",\"port\":" PORT ",\"users\":[{" \
	       "\"id\":\"" jesc(id) "\",\"alterId\":" (aid + 0) \
	       ",\"security\":\"" jesc(scy != "" ? scy : "auto") "\"}]}]}," \
	       "\"streamSettings\":{" sset "}}"
}

function mk_trojan(pass, sset) {
	return "{\"protocol\":\"trojan\",\"settings\":{\"servers\":[{" \
	       "\"address\":\"" jesc(HOST) "\",\"port\":" PORT \
	       ",\"password\":\"" jesc(pass) "\"}]}," \
	       "\"streamSettings\":{" sset "}}"
}

function mk_ss(method, pass) {
	return "{\"protocol\":\"shadowsocks\",\"settings\":{\"servers\":[{" \
	       "\"address\":\"" jesc(HOST) "\",\"port\":" PORT \
	       ",\"method\":\"" jesc(method) "\",\"password\":\"" jesc(pass) "\"" \
	       ",\"uot\":true}]}," \
	       "\"streamSettings\":{\"network\":\"tcp\"}}"
}

# ST is what stream() made of the link, plain TCP when there is none; UOT asks
# for UDP over TCP, which only sing-box does - see do_proxy.
function mk_proxy(proto, user, pass, st, uot) {
	if (st == "") st = "\"network\":\"tcp\""
	return "{\"protocol\":\"" proto "\",\"settings\":{\"servers\":[{" \
	       "\"address\":\"" jesc(HOST) "\",\"port\":" PORT \
	       (user != "" ? ",\"users\":[{\"user\":\"" jesc(user) "\",\"pass\":\"" jesc(pass) "\"}]" : "") \
	       (uot ? ",\"udpOverTcp\":true" : "") \
	       "}]},\"streamSettings\":{" st "}}"
}

# WireGuard is an Xray outbound like any other, which is what makes it worth
# carrying at all: no second core, no bridge, no local listener.
function mk_wg(secret, addrs, pubkey, psk, keepalive, mtu, reserved) {
	# noKernelTun: Xray otherwise asks the kernel for a TUN device of its own,
	# and a router without that support - most of them - refuses to start the
	# whole core with "protocol not supported". With it the tunnel is carried
	# in user space, which needs nothing from the kernel.
	return "{\"protocol\":\"wireguard\",\"settings\":{\"noKernelTun\":true," \
	       "\"secretKey\":\"" jesc(secret) "\"" \
	       (addrs != "" ? ",\"address\":" addrs : "") \
	       (mtu + 0 > 0 ? ",\"mtu\":" (mtu + 0) : "") \
	       (reserved != "" ? ",\"reserved\":" reserved : "") \
	       ",\"peers\":[{\"publicKey\":\"" jesc(pubkey) "\"" \
	       ",\"endpoint\":\"" jesc(HOST) ":" PORT "\"" \
	       (psk != "" ? ",\"preSharedKey\":\"" jesc(psk) "\"" : "") \
	       (keepalive + 0 > 0 ? ",\"keepAlive\":" (keepalive + 0) : "") \
	       "}]}}"
}

# An AmneziaWG node: the WireGuard fields, and the obfuscation as one object.
# A number stays a number; a range such as the h1..h4 of version 2, and the
# decoy-packet language of i1..i5, stay text.
function awg_json(a,   keys, n, i, k, out) {
	n = split("jc jmin jmax s1 s2 s3 s4 h1 h2 h3 h4 i1 i2 i3 i4 i5", keys, " ")
	out = ""
	for (i = 1; i <= n; i++) {
		k = keys[i]
		if (!(k in a)) continue
		out = out (out != "" ? "," : "") "\"" k "\":" \
		      (a[k] ~ /^[0-9]+$/ ? a[k] : "\"" jesc(a[k]) "\"")
	}
	return "{" out "}"
}

function mk_awg(secret, addrs, pubkey, psk, keepalive, mtu, a) {
	return "{\"type\":\"amneziawg\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
	       ",\"private_key\":\"" jesc(secret) "\"" \
	       (addrs != "" ? ",\"address\":" addrs : "") \
	       ",\"public_key\":\"" jesc(pubkey) "\"" \
	       (psk != "" ? ",\"pre_shared_key\":\"" jesc(psk) "\"" : "") \
	       (keepalive + 0 > 0 ? ",\"keepalive\":" (keepalive + 0) : "") \
	       (mtu + 0 > 0 ? ",\"mtu\":" (mtu + 0) : "") \
	       ",\"awg\":" awg_json(a) "}"
}

# The local addresses, however they were written: a JSON array, one CIDR, or
# a comma separated list.
function wg_addrs(v,   parts, m, i, out) {
	if (v == "") return ""
	v = jtrim(v)
	if (substr(v, 1, 1) == "[") {
		m = jsplit(v, parts)
		out = ""
		for (i = 1; i <= m; i++) out = out (i > 1 ? "," : "") "\"" jesc(junq(parts[i])) "\""
		return "[" out "]"
	}
	v = junq(v)
	m = split(v, parts, ",")
	out = ""
	for (i = 1; i <= m; i++) {
		gsub(/^[ \t]+|[ \t]+$/, "", parts[i])
		if (parts[i] == "") continue
		out = out (out != "" ? "," : "") "\"" jesc(parts[i]) "\""
	}
	if (out == "") return ""
	return "[" out "]"
}

# The reserved bytes, as Xray wants them: three numbers. They arrive as an
# array, as "78,251,145", or as three bytes of base64.
function wg_reserved(v,   parts, m, i, out, raw) {
	if (v == "") return ""
	v = jtrim(v)
	if (substr(v, 1, 1) == "[") {
		m = jsplit(v, parts)
		if (m < 1) return ""
		out = ""
		for (i = 1; i <= m; i++) out = out (i > 1 ? "," : "") (junq(parts[i]) + 0)
		return "[" out "]"
	}
	v = junq(v)
	if (v ~ /^[0-9]+[ \t]*,[ \t]*[0-9]+[ \t]*,[ \t]*[0-9]+$/) {
		m = split(v, parts, ",")
		out = ""
		for (i = 1; i <= m; i++) out = out (i > 1 ? "," : "") (parts[i] + 0)
		return "[" out "]"
	}
	raw = b64(v)
	if (length(raw) < 3) return ""
	out = ""
	for (i = 1; i <= 3; i++) out = out (i > 1 ? "," : "") (ORD[substr(raw, i, 1)] + 0)
	return "[" out "]"
}

# ------------------------------------------------------------- converters

# An Xray outbound is already the thing this program stores, so it is kept
# whole rather than taken apart and rebuilt. That is the only way to carry a
# setting this parser has never heard of, and files in the wild are full of
# them.
function from_xray(it,   proto, st, srv, lab, payload) {
	proto = tolower(jstr(it, "protocol"))
	if (proto == "") return
	# The service outbounds of a full configuration are not servers.
	if (proto ~ /^(freedom|blackhole|dns|loopback|selector|urltest|direct|block)$/) return
	lab = jstr(it, "tag")
	if (lab == "") lab = jstr(it, "name")
	lab = clean_label(lab)

	if (proto == "wireguard") {
		st = jraw(it, "settings")
		srv = jfirst(jraw(st, "peers"))
		if (!hostport(jstr(srv, "endpoint"))) return
		emit(lab, "wireguard", \
			mk_wg(jstr(st, "secretKey") != "" ? jstr(st, "secretKey") : jstr(st, "secret_key"), \
			      wg_addrs(jraw(st, "address")), \
			      jstr(srv, "publicKey") != "" ? jstr(srv, "publicKey") : jstr(srv, "public_key"), \
			      jstr(srv, "preSharedKey"), jnum(srv, "keepAlive"), \
			      jnum(st, "mtu"), wg_reserved(jraw(st, "reserved"))))
		return
	}

	st = jraw(it, "settings")
	if (proto == "vmess" || proto == "vless") srv = jfirst(jraw(st, "vnext"))
	else srv = jfirst(jraw(st, "servers"))
	HOST = jstr(srv, "address")
	if (HOST == "") HOST = jstr(srv, "server")
	PORT = jnum(srv, "port")
	if (PORT <= 0) PORT = jnum(srv, "server_port")
	if (HOST == "" || PORT <= 0 || PORT > 65535) return

	payload = jdrop(it, "tag")
	# Flattened first: a record is one line, and the comma repair below has to
	# be able to see a comma and the brace after it as neighbours, which they
	# are not while a newline sits between them.
	gsub(/[\n\r\t]/, " ", payload)
	# allowInsecure was removed in Xray 26 and a configuration still carrying
	# it is refused outright - so a file written for an older core would take
	# every one of its servers down at once. Dropped here rather than passed
	# on, which is the same choice made for an unknown TLS fingerprint.
	gsub(/"allowInsecure"[ \t]*:[ \t]*(true|false|"[^"]*")[ \t]*,?/, "", payload)
	gsub(/,[ \t]*}/, "}", payload)
	gsub(/,[ \t]*]/, "]", payload)
	emit(lab, proto, payload)
}

function sb_stream(it,   tls, rel, tr, net, sec, sni, fp, alpn, pbk, sid, path, host, svc) {
	tls = jraw(it, "tls")
	sec = "none"
	if (tls != "" && jbool(tls, "enabled")) sec = "tls"
	sni = jstr(tls, "server_name")
	alpn = jjoin(jraw(tls, "alpn"))
	fp = jstr(jraw(tls, "utls"), "fingerprint")
	rel = jraw(tls, "reality")
	if (rel != "" && jbool(rel, "enabled")) {
		sec = "reality"
		pbk = jstr(rel, "public_key")
		sid = jstr(rel, "short_id")
	}
	tr = jraw(it, "transport")
	net = tolower(jstr(tr, "type"))
	if (net == "") net = "tcp"
	path = jstr(tr, "path")
	host = jjoin(jraw(tr, "host"))
	if (host == "") host = jstr(jraw(tr, "headers"), "Host")
	svc = jstr(tr, "service_name")
	# xhttp carries a mode - packet-up, stream-one, auto - and a fork of
	# sing-box that speaks xhttp writes it here. Dropped, the outbound is
	# built with the wrong mode and carries nothing.
	return stream(net, sec, host, path, sni, fp, alpn, pbk, sid, "", svc, "", jstr(tr, "mode"))
}

function from_singbox(it,   t, lab, peer, aw, ak, ai, nk) {
	t = tolower(jstr(it, "type"))
	if (t == "") return
	if (t ~ /^(direct|block|dns|selector|urltest|tun|mixed)$/) return
	lab = jstr(it, "tag")
	if (lab == "") lab = jstr(it, "name")
	lab = clean_label(lab)

	if (t == "wireguard") {
		# sing-box 1.11 moved WireGuard into "endpoints", where the peer holds
		# the address and the interface holds the local ones.
		peer = jfirst(jraw(it, "peers"))
		HOST = jstr(it, "server")
		if (HOST == "") HOST = jstr(peer, "address")
		if (HOST == "") HOST = jstr(peer, "server")
		PORT = jnum(it, "server_port")
		if (PORT <= 0) PORT = jnum(it, "port")
		if (PORT <= 0) PORT = jnum(peer, "port")
		if (PORT <= 0) PORT = jnum(peer, "server_port")
		if (HOST == "" || PORT <= 0) return
		# AmneziaWG: WireGuard with junk packets and rewritten headers so
		# that it does not look like WireGuard on the wire. Xray's wireguard
		# cannot speak any of it, so it is a node of its own kind, carried by
		# sing-box-lx.
		nk = split("jc jmin jmax s1 s2 s3 s4 h1 h2 h3 h4 i1 i2 i3 i4 i5", ak, " ")
		for (ai = 1; ai <= nk; ai++)
			if (jraw(it, ak[ai]) != "") aw[ak[ai]] = junq(jraw(it, ak[ai]))
		for (ai in aw) {
			emit(lab, "amneziawg", \
				mk_awg(jstr(it, "private_key") != "" ? jstr(it, "private_key") : jstr(it, "secret_key"), \
				       wg_addrs(jraw(it, "address") != "" ? jraw(it, "address") : jraw(it, "local_address")), \
				       jstr(it, "peer_public_key") != "" ? jstr(it, "peer_public_key") : jstr(peer, "public_key"), \
				       jstr(it, "pre_shared_key") != "" ? jstr(it, "pre_shared_key") : jstr(peer, "pre_shared_key"), \
				       jnum(it, "persistent_keepalive_interval"), jnum(it, "mtu"), aw))
			return
		}
		emit(lab, "wireguard", \
			mk_wg(jstr(it, "private_key") != "" ? jstr(it, "private_key") : jstr(it, "secret_key"), \
			      wg_addrs(jraw(it, "address") != "" ? jraw(it, "address") : jraw(it, "local_address")), \
			      jstr(it, "peer_public_key") != "" ? jstr(it, "peer_public_key") : jstr(peer, "public_key"), \
			      jstr(it, "pre_shared_key") != "" ? jstr(it, "pre_shared_key") : jstr(peer, "pre_shared_key"), \
			      jnum(it, "persistent_keepalive_interval"), jnum(it, "mtu"), \
			      wg_reserved(jraw(it, "reserved") != "" ? jraw(it, "reserved") : jraw(peer, "reserved"))))
		return
	}

	HOST = jstr(it, "server")
	PORT = jnum(it, "server_port")
	if (PORT <= 0) PORT = jnum(it, "port")
	if (HOST == "" || PORT <= 0 || PORT > 65535) return

	if (t == "hysteria2" || t == "hysteria") {
		emit(lab, "hysteria2", \
			"{\"type\":\"hysteria2\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
			",\"password\":\"" jesc(jstr(it, "password")) "\"" \
			",\"sni\":\"" jesc(jstr(jraw(it, "tls"), "server_name")) "\"" \
			",\"obfs\":\"" jesc(jstr(jraw(it, "obfs"), "type")) "\"" \
			",\"obfs_password\":\"" jesc(jstr(jraw(it, "obfs"), "password")) "\"" \
			",\"insecure\":" (jbool(jraw(it, "tls"), "insecure") ? "true" : "false") "}")
		return
	}
	if (t == "tuic") {
		emit(lab, "tuic", \
			"{\"type\":\"tuic\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
			",\"uuid\":\"" jesc(jstr(it, "uuid")) "\",\"password\":\"" jesc(jstr(it, "password")) "\"" \
			",\"sni\":\"" jesc(jstr(jraw(it, "tls"), "server_name")) "\"" \
			",\"congestion_control\":\"" jesc(jstr(it, "congestion_control")) "\"" \
			",\"alpn\":\"" jesc(jjoin(jraw(jraw(it, "tls"), "alpn"))) "\"" \
			",\"insecure\":" (jbool(jraw(it, "tls"), "insecure") ? "true" : "false") "}")
		return
	}

	XEXTRA = ""
	if (t == "vless")            emit(lab, "vless", mk_vless(jstr(it, "uuid"), "none", jstr(it, "flow"), sb_stream(it)))
	else if (t == "vmess")       emit(lab, "vmess", mk_vmess(jstr(it, "uuid"), jnum(it, "alter_id"), jstr(it, "security"), sb_stream(it)))
	else if (t == "trojan")      emit(lab, "trojan", mk_trojan(jstr(it, "password"), sb_stream(it)))
	else if (t == "shadowsocks") emit(lab, "shadowsocks", mk_ss(jstr(it, "method"), jstr(it, "password")))
	else if (t == "socks")       emit(lab, "socks", mk_proxy("socks", jstr(it, "username"), jstr(it, "password")))
	else if (t == "http")        emit(lab, "http", mk_proxy("http", jstr(it, "username"), jstr(it, "password")))
}

function cl_stream(it, t,   net, sec, sni, fp, alpn, pbk, sid, path, host, svc, ws, gr, rel) {
	sec = "none"
	if (jbool(it, "tls")) sec = "tls"
	# Clash writes `tls: true` on vmess and vless and leaves it off trojan,
	# because trojan has no other mode: it is TLS or it is nothing. Read
	# literally, every trojan entry in every Clash file came out with
	# security "none" and could not connect to anything.
	if (t == "trojan") sec = "tls"
	sni = jstr(it, "servername")
	if (sni == "") sni = jstr(it, "sni")
	fp = jstr(it, "client-fingerprint")
	alpn = jjoin(jraw(it, "alpn"))
	rel = jraw(it, "reality-opts")
	if (rel != "") {
		sec = "reality"
		pbk = jstr(rel, "public-key")
		sid = jstr(rel, "short-id")
	}
	net = tolower(jstr(it, "network"))
	if (net == "") net = "tcp"
	ws = jraw(it, "ws-opts")
	if (ws != "") {
		path = jstr(ws, "path")
		host = jstr(jraw(ws, "headers"), "Host")
	}
	gr = jraw(it, "grpc-opts")
	if (gr != "") svc = jstr(gr, "grpc-service-name")
	return stream(net, sec, host, path, sni, fp, alpn, pbk, sid, "", svc, "", "")
}

function from_clash(it,   t, lab) {
	t = tolower(jstr(it, "type"))
	lab = clean_label(jstr(it, "name"))
	HOST = jstr(it, "server")
	PORT = jnum(it, "port")

	if (t == "wireguard") {
		if (HOST == "" || PORT <= 0) return
		emit(lab, "wireguard", \
			mk_wg(jstr(it, "private-key"), \
			      wg_addrs(jraw(it, "ip") != "" ? jraw(it, "ip") : jraw(it, "address")), \
			      jstr(it, "public-key"), jstr(it, "pre-shared-key"), \
			      jnum(it, "persistent-keepalive"), jnum(it, "mtu"), \
			      wg_reserved(jraw(it, "reserved"))))
		return
	}
	if (HOST == "" || PORT <= 0 || PORT > 65535) return

	XEXTRA = ""
	if (t == "vless")       emit(lab, "vless", mk_vless(jstr(it, "uuid"), "none", jstr(it, "flow"), cl_stream(it)))
	else if (t == "vmess")  emit(lab, "vmess", mk_vmess(jstr(it, "uuid"), jnum(it, "alterId"), jstr(it, "cipher"), cl_stream(it)))
	else if (t == "trojan") emit(lab, "trojan", mk_trojan(jstr(it, "password"), cl_stream(it, t)))
	else if (t == "ss")     emit(lab, "shadowsocks", mk_ss(jstr(it, "cipher"), jstr(it, "password")))
	else if (t == "socks5") emit(lab, "socks", mk_proxy("socks", jstr(it, "username"), jstr(it, "password")))
	else if (t == "http")   emit(lab, "http", mk_proxy("http", jstr(it, "username"), jstr(it, "password")))
	else if (t == "hysteria2") {
		emit(lab, "hysteria2", \
			"{\"type\":\"hysteria2\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
			",\"password\":\"" jesc(jstr(it, "password")) "\"" \
			",\"sni\":\"" jesc(jstr(it, "sni")) "\"" \
			",\"obfs\":\"" jesc(jstr(it, "obfs")) "\"" \
			",\"obfs_password\":\"" jesc(jstr(it, "obfs-password")) "\"" \
			",\"insecure\":" (jbool(it, "skip-cert-verify") ? "true" : "false") "}")
	}
}

# ---------------------------------------------------------------- the walk

function json_guess(it) {
	if (jraw(it, "protocol") != "" && (jraw(it, "settings") != "" || jraw(it, "streamSettings") != "")) return "xray"
	if (jraw(it, "server_port") != "") return "singbox"
	if (jraw(it, "type") != "" && jraw(it, "tag") != "") return "singbox"
	if (jraw(it, "server") != "" && jraw(it, "name") != "") return "clash"
	if (jraw(it, "type") != "") return "singbox"
	return "xray"
}

function json_item(it, src,   c, lnk, lab) {
	if (n >= LIMIT) return
	c = substr(jtrim(it), 1, 1)
	# A bare string in the list is a share link.
	if (c == "\"") { do_line(junq(it)); return }
	if (c != "{") return

	lnk = jstr(it, "link")
	if (lnk == "") lnk = jstr(it, "url")
	if (lnk == "") lnk = jstr(it, "uri")
	if (lnk == "") lnk = jstr(it, "share_link")
	if (lnk ~ /^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//) {
		# A link with no name of its own takes the name of the object carrying
		# it, which is where the only name in the file often is.
		if (index(lnk, "#") == 0) {
			lab = jstr(it, "remarks")
			if (lab == "") lab = jstr(it, "name")
			if (lab == "") lab = jstr(it, "tag")
			if (lab != "") lnk = lnk "#" lab
		}
		do_line(lnk)
		return
	}

	if (src == "auto" || src == "") src = json_guess(it)
	if (src == "xray")         from_xray(it)
	else if (src == "singbox") from_singbox(it)
	else if (src == "clash")   from_clash(it)
	else                       from_xray(it)
}

function json_doc(doc,   list, extra, m, k, i, src) {
	doc = jtrim(doc)
	m = 0
	src = "auto"

	if (substr(doc, 1, 1) == "[") {
		m = jsplit(doc, list)
	} else if (jraw(doc, "proxies") != "") {
		m = jsplit(jraw(doc, "proxies"), list)
		src = "clash"
	} else if (jraw(doc, "outbounds") != "" || jraw(doc, "endpoints") != "") {
		m = jsplit(jraw(doc, "outbounds"), list)
		k = jsplit(jraw(doc, "endpoints"), extra)
		for (i = 1; i <= k; i++) list[++m] = extra[i]
		# endpoints exist only in sing-box; an Xray outbound says protocol.
		if (k > 0) src = "singbox"
		else if (m > 0 && (jraw(list[1], "protocol") != "" || jraw(list[1], "streamSettings") != "")) src = "xray"
	} else if (jraw(doc, "nodes") != "") {
		m = jsplit(jraw(doc, "nodes"), list)
	} else if (jraw(doc, "links") != "") {
		m = 0
	} else {
		list[1] = doc
		m = 1
	}

	# A "links" array may sit beside any other shape, and often does.
	k = jsplit(jraw(doc, "links"), extra)
	for (i = 1; i <= k; i++) list[++m] = extra[i]

	for (i = 1; i <= m; i++) {
		if (n >= LIMIT) break
		HOST = ""; PORT = 0
		json_item(list[i], src)
	}
}

# -------------------------------------------------------------------------

BEGIN {
	n = 0
	FS = "\n"
	b64init()
	if (LIMIT + 0 <= 0) LIMIT = 400
}

# Most subscriptions hand back one base64 blob rather than a list of links.
# Decoding it needs exactly the decoder above, so -v DECODE=1 turns this into
# that one job rather than duplicating it in shell against a `base64` binary
# that may not be installed.
DECODE { blob = blob $0; next }

# -v DECORATE=1: the input is outbounds already made - records, or bare
# outbound objects one per line - and each is written back with the Xray tab
# applied. The same JSON reader as everything above, rather than a second
# one in shell that would disagree with it about a brace inside a string.
DECORATE {
	line = $0
	gsub(/\r/, "", line)
	if (line == "") next
	if (split(line, rec, "\t") >= 6) {
		p = line
		for (i = 1; i <= 5; i++) sub(/^[^\t]*\t/, "", p)
		printf "%s\t%s\t%s\t%s\t%s\t%s\n", rec[1], rec[2], rec[3], rec[4], rec[5], \
			decorate(p, rec[4] "|" rec[5])
	} else {
		print decorate(line, "")
	}
	next
}

# -v LANDING=1: PassWall2's landing node, for every node of a subscription.
# Each record on stdin is one of its nodes, and comes back as the landing
# node - $LAND, a record - reached through that node: the first hop's address
# is kept, because that is the hop the router actually reaches, and the name
# says both. The node itself is written to $LAND_SIDE, under the name the
# landing node dials ($LAND_ID and a number), for whatever builds the
# outbounds to find. A node Xray cannot speak cannot be dialled through, and
# is left out rather than let traffic leave from the wrong place.
LANDING {
	line = $0
	gsub(/\r/, "", line)
	if (line == "" || split(line, rec, "\t") < 6) next
	if (rec[3] ~ /^(hysteria2|hysteria|tuic|openvpn|amneziawg|warp|aether)$/) next
	if (!lready) {
		split(ENVIRON["LAND"], land, "\t")
		lp = ENVIRON["LAND"]
		for (i = 1; i <= 5; i++) sub(/^[^\t]*\t/, "", lp)
		lready = 1
	}
	p = line
	for (i = 1; i <= 5; i++) sub(/^[^\t]*\t/, "", p)
	lid = ENVIRON["LAND_ID"] (++lcount)
	print lid "\t" p >> ENVIRON["LAND_SIDE"]
	LAND_DIALER = "chain-" lid
	printf "%s\t%s → %s\t%s\t%s\t%s\t%s\n", rec[1], rec[2], land[2], land[3], rec[4], rec[5], \
		decorate(lp, "")
	LAND_DIALER = ""
	next
}

# -v WARPCONF=1: a warp record's payload on stdin, warp-plus's own
# configuration on stdout - the JSON its -c reads, so that a licence never
# shows in the process list. Where it listens, where it keeps its account and
# the mark its packets carry come from the environment: BIND, CACHE, MARK.
# For a WireGuard node, the .conf it reads is written to WGFILE.
WARPCONF { wdoc = wdoc $0; next }

OVPNCONF { wdoc = wdoc $0; next }

# -v WARPWG=1: a WARP account on stdin - the wgcf-identity.json warp-plus
# keeps - and on stdout the same account as a WireGuard record Xray can carry
# itself, for a WARP node that is a link in a chain, a shunt rule's way out or
# a SOCKS port's. PAYLOAD is the node, TAG and LABEL the record's first fields.
WARPWG { wdoc = wdoc $0 "\n"; next }

# One link per line, unless the file turns out to be a configuration.
#
# Which it is, is decided on the first line with anything on it: a brace or a
# bracket there means the whole file has to be read before any of it means
# anything, and anything else means a list, which is the common case and is
# handled a line at a time so that a long one is never held in memory whole.
!DECODE && !LANDING {
	line = $0
	gsub(/\r/, "", line)
	# A node's own settings, for the node or nodes that follow - see
	# node_extras. An empty "#!zgz-x" line ends them.
	if (substr(line, 1, 7) == "#!zgz-x") {
		if (line == "#!zgz-x") { split("", NX); NXN = 0; next }
		if (substr(line, 1, 8) == "#!zgz-x.") {
			_p = index(line, "=")
			if (_p > 9) { NX[substr(line, 9, _p - 9)] = substr(line, _p + 1); NXN++ }
		}
		next
	}
	if (!probed) {
		probe = line
		sub(/^[ \t]+/, "", probe)
		# A comment before anything else decides nothing, and every
		# WireGuard file a provider sends starts with one naming the
		# location. Held on to rather than skipped, because if what
		# follows turns out to be a .conf then that comment is the only
		# name the file has. Bounded, so that a subscription with a
		# preamble on it cannot be held in memory whole.
		if (probe ~ /^[#;]/) {
			if (length(head) < 400) head = head line "\n"
			next
		}
		if (probe != "") {
			probed = 1
			# A brace is a configuration file. A bracket is either a JSON
			# array or the [Interface] header of a WireGuard .conf - the file
			# a provider actually hands out, and the one shape of WireGuard
			# this could not read. Everything else arrives as a wireguard://
			# line or inside somebody else's JSON.
			if (substr(probe, 1, 1) == "{") JSONDOC = 1
			else if (tolower(probe) ~ /^\[(interface|peer)\]/) { WGCONF = 1; doc = head }
			# An OpenVPN profile: the first directive is one of these, or the
			# file opens with a block holding the certificate authority.
			else if (tolower(probe) ~ /^(client|dev[ \t]|remote[ \t]|proto[ \t]|setenv[ \t]|nobind|persist-(key|tun)|tls-client|pull|resolv-retry|auth-user-pass|cipher[ \t]|data-ciphers[ \t]|verb[ \t]|secret[ \t]|<(ca|cert|key|secret|pkcs12|tls-crypt|tls-auth)>)/) { OVPN = 1; doc = head }
			else if (substr(probe, 1, 1) == "[") JSONDOC = 1
			# A YAML key, which is what a Clash or a hysteria file opens
			# with. Not a link: "vless://x" also starts with letters and a
			# colon, and the "://" is what tells the two apart.
			else if (probe ~ /^[A-Za-z_][A-Za-z0-9_.-]*:/ && probe !~ /:\/\//) YAMLDOC = 1
			else if (substr(probe, 1, 2) == "- ") YAMLDOC = 1
		}
	}
	if (JSONDOC || WGCONF || OVPN || YAMLDOC) { doc = doc line "\n"; next }
	do_line(line)
}

END {
	if (WARPCONF) warp_conf(wdoc)
	else if (OVPNCONF) ovpn_run(wdoc)
	else if (WARPWG) warp_wg(wdoc)
	else if (DECODE) printf "%s", b64(blob)
	else if (WGCONF) wg_conf(doc)
	else if (OVPN) ovpn_conf(doc)
	else if (YAMLDOC) yaml_doc(doc)
	else if (JSONDOC) json_doc(doc)
}

function do_line(line) {
	sub(/^[ \t]+/, "", line)
	sub(/[ \t]+$/, "", line)
	if (line == "" || substr(line, 1, 1) == "#") return
	if (n >= LIMIT) return

	HOST = ""; PORT = 0
	RAWLINE = line

	if      (index(line, "vmess://")     == 1) do_vmess(substr(line, 9))
	else if (index(line, "vless://")     == 1) do_vless(substr(line, 9))
	else if (index(line, "trojan://")    == 1) do_trojan(substr(line, 10))
	else if (index(line, "ss://")        == 1) do_ss(substr(line, 6))
	else if (index(line, "socks5://")    == 1) do_proxy(substr(line, 10), "socks")
	else if (index(line, "socks://")     == 1) do_proxy(substr(line, 9), "socks")
	# The node page's HTTP proxy. Only host:port makes one, so the address of
	# a web page in a pasted list is still not taken for a server.
	else if (index(line, "http://")      == 1) do_proxy(substr(line, 8), "http")
	else if (index(line, "hysteria2://") == 1) do_hysteria2(substr(line, 13))
	else if (index(line, "hy2://")       == 1) do_hysteria2(substr(line, 7))
	else if (index(line, "tuic://")      == 1) do_tuic(substr(line, 8))
	else if (index(line, "wireguard://") == 1) do_wireguard(substr(line, 13))
	else if (index(line, "wg://")        == 1) do_wireguard(substr(line, 6))
	else if (index(line, "warp://")      == 1) do_warp(substr(line, 8))
	else if (index(line, "aether://")    == 1) do_aether(substr(line, 10))
}

# ------------------------------------------------------------------- YAML
#
# Clash hands people a .yaml and so does hysteria, and neither was read at
# all. The parser only treated a file as a configuration when it began with {
# or [, so a file beginning `proxies:` fell through to the line reader, which
# found no links in it and produced nothing at all. The two shapes people are
# actually given were the two shapes this could not read.
#
# Rather than teach every converter about YAML, the document is turned into
# JSON once and handed to the readers that already exist. from_clash and
# json_doc never learn that YAML happened.
#
# This is not a YAML implementation. It is the subset these files use: maps
# nested by indentation, sequences of maps, flow maps and flow lists written
# on one line, comments, and quoted or bare scalars. Anchors, multi-line
# scalars, multiple documents and tags are not read - and a file using them
# yields nothing, which is the right answer, rather than something wrong.

function y_trim(s) {
	sub(/^[ \t]+/, "", s)
	sub(/[ \t]+$/, "", s)
	return s
}

# A trailing comment, but only where the # is outside quotes and starts a
# word. A password of "a#b" is not a comment.
function y_uncomment(s,   i, c, q) {
	q = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (q != "") {
			if (c == q) q = ""
		} else if (c == "\"" || c == "'") {
			q = c
		} else if (c == "#" && (i == 1 || substr(s, i - 1, 1) == " " || substr(s, i - 1, 1) == "\t")) {
			return substr(s, 1, i - 1)
		}
	}
	return s
}

function y_plain(s) {
	s = y_trim(s)
	if (length(s) > 1 && substr(s, 1, 1) == "\"" && substr(s, length(s), 1) == "\"")
		return junq(s)
	if (length(s) > 1 && substr(s, 1, 1) == "'" && substr(s, length(s), 1) == "'")
		return substr(s, 2, length(s) - 2)
	return s
}

# Where a "key: value" line divides. Returns "" when the line is not one -
# which includes a flow map or list, and a bare scalar such as a link.
function y_key_of(s,   i, c, q, d) {
	s = y_trim(s)
	if (substr(s, 1, 1) == "{" || substr(s, 1, 1) == "[") return ""
	q = ""; d = 0
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (q != "") { if (c == q) q = ""; continue }
		if (c == "\"" || c == "'") { q = c; continue }
		if (c == "{" || c == "[") d++
		else if (c == "}" || c == "]") d--
		else if (c == ":" && d == 0) {
			if (i == length(s) || substr(s, i + 1, 1) == " ")
				return substr(s, 1, i - 1)
		}
	}
	return ""
}

function y_val_of(s,   k) {
	s = y_trim(s)
	k = y_key_of(s)
	if (k == "") return s
	return y_trim(substr(s, length(k) + 2))
}

# Split a flow body on the commas that are not inside anything else.
function y_split(s, out,   i, c, q, d, cur, n) {
	n = 0; q = ""; d = 0; cur = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (q != "") {
			cur = cur c
			if (c == q) q = ""
			continue
		}
		if (c == "\"" || c == "'") { q = c; cur = cur c; continue }
		if (c == "{" || c == "[") d++
		else if (c == "}" || c == "]") d--
		if (c == "," && d == 0) { out[++n] = cur; cur = ""; continue }
		cur = cur c
	}
	if (y_trim(cur) != "") out[++n] = cur
	return n
}

function y_flow(v,   inner, parts, m, i, p, k, out, ch) {
	v = y_trim(v)
	ch = substr(v, 1, 1)
	if (ch == "{") {
		inner = substr(v, 2, length(v) - 2)
		m = y_split(inner, parts)
		out = ""
		for (i = 1; i <= m; i++) {
			p = y_trim(parts[i])
			if (p == "") continue
			k = y_key_of(p)
			if (k == "") continue
			out = out (out != "" ? "," : "") "\"" jesc(y_plain(k)) "\":" y_scalar(y_val_of(p))
		}
		return "{" out "}"
	}
	if (ch == "[") {
		inner = substr(v, 2, length(v) - 2)
		m = y_split(inner, parts)
		out = ""
		for (i = 1; i <= m; i++) {
			p = y_trim(parts[i])
			if (p == "") continue
			out = out (out != "" ? "," : "") y_scalar(p)
		}
		return "[" out "]"
	}
	return "\"" jesc(v) "\""
}

# Only true and false are booleans here. YAML also reads yes, no, on and off
# that way, and a password of "no" turned into a boolean is a server that
# silently stops working.
function y_scalar(v) {
	v = y_trim(v)
	if (v == "") return "\"\""
	if (substr(v, 1, 1) == "{" || substr(v, 1, 1) == "[") return y_flow(v)
	if (length(v) > 1 && substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"")
		return "\"" jesc(junq(v)) "\""
	if (length(v) > 1 && substr(v, 1, 1) == "'" && substr(v, length(v), 1) == "'")
		return "\"" jesc(substr(v, 2, length(v) - 2)) "\""
	if (tolower(v) == "true") return "true"
	if (tolower(v) == "false") return "false"
	if (tolower(v) == "null" || v == "~") return "null"
	if (v ~ /^-?[0-9]+$/) return v
	return "\"" jesc(v) "\""
}

# One record per meaningful line: how far it is indented, whether it opens a
# sequence entry, and the key and value on it.
function y_tokens(doc,   lines, m, i, l, ind, c, rest, p, k) {
	YN = 0
	m = split(doc, lines, "\n")
	for (i = 1; i <= m; i++) {
		l = lines[i]
		gsub(/\r/, "", l)
		gsub(/\t/, "  ", l)
		l = y_uncomment(l)
		if (y_trim(l) == "") continue
		if (y_trim(l) == "---" || y_trim(l) == "...") continue

		ind = 0
		while (substr(l, ind + 1, 1) == " ") ind++
		c = substr(l, ind + 1)

		YN++
		YSEQ[YN] = 0
		YSQI[YN] = ind
		if (c == "-" || substr(c, 1, 2) == "- ") {
			YSEQ[YN] = 1
			rest = substr(c, 2)
			p = 0
			while (substr(rest, p + 1, 1) == " ") p++
			ind = ind + 1 + p
			c = substr(rest, p + 1)
		}
		YIND[YN] = ind

		k = y_key_of(c)
		if (k == "") { YKEY[YN] = ""; YVAL[YN] = y_trim(c) }
		else { YKEY[YN] = y_plain(k); YVAL[YN] = y_val_of(c) }
	}
}

function y_seq(sind,   out, n) {
	out = ""; n = 0
	while (YI <= YN && YSEQ[YI] && YSQI[YI] == sind) {
		# Consumed: what follows on this line is the entry itself.
		YSEQ[YI] = 0
		out = out (n++ ? "," : "") y_item(YIND[YI])
	}
	return "[" out "]"
}

function y_item(ind,   v) {
	if (YI > YN) return "null"
	if (YKEY[YI] == "") { v = YVAL[YI]; YI++; return y_scalar(v) }
	return y_map(ind)
}

# `sub` is a built-in, and naming a local after one is a syntax error rather
# than a shadowing - which is a good deal better than the alternative.
function y_map(ind,   out, n, k, v, sb) {
	out = ""; n = 0
	while (YI <= YN && YIND[YI] == ind && !YSEQ[YI] && YKEY[YI] != "") {
		k = YKEY[YI]; v = YVAL[YI]
		YI++
		if (v != "") sb = y_scalar(v)
		else if (YI <= YN && YSEQ[YI] && YSQI[YI] >= ind) sb = y_seq(YSQI[YI])
		else if (YI <= YN && YIND[YI] > ind && !YSEQ[YI]) sb = y_map(YIND[YI])
		else sb = "null"
		out = out (n++ ? "," : "") "\"" jesc(k) "\":" sb
	}
	return "{" out "}"
}

function y2j(doc) {
	y_tokens(doc)
	YI = 1
	if (YN == 0) return "{}"
	if (YSEQ[1]) return y_seq(YSQI[1])
	return y_map(YIND[1])
}

# A hysteria2 client configuration, which is one server rather than a list.
function hy_conf(j,   sv, auth, tls, ob, sni, obt, obp, lab) {
	sv = jstr(j, "server")
	sub(/^[A-Za-z0-9+.-]+:\/\//, "", sv)
	if (!hostport(sv)) {
		# hysteria takes a bare host and means 443 by it
		HOST = sv
		PORT = 443
	}
	if (HOST == "" || PORT <= 0 || PORT > 65535) return

	auth = jstr(j, "auth")
	if (auth == "") auth = jstr(j, "auth_str")
	if (auth == "") auth = jstr(j, "auth-str")

	tls = jraw(j, "tls")
	sni = jstr(tls, "sni")
	if (sni == "") sni = jstr(j, "sni")
	if (sni == "") sni = jstr(j, "server_name")

	ob = jraw(j, "obfs")
	obt = jstr(ob, "type")
	obp = jstr(jraw(ob, "salamander"), "password")
	if (obp == "") obp = jstr(ob, "password")

	lab = clean_label(jstr(j, "remarks"))
	if (lab == "") lab = clean_label(jstr(j, "name"))

	emit(lab, "hysteria2", \
		"{\"type\":\"hysteria2\",\"server\":\"" jesc(HOST) "\",\"port\":" PORT \
		",\"password\":\"" jesc(auth) "\"" \
		",\"sni\":\"" jesc(sni) "\"" \
		",\"obfs\":\"" jesc(obt) "\"" \
		",\"obfs_password\":\"" jesc(obp) "\"" \
		",\"insecure\":" ((jbool(tls, "insecure") || jbool(j, "insecure")) ? "true" : "false") "}")
}

function yaml_doc(doc,   j) {
	j = y2j(doc)
	# A hysteria configuration is one server with no list anywhere in it, and
	# nothing else looks like that: everything else this reads is a list of
	# proxies, outbounds or nodes.
	if (jraw(j, "proxies") == "" && jraw(j, "outbounds") == "" &&
	    jraw(j, "endpoints") == "" && jraw(j, "nodes") == "" &&
	    jraw(j, "server") != "" &&
	    (jraw(j, "auth") != "" || jraw(j, "auth_str") != "" ||
	     jraw(j, "obfs") != "" || jraw(j, "bandwidth") != "")) {
		hy_conf(j)
		return
	}
	json_doc(j)
}

# ----------------------------------------------------------- an OpenVPN profile
#
# The .ovpn file a provider hands out, carried by OpenVPN itself - the official
# client, openvpn-openssl - and by nothing else: every directive it knows works,
# a static key, a PKCS#12 bundle, socks-proxy and http-proxy, the reconnect
# and MTU settings, because what it is given is the profile as it came.
#
# So the record keeps the profile whole, base64 in a "profile" field, and
# beside it only what the rest of the program asks of a node: the first
# server, its port and its transport. zgz-bridge writes it back out (see
# OVPNCONF below) and puts its own few lines after it.
#
# What is taken out is what would let a downloaded file act on the router
# rather than on the connection: scripts and plugins, the management socket,
# a different user or root, the routes and DNS it would install, a log or a
# pid file of its own, the device - every one of which this program sets
# itself. The routes in particular: what goes through the tunnel is this
# program's decision and not the profile's.
#
# The user name, the password and the pass phrase of an encrypted key are not
# in the file or are not meant to be; they arrive as comment lines
# "#!zgz-user=..." in front of it, from the settings of the node.

function ov_net(p) {
	p = tolower(p)
	if (p ~ /^tcp/) return "tcp"
	if (p ~ /^udp/) return "udp"
	return ""
}

# Directives left out of the profile this program runs. After the ones that
# would act on the router: those OpenVPN 2.6 no longer has and refuses the
# whole profile over - removed outright, or Windows-only and unknown to the
# Linux build. Profiles made for Windows carry them as a matter of course,
# and sing-box, which carried OpenVPN before, passed over them.
function ov_dropped(k) {
	if (k ~ /^(tls-remote|key-method|ncp-disable|keysize|no-iv|prng|mtu-dynamic|client-cert-not-required|ifconfig-pool-linear|compat-names|no-name-remapping|win-sys|ip-win32|route-method|dhcp-renew|dhcp-release|dhcp-pre-release|tap-sleep|show-net-up|allow-nonadmin|windows-driver|pause-exit|service)$/)
		return 1
	return k ~ /^(up|down|down-pre|up-delay|up-restart|route-up|route-pre-down|ipchange|client-connect|client-disconnect|learn-address|tls-verify|auth-user-pass-verify|plugin|script-security|setenv-safe|management|management-.*|daemon|log|log-append|syslog|writepid|status|status-version|chroot|user|group|cd|config|dev|dev-type|dev-node|redirect-gateway|redirect-private|route|route-ipv6|route-gateway|route-delay|route-metric|route-noexec|route-nopull|iproute|dhcp-option|block-outside-dns|register-dns|mark|askpass|auth-user-pass|verb|tmp-dir|machine-readable-output)$/
}

function ovpn_conf(doc,   lines, m, i, l, t, k, w, nw, p, inblk, name, nrem, rh, rp, rn, \
                          proto, dport, extra, keep, auth, authblk, pl, j, servers, out, tap, vx) {
	m = split(doc, lines, "\n")
	proto = "udp"; dport = 1194
	for (i = 1; i <= m; i++) {
		l = lines[i]
		gsub(/\r/, "", l)
		t = l
		sub(/^[ \t]+/, "", t)
		sub(/[ \t]+$/, "", t)
		if (inblk != "") {
			if (t ~ ("^</" inblk ">")) inblk = ""
			continue
		}
		if (t ~ /^#!zgz-/) {
			t = substr(t, 7)
			p = index(t, "=")
			if (p > 0) extra[substr(t, 1, p - 1)] = substr(t, p + 1)
			continue
		}
		if (t == "" || t ~ /^[#;]/) {
			if (t != "" && name == "") {
				name = substr(t, 2)
				sub(/^[ \t]+/, "", name)
				name = clean_label(name)
			}
			continue
		}
		if (t ~ /^<[A-Za-z0-9-]+>$/) {
			inblk = substr(t, 2, length(t) - 2)
			if (inblk == "auth-user-pass") authblk = 1
			continue
		}
		nw = split(t, w, /[ \t]+/)
		k = tolower(w[1])
		if (k == "remote") {
			nrem++
			rh[nrem] = w[2]
			rp[nrem] = (w[3] ~ /^[0-9]+$/) ? w[3] + 0 : 0
			rn[nrem] = ov_net(w[4])
		}
		else if (k == "proto" || k == "proto-force") proto = ov_net(w[2]) != "" ? ov_net(w[2]) : proto
		else if (k == "port" || k == "rport") dport = w[2] + 0
		else if (k == "auth-user-pass") auth = 1
		else if (k == "dev" && w[2] ~ /^tap/) tap = 1
		else if (k == "dev-type" && w[2] == "tap") tap = 1
		else if (k == "verify-x509-name") vx = 1
	}

	# Nowhere to connect to: a server's profile, or half of one.
	if (nrem < 1) return

	# The profile as it will run: the same lines, without the dropped ones,
	# and without the user name and password block when the node's settings
	# give them instead.
	out = ""; inblk = ""
	for (i = 1; i <= m; i++) {
		l = lines[i]
		gsub(/\r/, "", l)
		t = l
		sub(/^[ \t]+/, "", t)
		sub(/[ \t]+$/, "", t)
		if (inblk != "") {
			if (keep) out = out l "\n"
			if (t ~ ("^</" inblk ">")) inblk = ""
			continue
		}
		if (t == "" || t ~ /^[#;]/) continue
		if (t ~ /^<[A-Za-z0-9-]+>$/) {
			inblk = substr(t, 2, length(t) - 2)
			keep = !(inblk == "auth-user-pass" && extra["user"] != "")
			if (keep) out = out l "\n"
			continue
		}
		nw = split(t, w, /[ \t]+/)
		# tls-remote is gone, and the check it made is verify-x509-name's
		# now: a plain common name says the same thing in the new words.
		if (tolower(w[1]) == "tls-remote" && nw == 2 && !vx && w[2] !~ /[\/=,"]/) {
			out = out "verify-x509-name " w[2] " name\n"
			continue
		}
		if (ov_dropped(tolower(w[1]))) continue
		out = out t "\n"
	}

	for (j = 1; j <= nrem; j++) {
		if (rp[j] <= 0) rp[j] = dport
		if (rn[j] == "") rn[j] = proto
	}
	HOST = rh[1]
	PORT = rp[1]

	pl = "{\"type\":\"openvpn\",\"server\":\"" jesc(rh[1]) "\",\"port\":" rp[1] ",\"network\":\"" rn[1] "\""
	if (nrem > 1) {
		servers = ""
		for (j = 1; j <= nrem; j++)
			servers = servers (j > 1 ? "," : "") "{\"server\":\"" jesc(rh[j]) "\",\"port\":" rp[j] ",\"network\":\"" rn[j] "\"}"
		pl = pl ",\"servers\":[" servers "]"
	}
	if (tap) pl = pl ",\"tap\":true"
	# Asks for a user name and password and is given none: said on the page
	# rather than left for OpenVPN to ask a console nobody is at.
	if (auth && !authblk && extra["user"] == "") pl = pl ",\"needs_auth\":true"
	if (extra["user"] != "") pl = pl ",\"username\":\"" jesc(extra["user"]) "\",\"password\":\"" jesc(extra["pass"]) "\""
	if (extra["keypass"] != "") pl = pl ",\"keypass\":\"" jesc(extra["keypass"]) "\""
	pl = pl ",\"profile\":\"" b64enc(out) "\"}"

	emit(name, "openvpn", pl)
}

# -v OVPNCONF=1: an openvpn record's payload on stdin, the profile it keeps
# on stdout as OpenVPN reads it. The user name and password, and the pass
# phrase of the key, go to the files named by AUTHFILE and PASSFILE, and the
# lines that point OpenVPN at them follow the profile.
function ovpn_run(doc,   u) {
	printf "%s", b64(jstr(doc, "profile"))
	u = jstr(doc, "username")
	if (u != "" && ENVIRON["AUTHFILE"] != "") {
		printf "%s\n%s\n", u, jstr(doc, "password") > ENVIRON["AUTHFILE"]
		close(ENVIRON["AUTHFILE"])
		printf "auth-user-pass %s\n", ENVIRON["AUTHFILE"]
	}
	if (jstr(doc, "keypass") != "" && ENVIRON["PASSFILE"] != "") {
		printf "%s\n", jstr(doc, "keypass") > ENVIRON["PASSFILE"]
		close(ENVIRON["PASSFILE"])
		printf "askpass %s\n", ENVIRON["PASSFILE"]
	}
}

# --------------------------------------------------------- a wireguard .conf
#
# The file wg-quick reads, and the file a WireGuard provider actually gives
# you: [Interface] with a PrivateKey and an Address, [Peer] with a PublicKey
# and an Endpoint. Nothing else in a subscription looks remotely like it, so
# recognising it costs one comparison on the first line - and it means the
# reader can paste the file they were sent instead of first having to turn it
# into a wireguard:// link, which is a thing no ordinary person can do.
#
# Only the fields Xray's wireguard outbound has a use for are read. AllowedIPs
# is deliberately not one of them: this program decides what goes through the
# tunnel with its own routing rules, and a peer's AllowedIPs would be a second
# opinion on the same question. DNS is left out for the same reason - name
# lookups are the Network settings' business.
#
# The name comes from a leading comment when there is one, because that is
# where every provider puts it, and from the endpoint otherwise.
function wg_conf(doc,   lines, m, i, l, sect, k, v, p,
                        name, secret, addrs, mtu, reserved,
                        pubkey, psk, keep, endpoint, awg, nawg) {
	m = split(doc, lines, "\n")
	sect = ""
	for (i = 1; i <= m; i++) {
		l = lines[i]
		sub(/^[ \t]+/, "", l)
		sub(/[ \t]+$/, "", l)
		if (l == "") continue
		if (substr(l, 1, 1) == "#" || substr(l, 1, 1) == ";") {
			if (name == "") {
				name = substr(l, 2)
				sub(/^[ \t]+/, "", name)
				name = clean_label(name)
			}
			continue
		}
		if (substr(l, 1, 1) == "[") { sect = tolower(l); continue }
		p = index(l, "=")
		if (p <= 0) continue
		k = tolower(substr(l, 1, p - 1))
		v = substr(l, p + 1)
		gsub(/^[ \t]+|[ \t]+$/, "", k)
		gsub(/^[ \t]+|[ \t]+$/, "", v)
		# A trailing comment on the value line, which wg-quick tolerates.
		sub(/[ \t]+#.*$/, "", v)
		if (sect == "[interface]") {
			if      (k == "privatekey") secret = v
			else if (k == "address")    addrs = v
			else if (k == "mtu")        mtu = v + 0
			else if (k == "reserved")   reserved = v
			# AmneziaWG's own lines: junk packets, padding, the message types
			# it rewrites and the decoy packets sent first.
			else if (k ~ /^(jc|jmin|jmax|s[1-4]|h[1-4]|i[1-5])$/) { awg[k] = v; nawg++ }
		} else if (sect == "[peer]") {
			if      (k == "publickey")           pubkey = v
			else if (k == "presharedkey")        psk = v
			else if (k == "endpoint")            endpoint = v
			else if (k == "persistentkeepalive") keep = v + 0
		}
	}

	# A key without a peer to use it on, or a peer with nowhere to send to,
	# is not half a server - it is a file that was cut short somewhere.
	if (secret == "" || pubkey == "" || endpoint == "") return
	if (!hostport(endpoint)) return
	# With any of them it is not WireGuard as Xray knows it, and an outbound
	# built as if it were would measure like any other and connect to nothing.
	if (nawg > 0) {
		emit(name, "amneziawg", mk_awg(secret, wg_addrs(addrs), pubkey, psk, keep, mtu, awg))
		return
	}
	if (NX["warpplus"] == "1") {
		emit(name, "warp", mk_wpwg(secret, wg_addrs(addrs), pubkey, psk, keep, mtu, wg_reserved(reserved)))
		return
	}
	emit(name, "wireguard",
	     mk_wg(secret, wg_addrs(addrs), pubkey, psk, keep, mtu, wg_reserved(reserved)))
}

# ------------------------------------------------------------- wireguard://
#
# Not a standard, but the spelling every tool that writes one has settled on,
# and the only way a WireGuard peer travels as a single line.
function do_wireguard(body,   label, secret, query, p) {
	p = index(body, "#")
	if (p > 0) { label = clean_label(substr(body, p + 1)); body = substr(body, 1, p - 1) }
	p = index(body, "?")
	if (p > 0) { query = substr(body, p + 1); body = substr(body, 1, p - 1) }
	p = index(body, "@")
	if (p <= 0) return
	secret = urldec(substr(body, 1, p - 1))
	if (!hostport(substr(body, p + 1))) return

	if (NX["warpplus"] == "1") {
		emit(label, "warp", \
			mk_wpwg(secret, wg_addrs(qs(query, "address")), \
			        qs(query, "publickey") != "" ? qs(query, "publickey") : qs(query, "public-key"), \
			        qs(query, "presharedkey"), qs(query, "keepalive") + 0, \
			        qs(query, "mtu") + 0, wg_reserved(qs(query, "reserved"))))
		return
	}
	emit(label, "wireguard", \
		mk_wg(secret, wg_addrs(qs(query, "address")), \
		      qs(query, "publickey") != "" ? qs(query, "publickey") : qs(query, "public-key"), \
		      qs(query, "presharedkey"), qs(query, "keepalive") + 0, \
		      qs(query, "mtu") + 0, wg_reserved(qs(query, "reserved"))))
}
