//
// zgz-sbconfig - the configuration zgz-mkconfig wrote, in sing-box's words.
//
//   zgz-mkconfig | ucode zgz-sbconfig key=value ...  > sing-box.json
//
// There is one place that decides what the tunnel does - zgz-mkconfig - and
// it speaks Xray. Rather than keep a second generator in step with it, a
// second core is given the same decisions translated: the same inbounds, the
// same outbounds, the same rules in the same order, the same DNS.
//
// What does not carry over is said on stderr, one "warn: ..." line each, and
// never silently: Xray's mux.cool and noise have no sing-box equivalent, mKCP
// is not a sing-box transport at all, and FakeDNS is built differently there.
// An outbound that cannot be translated is dropped, and a rule that sent
// traffic to it sends it through the tunnel's own node instead - the same
// thing the generator does for a node it cannot use. Only the tunnel's own
// node is fatal: exit 2.
//
// Arguments, all key=value:
//   geoview=PATH   the geoview binary, to turn geoip.dat / geosite.dat
//                  categories into rule-sets - sing-box no longer reads the
//                  .dat files itself
//   geodir=DIR     where those two files are
//   rsdir=DIR      where the rule-sets are written
//   api=PORT       the clash API port the statistics are read from
//   mark=N         the mark every connection the core opens carries
//   level=LEVEL    the log level, in Xray's words
//   bridge=FILE    the hysteria2, tuic or AmneziaWG server the chosen node is,
//                  if it is one
//   bridgeport=N   the local port Xray would have been given for it
//   mode=test      a measuring configuration from zgz-test or zgz-probe, not
//                  the tunnel: no node is called proxy, every node it names
//                  has to come across or none is measured with sing-box, and
//                  there is no clash API to collide with the running tunnel's

import { stdin, stderr, popen, stat, mkdir, readfile, writefile, unlink } from 'fs';

let args = {};
for (let a in ARGV) {
	let m = match(a, /^([a-z]+)=(.*)$/);
	if (m)
		args[m[1]] = m[2];
}

function warn(msg) {
	stderr.write(`warn: ${msg}\n`);
}

function camel2snake(s) {
	return lc(replace(s, /([A-Z])/g, '_$1'));
}

// Xray's `extra` for xhttp is camelCase all the way down; sing-box-lx spells
// the same keys in snake_case.
function snake(v) {
	if (type(v) == 'array')
		return map(v, snake);
	if (type(v) != 'object')
		return v;
	let o = {};
	for (let k, x in v)
		o[camel2snake(k)] = snake(x);
	return o;
}

function arr(v) {
	if (v == null)
		return [];
	return type(v) == 'array' ? v : [ v ];
}

// ------------------------------------------------------------------ input

let X = (args.mode == 'bridge') ? {} : json(stdin.read('all'));
if (type(X) != 'object') {
	stderr.write('error: the Xray configuration could not be read\n');
	exit(2);
}

let MARK = int(args.mark ?? 255);
let GEOVIEW = args.geoview;
let GEODIR = args.geodir;
let RSDIR = args.rsdir ?? '/var/run/zirgozar/rs';

// An AmneziaWG node: a WireGuard endpoint with the obfuscation fields of
// sing-box-lx in it. Only that build has them; a sing-box without them refuses
// the configuration, which is how this learns it cannot be used.
function awg_endpoint(b, tag, mark) {
	let peer = { address: b.server, port: int(b.port), public_key: b.public_key, allowed_ips: [ '0.0.0.0/0', '::/0' ] };
	if (b.pre_shared_key)
		peer.pre_shared_key = b.pre_shared_key;
	if (b.keepalive)
		peer.persistent_keepalive_interval = b.keepalive;
	let e = { type: 'wireguard', tag, address: b.address ?? [], private_key: b.private_key, peers: [ peer ], routing_mark: mark };
	if (b.mtu)
		e.mtu = b.mtu;
	for (let k, v in (b.awg ?? {}))
		e[k] = v;
	return e;
}

// zgz-sbconfig mode=bridge: the whole configuration of the helper that offers
// one AmneziaWG server as a SOCKS port on loopback - what zgz-bridge runs when
// Xray is the engine. OpenVPN is not here: the official client carries it.
if (args.mode == 'bridge') {
	let raw = readfile(args.bridge ?? '');
	let b = raw ? json(raw) : null;
	if (type(b) != 'object' || b.type != 'amneziawg') {
		stderr.write('error: There is no AmneziaWG config to run.\n');
		exit(2);
	}
	print(sprintf('%J', {
		log: { level: 'warn', timestamp: true },
		inbounds: [{ type: 'mixed', tag: 'in', listen: '127.0.0.1', listen_port: int(args.bridgeport ?? 10808) }],
		endpoints: [ awg_endpoint(b, 'out', int(args.mark ?? 255)) ],
		route: { final: 'out' }
	}), '\n');
	exit(0);
}

// ----------------------------------------------------------------- geo data

// sing-box does not read geoip.dat or geosite.dat. Each category the rules
// name is turned into a rule-set once - geoview does the reading - and kept
// until the .dat it came from is replaced.
let rule_sets = {};      // tag -> path
let geo_failed = {};

function geo_tag(kind, name) {
	let key = `${kind}-${name}`;
	if (key in rule_sets)
		return key;
	if (key in geo_failed)
		return null;
	if (!GEOVIEW || !GEODIR) {
		geo_failed[key] = true;
		return null;
	}
	let src = `${GEODIR}/${kind}.dat`;
	let out = `${RSDIR}/${key}.srs`;
	let ss = stat(src), os = stat(out);
	if (!ss) {
		geo_failed[key] = true;
		return null;
	}
	if (!os || os.size < 8 || os.mtime < ss.mtime) {
		mkdir(RSDIR);
		let cmd = `'${GEOVIEW}' -action convert -type ${kind} -input '${src}' -list '${name}' -format ruleset -output '${out}' >/dev/null 2>&1`;
		let p = popen(`${cmd}; echo $?`, 'r');
		let rc = trim(p.read('all'));
		p.close();
		os = stat(out);
		if (rc != '0' || !os || os.size < 8) {
			warn(`${kind}:${name} is not in ${kind}.dat - the entry is left out`);
			geo_failed[key] = true;
			return null;
		}
	}
	rule_sets[key] = out;
	return key;
}

// -------------------------------------------------------------- outbounds

let failed = {};         // tag -> why
let out_tags = {};       // tags that made it
let outbounds = [];
let endpoints = [];

function fail_out(tag, why) {
	failed[tag] = why;
	warn(`outbound ${tag}: ${why}`);
}

function tls_of(ss) {
	let sec = ss.security;
	if (sec != 'tls' && sec != 'reality')
		return null;
	let st = (sec == 'reality' ? ss.realitySettings : ss.tlsSettings) ?? {};
	let t = { enabled: true };
	if (st.serverName)
		t.server_name = st.serverName;
	if (st.alpn)
		t.alpn = st.alpn;
	let fp = st.fingerprint;
	if (fp == 'randomizednoalpn')
		fp = 'randomized';
	if (fp == 'unsafe' || fp == 'hellogolang')
		fp = null;
	if (sec == 'reality') {
		t.utls = { enabled: true, fingerprint: fp ?? 'chrome' };
		t.reality = { enabled: true, public_key: st.publicKey ?? '' };
		if (st.shortId)
			t.reality.short_id = st.shortId;
		if (st.mldsa65Verify)
			warn('the post-quantum check of the REALITY server (pqv) has no sing-box equivalent - the node connects unverified');
	} else if (fp) {
		t.utls = { enabled: true, fingerprint: fp };
	}
	// What a node's edit page adds. ECH: sing-box finds the configuration
	// itself through DNS when given none, which is what a "domain+resolver"
	// value asks Xray to do; one given whole is passed on as it is.
	if (st.echConfigList) {
		t.ech = { enabled: true };
		// base64 has a "+" of its own; only an address with "://" is a resolver.
		if (!match(st.echConfigList, /:\/\//))
			t.ech.config = [ '-----BEGIN ECH CONFIGS-----', st.echConfigList, '-----END ECH CONFIGS-----' ];
	}
	if (st.cipherSuites)
		t.cipher_suites = split(st.cipherSuites, /[:, ]+/);
	for (let c in arr(st.certificates))
		if (c.usage == 'verify' && c.certificate)
			t.certificate = [ join('\n', arr(c.certificate)) ];
	if (st.pinnedPeerCertSha256)
		warn('the certificate pin has no sing-box equivalent and is left off');
	if (st.verifyPeerCertByName)
		warn('the certificate name to verify has no sing-box equivalent and is left off');
	for (let m in arr(ss.finalmask?.tcp)) {
		if (m.type == 'fragment') {
			t.fragment = true;
			break;
		}
	}
	return t;
}

function transport_of(ss, tag) {
	let net = ss.network ?? 'tcp';
	switch (net) {
	case 'tcp':
	case 'raw':
		if (ss.tcpSettings?.header?.type == 'http') {
			fail_out(tag, 'a TCP http-header obfuscation has no sing-box transport');
			return false;
		}
		return null;
	case 'ws': {
		let w = ss.wsSettings ?? {};
		let t = { type: 'ws', path: w.path ?? '/' };
		let m = match(t.path, /^([^?]*)\?(.*)$/);
		if (m) {
			let ed = match(m[2], /(^|&)ed=([0-9]+)/);
			if (ed) {
				t.path = m[1];
				t.max_early_data = int(ed[2]);
				t.early_data_header_name = 'Sec-WebSocket-Protocol';
			}
		}
		if (w.headers)
			t.headers = w.headers;
		else if (w.host)
			t.headers = { Host: w.host };
		return t;
	}
	case 'grpc':
		return { type: 'grpc', service_name: ss.grpcSettings?.serviceName ?? '' };
	case 'http':
	case 'h2': {
		let h = ss.httpSettings ?? {};
		let t = { type: 'http', path: h.path ?? '/' };
		if (h.host)
			t.host = arr(h.host);
		return t;
	}
	case 'httpupgrade': {
		let h = ss.httpupgradeSettings ?? {};
		let t = { type: 'httpupgrade', path: h.path ?? '/' };
		if (h.host)
			t.host = h.host;
		if (h.headers)
			t.headers = h.headers;
		return t;
	}
	case 'xhttp':
	case 'splithttp': {
		let h = ss.xhttpSettings ?? {};
		let t = { type: 'xhttp', path: h.path ?? '/' };
		if (h.host)
			t.host = h.host;
		if (h.mode)
			t.mode = h.mode;
		if (h.headers)
			t.headers = h.headers;
		let ex = snake(h.extra ?? {});
		if (ex.download_settings) {
			warn(`outbound ${tag}: a separate download connection (downloadSettings) is not supported by sing-box - it uses one connection`);
			delete ex.download_settings;
		}
		for (let k, v in ex)
			t[k] = v;
		return t;
	}
	}
	fail_out(tag, `the ${net} transport does not exist in sing-box`);
	return false;
}

// A hysteria2 or tuic node is, for Xray, a plain socks outbound pointing at a
// helper program. sing-box needs no helper: the node itself is read from the
// file that describes it and dialled directly.
function native_bridge(o) {
	if (o.tag != 'proxy' || o.protocol != 'socks' || !args.bridge)
		return null;
	let sv = (o.settings?.servers ?? [])[0];
	if (!sv || sv.address != '127.0.0.1' || sv.port != int(args.bridgeport ?? 10808))
		return null;
	let raw = readfile(args.bridge);
	let b = raw ? json(raw) : null;
	if (type(b) != 'object')
		return null;
	if (b.type == 'amneziawg')
		return awg_endpoint(b, 'proxy', MARK);
	let tls = { enabled: true, server_name: b.sni ? b.sni : b.server };
	if (b.insecure)
		tls.insecure = true;
	let r = { tag: 'proxy', server: b.server, server_port: int(b.port), routing_mark: MARK };
	if (b.type == 'hysteria2') {
		r.type = 'hysteria2';
		r.password = b.password;
		if (b.obfs)
			r.obfs = { type: b.obfs, password: b.obfs_password };
	} else if (b.type == 'tuic') {
		r.type = 'tuic';
		r.uuid = b.uuid;
		r.password = b.password;
		r.congestion_control = b.congestion_control ? b.congestion_control : 'bbr';
		tls.alpn = [ 'h3' ];
	} else {
		return null;
	}
	r.tls = tls;
	return r;
}

function conv_outbound(o) {
	let tag = o.tag;
	let nb = native_bridge(o);
	if (nb) {
		// An AmneziaWG node is an endpoint in sing-box, not an outbound.
		push(nb.type == 'wireguard' ? endpoints : outbounds, nb);
		out_tags[tag] = true;
		return;
	}
	let proto = o.protocol;
	let ss = o.streamSettings ?? {};
	let sock = ss.sockopt ?? {};
	let s = o.settings ?? {};
	let r = null;

	if (proto == 'freedom') {
		r = { type: 'direct', tag };
	} else if (proto == 'dns' || proto == 'blackhole') {
		return;
	} else if (proto == 'wireguard') {
		let p = (s.peers ?? [])[0] ?? {};
		let ep = match(p.endpoint ?? '', /^(.*):([0-9]+)$/);
		if (!ep)
			return fail_out(tag, 'the WireGuard peer has no endpoint');
		let e = {
			type: 'wireguard', tag,
			address: arr(s.address),
			private_key: s.secretKey,
			peers: [{
				address: replace(ep[1], /^\[|\]$/g, ''),
				port: int(ep[2]),
				public_key: p.publicKey,
				allowed_ips: [ '0.0.0.0/0', '::/0' ]
			}]
		};
		if (p.preSharedKey)
			e.peers[0].pre_shared_key = p.preSharedKey;
		if (s.reserved)
			e.peers[0].reserved = s.reserved;
		if (s.mtu)
			e.mtu = s.mtu;
		if (sock.dialerProxy)
			e.detour = sock.dialerProxy;
		else
			e.routing_mark = sock.mark ?? MARK;
		push(endpoints, e);
		out_tags[tag] = true;
		return;
	} else {
		let v = (s.vnext ?? s.servers ?? [])[0];
		if (!v)
			return fail_out(tag, 'no server in the outbound');
		r = { type: null, tag, server: v.address, server_port: v.port };
		let u = (v.users ?? [])[0] ?? {};
		switch (proto) {
		case 'vless':
			r.type = 'vless';
			r.uuid = u.id;
			if (u.flow)
				r.flow = u.flow;
			if (u.encryption && u.encryption != 'none')
				r.encryption = u.encryption;
			r.packet_encoding = 'xudp';
			break;
		case 'vmess':
			r.type = 'vmess';
			r.uuid = u.id;
			r.security = u.security ?? 'auto';
			r.alter_id = u.alterId ?? 0;
			r.packet_encoding = 'xudp';
			break;
		case 'trojan':
			r.type = 'trojan';
			r.password = v.password;
			break;
		case 'shadowsocks':
			r.type = 'shadowsocks';
			r.method = v.method;
			r.password = v.password;
			break;
		case 'socks':
			r.type = 'socks';
			r.version = '5';
			if (u.user) {
				r.username = u.user;
				r.password = u.pass;
			}
			// Written by zgz-parse for a node that asks for it; Xray has
			// no such thing and passes over the key.
			if (v.udpOverTcp)
				r.udp_over_tcp = true;
			break;
		case 'http':
			r.type = 'http';
			if (u.user) {
				r.username = u.user;
				r.password = u.pass;
			}
			break;
		default:
			return fail_out(tag, `the ${proto} protocol is not translated`);
		}
		if (type(r.server_port) == 'string')
			r.server_port = int(r.server_port);

		let tr = transport_of(ss, tag);
		if (tr === false)
			return;
		// sing-box's socks, http and shadowsocks have no transport field and
		// refuse the whole configuration over one that does.
		if (tr && (proto == 'socks' || proto == 'http' || proto == 'shadowsocks'))
			return fail_out(tag, `a ${proto} node over ${tr.type} has no sing-box equivalent`);
		let tls = tls_of(ss);
		if (tls)
			r.tls = tls;
		if (tr)
			r.transport = tr;
		if (o.mux?.enabled)
			warn(`outbound ${tag}: mux.cool has no sing-box equivalent and is left off`);
	}

	if (sock.dialerProxy)
		r.detour = sock.dialerProxy;
	r.routing_mark = sock.mark ?? MARK;
	// An OpenVPN node's way out: its tunnel device, which OpenVPN keeps.
	if (sock.interface)
		r.bind_interface = sock.interface;
	if (sock.tcpFastOpen)
		r.tcp_fast_open = true;
	if (sock.tcpMptcp)
		r.tcp_multi_path = true;
	// How the server's own name is looked up, once the resolver it is looked
	// up with is known - see below.
	let ds = { UseIPv4: 'ipv4_only', ForceIPv4: 'ipv4_only', UseIPv6: 'ipv6_only', ForceIPv6: 'ipv6_only',
	           UseIPv4v6: 'prefer_ipv4', ForceIPv4v6: 'prefer_ipv4', UseIPv6v4: 'prefer_ipv6', ForceIPv6v4: 'prefer_ipv6' }[sock.domainStrategy];
	if (ds)
		r._strategy = ds;
	push(outbounds, r);
	out_tags[tag] = true;
}

for (let o in X.outbounds)
	conv_outbound(o);

// A measurement of a node sing-box cannot carry is not to be taken through
// some other node: the core that can carry it measures the lot instead.
if (args.mode == 'test') {
	for (let t, why in failed) {
		stderr.write(`error: ${t} cannot be used with sing-box: ${why}\n`);
		exit(2);
	}
} else if (!out_tags.proxy) {
	stderr.write(`error: the tunnel's own node cannot be used with sing-box: ${failed.proxy ?? 'not translated'}\n`);
	exit(2);
}

// The tag a rule's outbound becomes. Anything dropped goes through the tunnel.
function target(tag) {
	if (tag == 'direct' || tag == 'block')
		return tag;
	if (out_tags[tag])
		return tag;
	// A measurement has no tunnel to fall back on: a blackhole, the one thing
	// left out without failing, drops what it is sent.
	return args.mode == 'test' ? 'block' : 'proxy';
}

// ----------------------------------------------------------------- inbounds

let inbounds = [];
let sniff_in = [];

for (let i in X.inbounds) {
	let tag = i.tag;
	if (tag == 'api-in')
		continue;
	let ss = i.streamSettings ?? {};
	let b = null;
	if (i.protocol == 'dokodemo-door' && tag == 'dns-in') {
		b = { type: 'direct', tag, listen: i.listen, listen_port: i.port,
		      override_address: i.settings?.address, override_port: i.settings?.port };
	} else if (i.protocol == 'dokodemo-door') {
		let way = ss.sockopt?.tproxy;
		if (way == 'redirect') {
			b = { type: 'redirect', tag, listen: i.listen, listen_port: i.port };
		} else {
			b = { type: 'tproxy', tag, listen: i.listen, listen_port: i.port };
			let nw = i.settings?.network;
			if (nw == 'tcp' || nw == 'udp')
				b.network = nw;
		}
		if (i.sniffing?.enabled)
			push(sniff_in, tag);
	} else if (i.protocol == 'socks') {
		b = { type: 'socks', tag, listen: i.listen, listen_port: i.port };
	} else {
		warn(`inbound ${tag}: ${i.protocol} is not translated`);
		continue;
	}
	push(inbounds, b);
}

// -------------------------------------------------------------- name lists

// A sing-box rule-set named in a shunt rule, as PassWall2 writes one:
// rule-set:remote:URL or rule-set:local:PATH, rs: for short. A remote one is
// fetched by sing-box itself, through the default way out.
let user_sets = {};      // tag -> definition
let user_set_n = 0;

function user_set(entry) {
	let m = match(entry, /^(rule-set|rs):(local|remote):(.+)$/);
	if (!m) {
		warn(`${entry}: not a rule-set:local: or rule-set:remote: entry - left out`);
		return null;
	}
	let where = m[3];
	for (let t, d in user_sets)
		if ((d.url ?? d.path) == where)
			return t;
	let t = `user-rs-${++user_set_n}`;
	let format = match(where, /\.json$/i) ? 'source' : 'binary';
	user_sets[t] = (m[2] == 'remote')
		? { tag: t, type: 'remote', format, url: where }
		: { tag: t, type: 'local', format, path: where };
	return t;
}

// One Xray list of names, as sing-box's separate matchers. `lit` and `sets`
// have to stay apart: a rule-set in a rule is an extra condition, not another
// way to match, so a rule with both would need a name to be in both.
function split_names(list) {
	let g = { domain: [], domain_suffix: [], domain_keyword: [], domain_regex: [], sets: [] };
	for (let d in arr(list)) {
		let m;
		if ((m = match(d, /^geosite:(.+)$/))) {
			let name = replace(m[1], /@.*$/, '');
			let t = geo_tag('geosite', name);
			if (t && !(t in g.sets))
				push(g.sets, t);
		} else if (match(d, /^(rule-set|rs):/)) {
			let t = user_set(d);
			if (t && !(t in g.sets))
				push(g.sets, t);
		} else if (match(d, /^ext:/)) {
			warn(`${d}: external geo files are not supported by sing-box - left out`);
		} else if ((m = match(d, /^domain:(.+)$/))) {
			push(g.domain_suffix, m[1]);
		} else if ((m = match(d, /^full:(.+)$/))) {
			push(g.domain, m[1]);
		} else if ((m = match(d, /^regexp:(.+)$/))) {
			push(g.domain_regex, m[1]);
		} else if ((m = match(d, /^keyword:(.+)$/))) {
			push(g.domain_keyword, m[1]);
		} else if ((m = match(d, /^plain:(.+)$/))) {
			push(g.domain_keyword, m[1]);
		} else {
			// Xray's bare name is a substring match.
			push(g.domain_keyword, d);
		}
	}
	return g;
}

// The groups of a name list as conditions, one per group that has anything.
function name_groups(g) {
	let r = [];
	let lit = {};
	for (let k in [ 'domain', 'domain_suffix', 'domain_keyword', 'domain_regex' ])
		if (length(g[k]))
			lit[k] = g[k];
	if (length(lit))
		push(r, lit);
	if (length(g.sets))
		push(r, { rule_set: g.sets });
	return r;
}

function ip_groups(list) {
	let r = [];
	let cidr = [], sets = [], priv = false;
	for (let a in arr(list)) {
		let m;
		if ((m = match(a, /^geoip:(.+)$/))) {
			if (m[1] == 'private') {
				priv = true;
			} else {
				let t = geo_tag('geoip', m[1]);
				if (t && !(t in sets))
					push(sets, t);
			}
		} else if (match(a, /^(rule-set|rs):/)) {
			let t = user_set(a);
			if (t && !(t in sets))
				push(sets, t);
		} else if (match(a, /^ext:/)) {
			warn(`${a}: external geo files are not supported by sing-box - left out`);
		} else {
			push(cidr, a);
		}
	}
	if (length(cidr))
		push(r, { ip_cidr: cidr });
	if (length(sets))
		push(r, { rule_set: sets });
	if (priv)
		push(r, { ip_is_private: true });
	return r;
}

// ------------------------------------------------------------------- rules

let rules = [];
let final_out = 'proxy';

if (length(sniff_in))
	push(rules, { inbound: sniff_in, action: 'sniff', sniffer: [ 'http', 'tls', 'quic' ] });
for (let i in inbounds)
	if (i.tag == 'dns-in')
		push(rules, { inbound: [ 'dns-in' ], action: 'hijack-dns' });

// Which tag each of the core's own DNS servers dials through - Xray decided
// that with a rule on the resolver's own inbound tag.
let dns_via = {};

function with_action(c, outbound) {
	if (outbound == 'block') {
		c.action = 'reject';
		c.method = 'drop';
	} else {
		c.action = 'route';
		c.outbound = outbound;
	}
	return c;
}

let xr = X.routing?.rules ?? [];
for (let ri, r in xr) {
	let tags = arr(r.inboundTag);
	if (length(tags) == 1 && (tags[0] == 'api-in' || tags[0] == 'dns-in'))
		continue;
	if (length(tags) && length(filter(tags, (t) => match(t, /^dns-/)))) {
		for (let t in tags)
			dns_via[t] = target(r.outboundTag);
		continue;
	}

	let base = {};
	if (length(tags))
		base.inbound = tags;
	let nw = r.network;
	if (nw == 'tcp' || nw == 'udp')
		base.network = nw;
	if (r.protocol)
		base.protocol = arr(r.protocol);
	if (r.source)
		base.source_ip_cidr = arr(r.source);
	if (r.port) {
		let ports = [], ranges = [];
		for (let p in split(`${r.port}`, ',')) {
			if (match(p, /[-:]/))
				push(ranges, replace(p, '-', ':'));
			else if (p != '')
				push(ports, int(p));
		}
		if (length(ports))
			base.port = ports;
		if (length(ranges))
			base.port_range = ranges;
	}

	let to = target(r.outboundTag);
	let groups = [];
	if (r.domain)
		groups = name_groups(split_names(r.domain));
	if (r.ip)
		groups = [ ...groups, ...ip_groups(r.ip) ];

	// The last rule says where everything else goes: that is not a rule here,
	// it is `final` - or, for a blackhole, a rule that drops what is left.
	if (ri == length(xr) - 1 && !r.domain && !r.ip && !r.protocol && !r.port && !r.source && !length(tags) && !r.invert) {
		if (to == 'block')
			push(rules, with_action({}, 'block'));
		else
			final_out = to;
		continue;
	}

	// A list that had only entries which could not be kept is not a rule that
	// matches everything.
	if ((r.domain || r.ip) && !length(groups))
		continue;

	// PassWall2's invert, written by zgz-mkconfig only for sing-box: the whole
	// rule, names and addresses together, the other way round - one logical
	// rule when there is more than one kind of thing to match.
	if (r.invert) {
		if (!length(groups))
			push(rules, with_action({ ...base, invert: true }, to));
		else if (length(groups) == 1)
			push(rules, with_action({ ...base, ...groups[0], invert: true }, to));
		else
			push(rules, with_action({ type: 'logical', mode: 'or',
				rules: map(groups, (g) => ({ ...base, ...g })), invert: true }, to));
		continue;
	}

	if (!length(groups)) {
		push(rules, with_action({ ...base }, to));
	} else {
		for (let g in groups)
			push(rules, with_action({ ...base, ...g }, to));
	}
}

// -------------------------------------------------------------------- DNS

let QS = { UseIPv4: 'ipv4_only', UseIPv6: 'ipv6_only', UseIP: null };

function dns_server(sv) {
	let a = sv.address;
	let m, o;
	if (a == 'fakedns') {
		warn('FakeDNS is built differently in sing-box and is not carried over');
		return null;
	}
	if ((m = match(a, /^tcp:\/\/([^:\/]+)(:([0-9]+))?$/))) {
		o = { type: 'tcp', server: m[1] };
		if (m[3])
			o.server_port = int(m[3]);
	} else if ((m = match(a, /^https:\/\/([^:\/]+)(:([0-9]+))?(\/.*)?$/))) {
		o = { type: 'https', server: m[1] };
		if (m[3])
			o.server_port = int(m[3]);
		if (m[4])
			o.path = m[4];
	} else if ((m = match(a, /^(tls|quic):\/\/([^:\/]+)(:([0-9]+))?$/))) {
		o = { type: m[1], server: m[2] };
		if (m[4])
			o.server_port = int(m[4]);
	} else {
		o = { type: 'udp', server: a };
		if (sv.port && sv.port != 53)
			o.server_port = sv.port;
	}
	// A measuring configuration's one resolver has no tag of its own.
	o.tag = sv.tag ?? (args.mode == 'test' ? 'dns-test' : null);
	let via = dns_via[sv.tag];
	if (via && via != 'direct' && via != 'block')
		o.detour = via;
	return o;
}

let dns = { servers: [], rules: [] };
let dns_final = null;
let have_direct_dns = false;

let hosts = X.dns?.hosts ?? {};
if (length(keys(hosts))) {
	let pre = {};
	for (let k, v in hosts)
		pre[k] = arr(v);
	push(dns.servers, { type: 'hosts', tag: 'dns-hosts', predefined: pre });
	push(dns.rules, { domain: keys(hosts), action: 'route', server: 'dns-hosts' });
}

for (let sv in X.dns?.servers ?? []) {
	let s = dns_server(sv);
	if (!s)
		continue;
	push(dns.servers, s);
	let qs = QS[sv.queryStrategy];
	if (sv.domains) {
		if (sv.tag == 'dns-direct')
			have_direct_dns = true;
		for (let g in name_groups(split_names(sv.domains))) {
			push(dns.rules, { ...g, action: 'route', server: sv.tag });
		}
	} else {
		dns_final = s.tag;
		if (qs)
			dns.strategy = qs;
	}
}
if (dns_final)
	dns.final = dns_final;
if (X.dns?.disableCache)
	dns.disable_cache = true;

// -------------------------------------------------------------- the config

let level = { debug: 'debug', info: 'info', warning: 'warn', error: 'error' }[args.level ?? 'warning'];

// A measuring configuration has no node called proxy; what no rule sends
// anywhere - nothing, there - leaves directly.
if (args.mode == 'test')
	final_out = 'direct';

let route = {
	rules,
	final: final_out,
	default_mark: MARK
};
if (length(keys(rule_sets)) || length(keys(user_sets)))
	route.rule_set = [
		...map(keys(rule_sets), (t) => ({ tag: t, type: 'local', format: 'binary', path: rule_sets[t] })),
		...map(keys(user_sets), (t) => user_sets[t])
	];
// The resolver a node's own name is looked up with: the direct one, or in a
// measurement the one resolver it has, which is the direct resolver too.
let node_dns = have_direct_dns ? 'dns-direct' : (args.mode == 'test' ? dns_final : null);
for (let o in [ ...outbounds ]) {
	if (o._strategy && node_dns)
		o.domain_resolver = { server: node_dns, strategy: o._strategy };
	delete o._strategy;
}
if (have_direct_dns) {
	route.default_domain_resolver = { server: 'dns-direct', strategy: 'ipv4_only' };
} else if (node_dns) {
	route.default_domain_resolver = { server: node_dns };
	if (QS[X.dns?.queryStrategy])
		route.default_domain_resolver.strategy = QS[X.dns.queryStrategy];
}

let cfg = {
	log: level ? { level, timestamp: true } : { disabled: true },
	dns,
	inbounds,
	outbounds: [ ...outbounds, { type: 'direct', tag: 'direct', routing_mark: MARK } ],
	route
};
if (args.mode != 'test')
	cfg.experimental = { clash_api: { external_controller: `127.0.0.1:${args.api ?? 10853}` } };
if (length(endpoints))
	cfg.endpoints = endpoints;

// A node is dialled by its own name only through the direct resolver, and
// the 'direct' tag must exist once even when the node list never named it.
let seen = {};
cfg.outbounds = filter(cfg.outbounds, (o) => {
	if (seen[o.tag])
		return false;
	seen[o.tag] = true;
	return true;
});

print(sprintf('%.J', cfg), '\n');
