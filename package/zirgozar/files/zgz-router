#
# zgz-router - the two things this program changes on the router itself
# rather than on the tunnel.
#
#   zgz-router rebind   bring dnsmasq's rebind exceptions in step with the
#                          list on the Traffic Rules page
#   zgz-router clock    point the router's clock at Iranian time servers
#                          and Tehran time; exits 2 when that was already so
#
# Neither depends on the tunnel. A bank that dnsmasq refuses to resolve is
# refused whether or not anything is connected, and a clock that is wrong
# breaks every TLS handshake the router makes - the tunnel's among them.

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

DNSMASQ='dhcp.@dnsmasq[0]'
# What this program added, as opposed to what was there before it. Only these
# are ever taken out again: an exception the reader made by hand is theirs.
APPLIED="$ZGZ_ETC/rebind.applied"

NTP_SERVERS="ntp.day.ir ntp.faraborddi.com ntp.time.ir"
TZ_VALUE='<+0330>-3:30'
TZ_NAME='Asia/Tehran'

in_list() {
	case " $2 " in
		*" $1 "*) return 0 ;;
	esac
	return 1
}

cmd_rebind() {
	_want="$(uci -q get zirgozar.config.rebind_domain 2>/dev/null)" || _want=""
	_have="$(uci -q get "$DNSMASQ.rebind_domain" 2>/dev/null)" || _have=""
	_ours="$(cat "$APPLIED" 2>/dev/null | tr '\n' ' ')"
	_changed=0
	_keep=""

	# Taken off the list here, and put there by us: take it out of dnsmasq.
	for _d in $_ours; do
		if in_list "$_d" "$_want"; then
			_keep="$_keep $_d"
		elif in_list "$_d" "$_have"; then
			uci -q del_list "$DNSMASQ.rebind_domain=$_d" || true
			_changed=1
		fi
	done

	for _d in $_want; do
		if ! in_list "$_d" "$_have"; then
			uci -q add_list "$DNSMASQ.rebind_domain=$_d"
			_changed=1
			in_list "$_d" "$_keep" || _keep="$_keep $_d"
		fi
	done

	printf '%s\n' $_keep > "$APPLIED.new" 2>/dev/null || true
	mv -f "$APPLIED.new" "$APPLIED" 2>/dev/null || true

	if [ "$_changed" = "1" ]; then
		uci -q commit dhcp
		bounded 30 /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
		log "rebind exceptions updated: $(echo $_want)"
	fi
	return 0
}

cmd_clock() {
	uci -q get system.ntp >/dev/null 2>&1 || uci -q set system.ntp=timeserver

	_have="$(uci -q get system.ntp.server 2>/dev/null)" || _have=""
	_missing=""
	for _s in $NTP_SERVERS; do
		in_list "$_s" "$_have" || _missing="$_missing $_s"
	done

	if [ -z "$_missing" ] &&
	   [ "$(uci -q get 'system.@system[0].timezone')" = "$TZ_VALUE" ] &&
	   [ "$(uci -q get 'system.@system[0].zonename')" = "$TZ_NAME" ]; then
		echo "already"
		return 2
	fi

	for _s in $_missing; do
		uci -q add_list "system.ntp.server=$_s"
	done
	uci -q set "system.@system[0].timezone=$TZ_VALUE"
	uci -q set "system.@system[0].zonename=$TZ_NAME"
	uci -q commit system
	# The timezone reaches the running system through /etc/TZ, which the
	# system service writes when it reloads.
	bounded 20 /etc/init.d/system reload >/dev/null 2>&1 || true
	bounded 20 /etc/init.d/sysntpd restart >/dev/null 2>&1 || true
	log "router clock set to Tehran time with the Iranian time servers"
	echo "done"
	return 0
}

# PassWall2's Delay Settings: stop, start and restart on a schedule.
#
#   zgz-router schedule sync      bring the crontab in step with the settings
#   zgz-router schedule stop      what the crontab runs
#   zgz-router schedule start
#   zgz-router schedule restart
#
# A scheduled stop is written down, because the quarter-hourly repair would
# otherwise see a tunnel that is meant to be up and is not, and bring it back
# within fifteen minutes of being stopped. A scheduled start, or the main
# switch, clears it. As in PassWall2, the schedule only exists while the main
# switch is on.
SCHEDULE_STOPPED="$ZGZ_RUN/schedule.stopped"
CRONTAB="${ZGZ_CRONTAB:-/etc/crontabs/root}"

cmd_schedule_sync() {
	[ -f "$CRONTAB" ] || touch "$CRONTAB" 2>/dev/null || return 0
	grep -v 'zgz-router schedule' "$CRONTAB" > "$CRONTAB.zgz" 2>/dev/null || true
	if [ "$(cfg_bool enabled 0)" = "1" ]; then
		if [ "$(cfg_bool start_daemon 1)" = "1" ]; then
			_hi="$(cfg health_interval 3)"
			case "$_hi" in 1|2|3|5|10|15|30) : ;; *) _hi=3 ;; esac
			echo "*/$_hi * * * * $ZGZ_LIB/zgz-router schedule health >/dev/null 2>&1" >> "$CRONTAB.zgz"
		fi
		for _w in stop start restart; do
			_week="$(cfg "${_w}_week_mode" '')"
			[ -n "$_week" ] || continue
			if [ "$_w" = "restart" ] && [ "$_week" = "8" ]; then
				_h="$(cfg restart_interval_mode 2)"
				case "$_h" in ''|*[!0-9]*) _h=2 ;; esac
				echo "0 */$_h * * * $ZGZ_LIB/zgz-router schedule $_w >/dev/null 2>&1" >> "$CRONTAB.zgz"
				continue
			fi
			_t="$(cfg "${_w}_time_mode" '0:00')"
			_hh="${_t%%:*}"; _mm="${_t#*:}"
			case "$_hh" in ''|*[!0-9]*) _hh=0 ;; esac
			case "$_mm" in ''|*[!0-9]*) _mm=0 ;; esac
			_dow="$_week"
			[ "$_week" = "7" ] && _dow='*'
			echo "$((_mm + 0)) $((_hh + 0)) * * $_dow $ZGZ_LIB/zgz-router schedule $_w >/dev/null 2>&1" >> "$CRONTAB.zgz"
		done
	fi
	# Rule Manage's automatic update of the routing data, as PassWall2 has
	# it: every day, one day of the week, or every so many hours. Whatever
	# the main switch says - the files are there for when it is turned on.
	_week="$(cfg geo_update_week_mode '')"
	if [ -n "$_week" ]; then
		if [ "$_week" = "8" ]; then
			_h="$(cfg geo_update_interval_mode 2)"
			case "$_h" in ''|*[!0-9]*) _h=2 ;; esac
			echo "0 */$_h * * * $ZGZ_LIB/zgz-router schedule geo >/dev/null 2>&1" >> "$CRONTAB.zgz"
		else
			_t="$(cfg geo_update_time_mode '0:00')"
			_hh="${_t%%:*}"; _mm="${_t#*:}"
			case "$_hh" in ''|*[!0-9]*) _hh=0 ;; esac
			case "$_mm" in ''|*[!0-9]*) _mm=0 ;; esac
			_dow="$_week"
			[ "$_week" = "7" ] && _dow='*'
			echo "$((_mm + 0)) $((_hh + 0)) * * $_dow $ZGZ_LIB/zgz-router schedule geo >/dev/null 2>&1" >> "$CRONTAB.zgz"
		fi
	fi
	# Node Subscribe's schedule for each subscription, as PassWall2 has it.
	# Quarter-hourly subscriptions have separate entries so their downloads
	# can be staggered without delaying the tunnel health check.
	for _s in $(uci -q -X show zirgozar 2>/dev/null |
	            sed -n "s/^zirgozar\.\([A-Za-z0-9_]*\)=subscription\$/\1/p"); do
		[ "$(uci -q get "zirgozar.$_s.enabled")" = "0" ] && continue
		_week="$(uci -q get "zirgozar.$_s.update_week_mode")" || _week=""
		case "$_week" in
			refresh)
				_offset="$(uci -q get "zirgozar.$_s.update_minute_offset")" || _offset=0
				case "$_offset" in ''|*[!0-9]*) _offset=0 ;; esac
				_offset="$(printf '%s' "$_offset" | sed 's/^0*//')"
				[ -n "$_offset" ] || _offset=0
				[ "$_offset" -lt 15 ] || _offset=0
				echo "$_offset,$((_offset + 15)),$((_offset + 30)),$((_offset + 45)) * * * * $ZGZ_LIB/zgz-router schedule sub $_s >/dev/null 2>&1" >> "$CRONTAB.zgz"
				;;
			8)
				_h="$(uci -q get "zirgozar.$_s.update_interval_mode")" || _h=2
				case "$_h" in ''|*[!0-9]*) _h=2 ;; esac
				echo "0 */$_h * * * $ZGZ_LIB/zgz-router schedule sub $_s >/dev/null 2>&1" >> "$CRONTAB.zgz"
				;;
			[0-7])
				_t="$(uci -q get "zirgozar.$_s.update_time_mode")" || _t="0:00"
				_hh="${_t%%:*}"; _mm="${_t#*:}"
				case "$_hh" in ''|*[!0-9]*) _hh=0 ;; esac
				case "$_mm" in ''|*[!0-9]*) _mm=0 ;; esac
				_dow="$_week"
				[ "$_week" = "7" ] && _dow='*'
				echo "$((_mm + 0)) $((_hh + 0)) * * $_dow $ZGZ_LIB/zgz-router schedule sub $_s >/dev/null 2>&1" >> "$CRONTAB.zgz"
				;;
		esac
	done
	if cmp -s "$CRONTAB.zgz" "$CRONTAB"; then
		rm -f "$CRONTAB.zgz"
		return 0
	fi
	mv -f "$CRONTAB.zgz" "$CRONTAB"
	bounded 15 /etc/init.d/cron reload >/dev/null 2>&1 || true
	log "schedule updated"
	return 0
}

cmd_schedule() {
	case "${1:-}" in
		health)
			"$ZGZ_LIB/zgz-refresh" health
			;;
		sync)
			cmd_schedule_sync
			;;
		stop)
			touch "$SCHEDULE_STOPPED" 2>/dev/null || true
			log "Scheduled stop"
			bounded 60 /etc/init.d/zirgozar stop >/dev/null 2>&1 || true
			;;
		start)
			rm -f "$SCHEDULE_STOPPED"
			log "Scheduled start"
			bounded 180 /etc/init.d/zirgozar start >/dev/null 2>&1 || true
			;;
		restart)
			rm -f "$SCHEDULE_STOPPED"
			log "Scheduled restart"
			bounded 180 /etc/init.d/zirgozar restart >/dev/null 2>&1 || true
			;;
		geo)
			# The files ticked on Rule Manage, and a restart when the tunnel
			# is running, so that it reads them - as PassWall2 does.
			_ip="$(cfg_bool geoip_update 1)"; _site="$(cfg_bool geosite_update 1)"
			if [ "$_ip" = "1" ] && [ "$_site" = "1" ]; then
				_which=all
			elif [ "$_ip" = "1" ]; then
				_which=geoip
			elif [ "$_site" = "1" ]; then
				_which=geosite
			else
				return 0
			fi
			log "Scheduled update of the routing data ($_which)"
			if "$ZGZ_LIB/zgz-geo" update "$_which" >/dev/null 2>&1; then
				if [ "$(cfg_bool enabled 0)" = "1" ] && tunnel_running; then
					bounded 180 /etc/init.d/zirgozar restart >/dev/null 2>&1 || true
				fi
			fi
			;;
		sub)
			# One subscription, read on its own schedule, and the list
			# rebuilt from it. Not while only nodes added by hand are used.
			case "${2:-}" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
			[ "$(uci -q get "zirgozar.$2")" = "subscription" ] || return 0
			[ "$(uci -q get "zirgozar.$2.enabled")" != "0" ] || return 0
			if [ "$(cfg sources own)" = "own" ]; then
				return 0
			fi
			log "Scheduled update of subscription $2"
			"$ZGZ_LIB/zgz-nodes" update "$2" >/dev/null 2>&1 || true
			;;
		*) echo "usage: $0 schedule sync|stop|start|restart|geo|sub <section>" >&2; return 1 ;;
	esac
	return 0
}

# Back to the settings the package was installed with - the Restore defaults
# switch in Basic Settings. Every node and subscription goes, and with them
# what was read, chosen and measured. The routing data, the downloaded cores
# and the traffic history stay: they are downloads and a record, not
# settings, and fetching twenty-five megabytes again helps nobody.
DEFAULT_CONFIG=/usr/share/zirgozar/zirgozar.config

cmd_reset() {
	if [ ! -s "$DEFAULT_CONFIG" ]; then
		warn "reset: the settings the package was installed with are not on this router"
		uci -q delete zirgozar.config.factory_reset
		uci -q commit zirgozar
		return 1
	fi
	log "Back to the settings the program was installed with"
	cp -f "$DEFAULT_CONFIG" /etc/config/zirgozar
	rm -rf "$ZGZ_ETC/best.json" "$ZGZ_ETC/best.meta" "$ZGZ_ETC/bridge.json" \
	       "$ZGZ_ETC/nodes.cache" "$ZGZ_ETC/subs" "$ZGZ_ETC/warp"
	if [ -n "$ZGZ_RUN" ] && [ -d "$ZGZ_RUN" ]; then
		rm -rf "$ZGZ_RUN"/*.tsv "$ZGZ_RUN/tests" "$ZGZ_RUN/message" \
		       "$ZGZ_RUN/attempts" "$ZGZ_RUN/rejected" "$ZGZ_RUN/progress"
	fi
	# What follows from the settings, brought into line with the new ones.
	cmd_rebind || true
	cmd_schedule sync || true
	return 0
}

# Once, on a router set up before the remote DNS default became Google:
# Cloudflare's 1.1.1.1, written in as the old default, moves to 8.8.8.8, and
# the DoH address with it. Through a node built on Cloudflare Workers -
# patterniha's list is all of them - 1.1.1.1 cannot be reached, so every
# lookup failed while the node itself measured fine and nothing opened. A
# resolver chosen by hand is left as it is; so is 1.1.1.1 after this has run.
cmd_dnsmove() {
	[ "$(cfg dns_moved 0)" = "1" ] && return 0
	command -v uci >/dev/null 2>&1 || return 0
	if [ "$(uci -q get zirgozar.config.remote_dns)" = "1.1.1.1" ]; then
		uci -q set zirgozar.config.remote_dns='8.8.8.8'
		log "Remote DNS moved from 1.1.1.1 to 8.8.8.8, which nodes on Cloudflare Workers can reach"
	fi
	if [ "$(uci -q get zirgozar.config.remote_dns_doh)" = "https://1.1.1.1/dns-query" ]; then
		uci -q set zirgozar.config.remote_dns_doh='https://8.8.8.8/dns-query'
	fi
	uci -q set zirgozar.config.dns_moved='1'
	uci -q commit zirgozar
	return 0
}

# Once: QUIC from off, which was the default, to automatic - refused while the
# node in use is one through a CDN, as PattN refuses it. Turned on by hand is
# left on.
cmd_quicmove() {
	[ "$(cfg quic_moved 0)" = "1" ] && return 0
	command -v uci >/dev/null 2>&1 || return 0
	case "$(uci -q get zirgozar.config.block_quic)" in
		''|0) uci -q set zirgozar.config.block_quic='auto' ;;
	esac
	uci -q set zirgozar.config.quic_moved='1'
	uci -q commit zirgozar
	return 0
}

# Once: TCP Proxy Way from TPROXY, the old default, to REDIRECT, PassWall2's -
# under TPROXY Supercell's games lost their connection while loading, and
# under REDIRECT they did not. Chosen again by hand afterwards is left alone.
cmd_tcpmove() {
	[ "$(cfg tcp_moved 0)" = "1" ] && return 0
	command -v uci >/dev/null 2>&1 || return 0
	case "$(uci -q get zirgozar.config.tcp_proxy_way)" in
		''|tproxy) uci -q set zirgozar.config.tcp_proxy_way='redirect' ;;
	esac
	uci -q set zirgozar.config.tcp_moved='1'
	uci -q commit zirgozar
	return 0
}

# PassWall2's Backup and Restore: the settings of both sides - every config,
# subscription, rule and setting, the shunt rules among them, is in the two
# files under /etc/config - the WARP and Aether accounts, which cannot be made
# again with the same keys, and the routing data, so that a router restored
# from it routes as before without waiting for a download. Only what is
# fetched again on its own is left out: the cores, Psiphon's server lists,
# what the subscriptions last brought and the traffic history.
#
# The archive is handed to and taken from the browser by LuCI's own file
# transfer, at these two addresses and nowhere else. Both are in memory, so
# what an archive needs there is counted before it is made or unpacked.
#
# A plain tar and not a packed one: the routing data is most of it, and
# busybox's gzip takes most of half a minute over it on a router - longer
# than the page waits for an answer. A backup made by an earlier version is
# packed, and is read as one.
BACKUP_OUT="${ZGZ_BACKUP_OUT:-/tmp/zirgozar-backup.tar}"
RESTORE_IN="${ZGZ_RESTORE_IN:-/tmp/zirgozar-restore}"
UCI_DIR="${ZGZ_UCI_DIR:-/etc/config}"
BACKUP_MARK=zirgozar-backup

# The routing data: the plain files in the folder, by safe names only.
backup_geo_files() {
	_gd="$(cfg geo_dir "$ZGZ_ETC/geo")"
	[ -d "$_gd" ] || return 0
	for _f in "$_gd"/*; do
		[ -f "$_f" ] && [ ! -L "$_f" ] || continue
		case "${_f##*/}" in *[!A-Za-z0-9_.-]*|.*) continue ;; esac
		echo "$_f"
	done
	return 0
}

cmd_backup() {
	_geo="$(backup_geo_files)"
	# Twice the data, once copied and once in the archive, and room to spare.
	_kb=0
	[ -z "$_geo" ] || _kb="$(du -ck $_geo 2>/dev/null | awk 'END { print $1 + 0 }')"
	_tmp="$(dirname "$BACKUP_OUT")"
	_need=$(( _kb * 2048 + ZGZ_SPACE_MARGIN ))
	_free="$(free_bytes "$_tmp")"
	if [ "$_free" -lt "$_need" ]; then
		echo "Not enough free memory for the backup file: needs $(human_size "$_need"), $(human_size "$_free") free."
		return 1
	fi
	_d="$(mktemp -d "$_tmp/zgz-backup.XXXXXX")" || return 1
	mkdir -p "$_d/etc/config" "$_d/etc/zirgozar"
	printf '%s\nversion %s\ndate %s\n' "$BACKUP_MARK" "$(zgz_version)" "$(date '+%Y-%m-%d %H:%M')" > "$_d/$BACKUP_MARK"
	for _f in zirgozar zirgozar_server; do
		if [ -f "$UCI_DIR/$_f" ]; then cp -p "$UCI_DIR/$_f" "$_d/etc/config/$_f"; fi
	done
	if [ -d "$ZGZ_ETC/warp" ]; then cp -pR "$ZGZ_ETC/warp" "$_d/etc/zirgozar/warp"; fi
	# Aether's keys, and not what Psiphon keeps beside them.
	for _k in "$ZGZ_ETC"/aether/*/identity*.toml; do
		[ -f "$_k" ] && [ ! -L "$_k" ] || continue
		_id="${_k%/*}"; _id="${_id##*/}"
		case "$_id" in ''|*[!A-Za-z0-9_]*) continue ;; esac
		case "${_k##*/}" in *[!A-Za-z0-9_.-]*) continue ;; esac
		mkdir -p "$_d/etc/zirgozar/aether/$_id"
		cp -p "$_k" "$_d/etc/zirgozar/aether/$_id/"
	done
	_parts="$BACKUP_MARK etc"
	if [ -n "$_geo" ]; then
		mkdir -p "$_d/geo"
		for _f in $_geo; do cp -p "$_f" "$_d/geo/"; done
		_parts="$_parts geo"
	fi
	rm -f "$BACKUP_OUT"
	_rc=0
	( cd "$_d" && tar -cf "$BACKUP_OUT" $_parts ) 2>/dev/null || _rc=1
	rm -rf "$_d"
	if [ "$_rc" != 0 ] || [ ! -s "$BACKUP_OUT" ]; then
		rm -f "$BACKUP_OUT"
		echo "The backup file could not be made."
		return 1
	fi
	chmod 0600 "$BACKUP_OUT"
	log "Backup made"
	return 0
}

# Only an archive this program made, holding only the files it puts in one -
# looked at before anything is unpacked, so nothing else on the router can be
# written by a file someone was handed.
cmd_restore() {
	_in="$RESTORE_IN"
	if [ ! -s "$_in" ]; then
		echo "No backup file was received."
		return 1
	fi
	_z=""
	if gzip -t "$_in" 2>/dev/null; then _z=z; fi
	_list="$(tar -tv${_z}f "$_in" 2>/dev/null)" || _list=""
	if [ -z "$_list" ]; then
		rm -f "$_in"
		echo "This is not a Zirgozar backup file."
		return 1
	fi
	# Plain files and folders only, at the paths a backup has.
	_bad="$(printf '%s\n' "$_list" | awk '
		{ t = substr($1, 1, 1); n = $NF; sub(/^\.\//, "", n); sub(/\/$/, "", n) }
		t != "-" && t != "d" { print; next }
		n ~ /\.\./ { print; next }
		n == "" || n == "'"$BACKUP_MARK"'" || n == "etc" || n == "etc/config" || n == "etc/zirgozar" || n == "etc/zirgozar/warp" { next }
		n == "etc/config/zirgozar" || n == "etc/config/zirgozar_server" { next }
		n ~ /^etc\/zirgozar\/warp(\/[A-Za-z0-9_.-]+)+$/ { next }
		n == "etc/zirgozar/aether" || n ~ /^etc\/zirgozar\/aether\/[A-Za-z0-9_]+$/ { next }
		n ~ /^etc\/zirgozar\/aether\/[A-Za-z0-9_]+\/identity[A-Za-z0-9_.-]*\.toml$/ { next }
		n == "geo" || n ~ /^geo\/[A-Za-z0-9_-][A-Za-z0-9_.-]*$/ { next }
		{ print }')"
	if [ -n "$_bad" ]; then
		rm -f "$_in"
		echo "This is not a Zirgozar backup file."
		return 1
	fi
	# Unpacked in memory beside the file itself.
	_size="$(printf '%s\n' "$_list" | awk '$3 ~ /^[0-9]+$/ { s += $3 } END { print s + 0 }')"
	_need=$(( _size + ZGZ_SPACE_MARGIN ))
	_free="$(free_bytes "$(dirname "$_in")")"
	if [ "$_free" -lt "$_need" ]; then
		rm -f "$_in"
		echo "Not enough free memory to open the backup file: needs $(human_size "$_need"), $(human_size "$_free") free."
		return 1
	fi
	_d="$(mktemp -d "$(dirname "$_in")/zgz-restore.XXXXXX")" || return 1
	if ! tar -x${_z}f "$_in" -C "$_d" 2>/dev/null || [ "$(head -n 1 "$_d/$BACKUP_MARK" 2>/dev/null)" != "$BACKUP_MARK" ] ||
	   [ ! -s "$_d/etc/config/zirgozar" ]; then
		rm -rf "$_d" "$_in"
		echo "This is not a Zirgozar backup file."
		return 1
	fi
	rm -f "$_in"
	if ! uci -q -c "$_d/etc/config" show zirgozar >/dev/null 2>&1; then
		rm -rf "$_d"
		echo "The settings in this backup file are damaged."
		return 1
	fi

	log "Restoring the backup of $(sed -n 's/^date //p' "$_d/$BACKUP_MARK") (version $(sed -n 's/^version //p' "$_d/$BACKUP_MARK"))"
	# Anything changed on the pages and not yet applied belongs to the
	# settings being replaced.
	uci -q revert zirgozar || true
	uci -q revert zirgozar_server || true
	cp -f "$_d/etc/config/zirgozar" "$UCI_DIR/zirgozar"
	if [ -f "$_d/etc/config/zirgozar_server" ]; then cp -f "$_d/etc/config/zirgozar_server" "$UCI_DIR/zirgozar_server"; fi
	if [ -d "$_d/etc/zirgozar/warp" ]; then
		rm -rf "$ZGZ_ETC/warp"
		cp -pR "$_d/etc/zirgozar/warp" "$ZGZ_ETC/warp"
	fi
	if [ -d "$_d/etc/zirgozar/aether" ]; then
		for _a in "$_d"/etc/zirgozar/aether/*; do
			[ -d "$_a" ] || continue
			mkdir -p "$ZGZ_ETC/aether/${_a##*/}"
			cp -p "$_a"/* "$ZGZ_ETC/aether/${_a##*/}/" 2>/dev/null || true
		done
	fi
	# The routing data goes where the restored settings keep it, one file
	# at a time and only where it fits: a full overlay is worse than a
	# download.
	if [ -d "$_d/geo" ]; then
		_gd="$(cfg geo_dir "$ZGZ_ETC/geo")"
		mkdir -p "$_gd" 2>/dev/null || true
		for _f in "$_d"/geo/*; do
			[ -f "$_f" ] || continue
			_t="$_gd/${_f##*/}"
			_new="$(wc -c < "$_f")"
			_old=0
			[ ! -f "$_t" ] || _old="$(wc -c < "$_t")"
			if [ "$(( $(free_bytes "$_gd") + _old ))" -lt "$(( _new + ZGZ_SPACE_MARGIN ))" ]; then
				warn "backup: no room for ${_f##*/} in $_gd, left as it was"
				continue
			fi
			rm -f "$_t"
			cp -p "$_f" "$_t" || rm -f "$_t"
		done
	fi
	rm -rf "$_d"
	if uci -q delete zirgozar.config.factory_reset; then uci -q commit zirgozar || true; fi
	# The node in use and what was measured belong to the old settings.
	rm -f "$ZGZ_ETC/best.json" "$ZGZ_ETC/best.meta" "$ZGZ_ETC/bridge.json" "$ZGZ_ETC/nodes.cache"
	if [ -n "$ZGZ_RUN" ] && [ -d "$ZGZ_RUN" ]; then
		rm -rf "$ZGZ_RUN"/*.tsv "$ZGZ_RUN/tests" "$ZGZ_RUN/message" \
		       "$ZGZ_RUN/attempts" "$ZGZ_RUN/rejected" "$ZGZ_RUN/progress"
	fi
	cmd_rebind || true
	cmd_schedule sync || true
	return 0
}

case "${1:-}" in
	reset)    cmd_reset ;;
	backup)   cmd_backup ;;
	restore)  cmd_restore ;;
	rebind)   cmd_rebind ;;
	dnsmove)  cmd_dnsmove ;;
	quicmove) cmd_quicmove ;;
	tcpmove)  cmd_tcpmove ;;
	clock)    cmd_clock ;;
	schedule) cmd_schedule "${2:-}" "${3:-}" ;;
	*) echo "usage: $0 reset|backup|restore|rebind|dnsmove|quicmove|tcpmove|clock|schedule sync|stop|start|restart|geo|sub <section>" >&2; exit 1 ;;
esac
