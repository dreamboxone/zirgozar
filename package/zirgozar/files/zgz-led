set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"
LED_ROOT="${ZGZ_LED_ROOT:-/sys/class/leds}"
SAVE="$ZGZ_RUN/led-saved"

# Only combine channels belonging to the same RGB indicator. Unrelated
# single-colour power, Ethernet and storage LEDs must never be repurposed.
detect() {
	RED= GREEN= BLUE= GROUP= BLINK=0
	for d in "$LED_ROOT"/*; do
		[ -d "$d" ] || continue
		n="${d##*/}"
		lower="$(printf '%s' "$n" | tr 'A-Z' 'a-z')"
		case "$lower" in
			*:red|*_red|*-red) prefix="${lower%red}"; green_name="${prefix}green"; blue_name="${prefix}blue"; group="${prefix}rgb" ;;
			red:*) suffix="${lower#red}"; green_name="green${suffix}"; blue_name="blue${suffix}"; group="rgb${suffix}" ;;
			*:red:*) prefix="${lower%%:red:*}"; suffix="${lower#*:red:}"; green_name="$prefix:green:$suffix"; blue_name="$prefix:blue:$suffix"; group="$prefix:rgb:$suffix" ;;
			*) continue ;;
		esac
		r="$d"; g=; b=
		for candidate in "$LED_ROOT"/*; do
			name="$(printf '%s' "${candidate##*/}" | tr 'A-Z' 'a-z')"
			case "$name" in "$green_name") g="$candidate" ;; "$blue_name") b="$candidate" ;; esac
		done
		[ -n "$g" ] && [ -n "$b" ] || continue
		valid=1; blink=1
		for c in "$r" "$g" "$b"; do
			[ -w "$c/brightness" ] && [ -w "$c/trigger" ] && [ -r "$c/max_brightness" ] || valid=0
			grep -qw timer "$c/trigger" 2>/dev/null || blink=0
		done
		[ "$valid" = 1 ] || continue
		[ "$(cat "$r/max_brightness")" -gt 1 ] && [ "$(cat "$g/max_brightness")" -gt 1 ] || continue
		RED="$r"; GREEN="$g"; BLUE="$b"; GROUP="$group"; BLINK="$blink"
		return 0
	done
	return 1
}

status() {
	local outage=false
	[ "$(cfg_bool led_outage_enabled 0)" != 1 ] || outage=true
	if detect; then
		printf '{"supported":true,"blink":%s,"indicator":"%s","outage_enabled":%s}\n' "$([ "$BLINK" = 1 ] && echo true || echo false)" "$(json_escape "$GROUP")" "$outage"
	else
		printf '{"supported":false,"blink":false,"outage_enabled":%s}\n' "$outage"
	fi
}

snapshot() {
	[ -d "$SAVE" ] && return 0
	mkdir -p "$SAVE.new" || return 1
	for channel in "$RED" "$GREEN" "$BLUE"; do
		name="${channel##*/}"
		mkdir -p "$SAVE.new/$name" || return 1
		cat "$channel/brightness" > "$SAVE.new/$name/brightness"
		sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$channel/trigger" > "$SAVE.new/$name/trigger"
		for attr in delay_on delay_off; do
			[ ! -f "$channel/$attr" ] || cat "$channel/$attr" > "$SAVE.new/$name/$attr"
		done
	done
	mv "$SAVE.new" "$SAVE"
}

restore() {
	[ -d "$SAVE" ] || return 0
	for saved in "$SAVE"/*; do
		[ -d "$saved" ] || continue
		channel="$LED_ROOT/${saved##*/}"
		[ -w "$channel/trigger" ] || continue
		echo none > "$channel/trigger"
		cat "$saved/brightness" > "$channel/brightness"
		trigger="$(cat "$saved/trigger")"
		[ -z "$trigger" ] || printf '%s\n' "$trigger" > "$channel/trigger"
		for attr in delay_on delay_off; do
			[ ! -f "$saved/$attr" ] || cat "$saved/$attr" > "$channel/$attr"
		done
	done
	if [ "$LED_ROOT" = /sys/class/leds ] && [ -x /etc/init.d/led ]; then
		/etc/init.d/led reload >/dev/null 2>&1 || true
	fi
	rm -f "$SAVE"/*/brightness "$SAVE"/*/trigger "$SAVE"/*/delay_on "$SAVE"/*/delay_off
	rmdir "$SAVE"/* "$SAVE" 2>/dev/null || true
}

rule_for_ping() {
	case "$1" in ''|*[!0-9]*) echo 'red:steady:0'; return ;; esac
	printf '%s\n' "$RULES" | awk -v ping="$1" '
	{
		for (i = 1; i <= NF; i++) {
			if (split($i, rule, ":") != 5) continue
			if (rule[1] !~ /^[0-9]+$/ || rule[2] !~ /^[0-9]+$/ ||
			    rule[1] + 0 < 1 || rule[2] + 0 > 60000 ||
			    ping + 0 < rule[1] + 0 || ping + 0 > rule[2] + 0) continue
			if (rule[3] !~ /^(red|green|blue|yellow|orange|white)$/) continue
			if (rule[4] == "blink") {
				if (rule[5] !~ /^[0-9]+$/ || rule[5] + 0 < 1 || rule[5] + 0 > 600) continue
			} else if (rule[4] != "steady" || rule[5] != "0") continue
			matches++
			selected = rule[3] ":" rule[4] ":" (rule[5] + 0)
		}
	}
	END { print matches == 1 ? selected : "red:steady:0" }'
}

apply_colour() {
	local shade rmax gmax bmax rv gv bv channel brightness rate period on
	shade="$1"
	rmax="$(cat "$RED/max_brightness")"; gmax="$(cat "$GREEN/max_brightness")"; bmax="$(cat "$BLUE/max_brightness")"
	bv=0
	case "$shade" in
		red) rv="$rmax"; gv=0 ;;
		orange) rv="$rmax"; gv=$((gmax / 4)) ;;
		yellow) rv="$rmax"; gv="$gmax" ;;
		green) rv=0; gv="$gmax" ;;
		blue) rv=0; gv=0; bv="$bmax" ;;
		white) rv="$rmax"; gv="$gmax"; bv="$bmax" ;;
		burgundy)
			rv=$((rmax / 2)); gv=0; bv=$((bmax / 8))
			[ "$rv" -gt 0 ] || rv=1
			[ "$bv" -gt 0 ] || bv=1
			;;
		*) return 0 ;;
	esac
	# Binary channels cannot produce the two mixed shades reliably.
	[ "$shade" != orange ] || [ "$gv" -gt 0 ] || gv=1
	for channel in "$RED" "$GREEN" "$BLUE"; do
		case "$channel" in "$RED") brightness="$rv" ;; "$GREEN") brightness="$gv" ;; *) brightness="$bv" ;; esac
		[ "$brightness" -gt 0 ] || continue
		echo none > "$channel/trigger"
		printf '%s\n' "$brightness" > "$channel/brightness"
	done
	for channel in "$RED" "$GREEN" "$BLUE"; do
		[ "$channel" != "$RED" ] || [ "$rv" -eq 0 ] || continue
		[ "$channel" != "$GREEN" ] || [ "$gv" -eq 0 ] || continue
		[ "$channel" != "$BLUE" ] || [ "$bv" -eq 0 ] || continue
		echo none > "$channel/trigger"
		echo 0 > "$channel/brightness"
	done
	if [ "$2" = blink ] && [ "$BLINK" = 1 ]; then
		rate="$3"
		period=$((60000 / rate))
		on=$((period / 2))
		for channel in "$RED" "$GREEN" "$BLUE"; do
			[ "$channel" != "$RED" ] || [ "$rv" -gt 0 ] || continue
			[ "$channel" != "$GREEN" ] || [ "$gv" -gt 0 ] || continue
			[ "$channel" != "$BLUE" ] || [ "$bv" -gt 0 ] || continue
			echo timer > "$channel/trigger"
			echo "$on" > "$channel/delay_on"; echo "$((period - on))" > "$channel/delay_off"
		done
	fi
}

internet_online() {
	local family device host pid online=1
	local probes=''
	for family in 4 6; do
		device="$(ip "-$family" route show table main default 2>/dev/null |
			awk '{ for (i=1; i<NF; i++) if ($i=="dev" && $(i+1)!="lo") { print $(i+1); exit } }')"
		[ -n "$device" ] || continue
		if [ "$family" = 4 ]; then
			set -- 1.1.1.1 8.8.8.8
		else
			set -- 2606:4700:4700::1111 2001:4860:4860::8888
		fi
		for host in "$@"; do
			ping "-$family" -I "$device" -c 1 -w 2 "$host" >/dev/null 2>&1 &
			probes="$probes $!"
		done
	done
	for pid in $probes; do
		wait "$pid" && online=0
	done
	return "$online"
}

run() {
	[ "$(cfg_bool led_outage_enabled 0)" = 1 ] || [ "$(cfg_bool led_enabled 0)" = 1 ] || { restore; return 0; }
	detect || { restore; return 1; }
	RULES="$(cfg led_rules none)"
	# Orange and yellow need independently dimmable red and green channels.
	[ "$(cat "$RED/max_brightness")" -gt 1 ] && [ "$(cat "$GREEN/max_brightness")" -gt 1 ] || return 1
	trap 'exit 0' INT TERM
	trap restore EXIT
	last=''
	while :; do
		started="$(cut -d. -f1 /proc/uptime)"
		outage="$(cfg_bool led_outage_enabled 0)"
		ms=0
		if [ "$outage" = 1 ] && ! internet_online; then
			next='burgundy:steady:0'
		elif [ "$(cfg_bool led_enabled 0)" = 1 ]; then
			if [ "$(cat "$ZGZ_STATUS" 2>/dev/null)" = ready ] && tunnel_running; then
				identity="$(exit_identity)" || identity=
				if [ "$outage" = 1 ]; then
					ms="$(bounded 10 "$ZGZ_LIB/zgz-test" live 2>/dev/null)" || ms=0
				else
					ms="$("$ZGZ_LIB/zgz-test" live 2>/dev/null)" || ms=0
				fi
				[ "$identity" = "$(exit_identity)" ] || ms=0
			fi
			next="$(rule_for_ping "$ms")"
		elif [ "$outage" = 1 ]; then
			next=original
		else
			break
		fi
		if [ "$next" != "$last" ]; then
			if [ "$next" = original ]; then
				restore
			else
				snapshot || return 1
				mode_rate="${next#*:}"
				apply_colour "${next%%:*}" "${mode_rate%%:*}" "${mode_rate#*:}"
			fi
			last="$next"
		fi
		delay=$((started + 15 - $(cut -d. -f1 /proc/uptime)))
		[ "$delay" -gt 0 ] || delay=1
		sleep "$delay" & wait $!
	done
}

case "${1:-status}" in
	status) status ;;
	run) run ;;
	restore) restore ;;
	*) exit 1 ;;
esac
