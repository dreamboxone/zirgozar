#
# zgz-dns - point the router's resolver at the tunnel while it is up.
#
#   zgz-dns up     send dnsmasq's upstream queries into the tunnel
#   zgz-dns down   put it back
#   zgz-dns where  print the directory dnsmasq reads drop-ins from
#
# Why this exists at all.
#
# A client asks the router for an address, the router asks whatever resolver
# it was given, and where that resolver answers with whatever it has been
# told to answer, a perfectly good tunnelled connection is then made to an
# address that was already wrong before it left. That is why, with a tunnel
# up and working, some sites open and others do not.
#
# The obvious fix is to redirect every port 53 packet straight into Xray. It
# works, and it also throws away dnsmasq - so the router stops knowing the
# names of the machines on its own network, DHCP names stop resolving, and
# the user's printer disappears. Which reads, quite reasonably, as "this
# thing broke my network".
#
# So instead dnsmasq keeps answering, and only its upstream is moved into the
# tunnel. Local names keep working, everything else is resolved through the
# tunnel, and one small file in a directory dnsmasq already watches is the
# whole change. Nothing is written to flash.

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

DROPIN=zirgozar.conf

# Where dnsmasq reads its drop-ins from.
#
# Not /tmp/dnsmasq.d. OpenWrt names that directory after the config section,
# so on most routers it is /tmp/dnsmasq.cfg01411c.d or similar, and a program
# that assumes the tidy name writes a file nothing ever reads - and then
# reports success. The generated configuration says where it really is.
dnsmasq_confdir() {
	_d="$(sed -n 's/^-*conf-dir=\([^,]*\).*/\1/p' /var/etc/dnsmasq.conf.* 2>/dev/null | head -1)"
	if [ -n "$_d" ] && [ -d "$_d" ]; then
		echo "$_d"
		return 0
	fi
	echo ""
	return 1
}

dnsmasq_running() {
	pgrep -x dnsmasq >/dev/null 2>&1
}

reload_dnsmasq() {
	# A drop-in is only read at start-up, so this has to be a restart and not
	# a reload. Bounded, because a procd lock held by something that died
	# would otherwise hold the whole connect sequence open for ever.
	bounded 30 /etc/init.d/dnsmasq restart >/dev/null 2>&1 || {
		warn "dnsmasq would not restart - name lookups may not be going through the tunnel"
		return 1
	}
	return 0
}

# What keeps name lookups on the tunnel for as long as the drop-in points
# dnsmasq at it - kept and dropped with the drop-in, not with the tunnel's
# rules, which come down on every restart while the drop-in stays.
#
# Two things, in a table of their own:
#
# - The devices' lookups, sent to dnsmasq whatever server they were addressed
#   to. The tunnel's rules do the same, but go with them on a restart, and a
#   device with a server of its own - 8.8.8.8 set by hand - then asked it
#   straight out until the new core was up.
#
# - dnsmasq's own way out. no-resolv puts aside the servers the ISP handed
#   out, but not the ones given under DNS forwardings, and dnsmasq goes on
#   asking those beside the tunnel, straight out, taking whichever answers
#   first. Rather than take them out of the user's settings and have to put
#   them back, its packets to them are dropped, and nothing else's: dnsmasq
#   runs as a user of its own. A server for one domain only - /lan/10.0.0.5 -
#   is left to answer for it when it is on the local network. One on the
#   internet is not: the firewall cannot tell which domain a query is for, so
#   letting the address through let every query to it through, and a domain
#   sent to a server on the internet outside the tunnel is the leak itself.
GUARD_TABLE=zirgozar_dns
GUARD_CHAIN=ZGZ_DNSOUT
LAN_CHAIN=ZGZ_DNSLAN
BYPASS=0xff

# An address on the router's own network: reached straight out of one of its
# LAN interfaces, not by way of a gateway. A private address is not enough -
# 10.202.10.10, a resolver many here set by hand, is private and on the
# provider's network, reached by the WAN like any other.
lan_routed() {
	_lr="$(ip -4 route get "$1" 2>/dev/null | head -1)"
	case "$_lr" in ''|*" via "*) return 1 ;; esac
	_lr_dev="$(printf '%s\n' "$_lr" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
	for _lr_d in $(lan_devices); do
		[ "$_lr_d" = "$_lr_dev" ] && return 0
	done
	return 1
}

# Replace an iptables chain without a moment in which it is missing or empty:
# the new one is built beside it under another name, jumped to, and only then
# is the old one taken out and the new one given its name.
#   ipt_swap <table> <chain> <parent>
ipt_swap() {
	iptables -w 2 -t "$1" -S "$3" 2>/dev/null | grep -- "-j $2\$" | sed 's/^-A /-D /' |
		while read -r _r; do
			# shellcheck disable=SC2086
			iptables -w 2 -t "$1" $_r >/dev/null 2>&1 || true
		done
	iptables -w 2 -t "$1" -F "$2" >/dev/null 2>&1 || true
	iptables -w 2 -t "$1" -X "$2" >/dev/null 2>&1 || true
	iptables -w 2 -t "$1" -E "${2}_N" "$2" >/dev/null 2>&1 || true
}

#   guard_up <port> <dnsmasq>
# The devices' lookups go to <port>: 53, dnsmasq, which then asks the tunnel;
# or the core's own DNS port when lookups go straight into the tunnel, which
# during a restart simply has nothing listening - a lookup that fails, not one
# that leaves. dnsmasq's own way out is closed only when it is <dnsmasq> 1,
# the one pointed at the tunnel.
guard_up() {
	_g_to="${1:-53}"
	_g_uid=""
	if [ "${2:-1}" = "1" ]; then
		_g_uid="$(awk -F: '$1 == "dnsmasq" { print $3; exit }' /etc/passwd 2>/dev/null)"
		case "$_g_uid" in ''|*[!0-9]*|0) _g_uid="" ;; esac
	fi
	_g_lan=""
	[ "$(cfg_bool dns_hijack 1)" = "1" ] && _g_lan="$(lan_devices)"
	_g_ports="53"; _g_ex=""
	for _g_s in $(uci -q get 'dhcp.@dnsmasq[0].server' 2>/dev/null); do
		case "$_g_s" in
			*/*)
				_g_a="${_g_s##*/}"; _g_a="${_g_a%%#*}"; _g_a="${_g_a%%@*}"
				case "$_g_a" in *.*.*.*) lan_routed "$_g_a" && _g_ex="$_g_ex $_g_a" ;; esac
				;;
			*'#'*)
				_g_p="${_g_s#*#}"; _g_p="${_g_p%%@*}"
				case "$_g_p" in ''|*[!0-9]*) : ;; *) _g_ports="$_g_ports $_g_p" ;; esac
				;;
		esac
	done
	_g_ports="$(echo $_g_ports | tr ' ' '\n' | sort -un | tr '\n' ' ')"
	if [ -z "$_g_uid" ] && [ -z "$_g_lan" ]; then
		guard_down
		return 0
	fi
	case "$(firewall_backend)" in
		nft)
			_g_nports="$(echo $_g_ports | sed 's/ /, /g')"
			_g_nex="$(echo $_g_ex | sed 's/ /, /g')"
			_g_nlan="$(echo $_g_lan | awk '{ for (i = 1; i <= NF; i++) printf "%s\"%s\"", (i > 1 ? ", " : ""), $i }')"
			# Declared, deleted and written again in one transaction, so it
			# is never missing while it is being replaced.
			{
				printf 'table inet %s\ndelete table inet %s\n' "$GUARD_TABLE" "$GUARD_TABLE"
				printf 'table inet %s {\n' "$GUARD_TABLE"
				if [ -n "$_g_nlan" ]; then
					printf '\tchain dns_lan {\n\t\ttype nat hook prerouting priority dstnat; policy accept;\n'
					printf '\t\tiifname != { %s } return\n' "$_g_nlan"
					printf '\t\tct direction reply return\n'
					printf '\t\tmeta mark & 0xff == %s return\n' "$BYPASS"
					printf '\t\tmeta l4proto { tcp, udp } th dport 53 counter redirect to :%s\n\t}\n' "$_g_to"
				fi
				if [ -n "$_g_uid" ]; then
					printf '\tchain dnsmasq_out {\n\t\ttype filter hook output priority filter; policy accept;\n'
					printf '\t\tmeta skuid != %s return\n' "$_g_uid"
					printf '\t\tip daddr 127.0.0.0/8 return\n'
					[ -z "$_g_nex" ] || printf '\t\tip daddr { %s } return\n' "$_g_nex"
					printf '\t\tip6 daddr ::1 return\n'
					printf '\t\tmeta l4proto { tcp, udp } th dport { %s } counter drop\n\t}\n' "$_g_nports"
				fi
				printf '}\n'
			} | nft -f - 2>/dev/null || warn "could not keep name lookups on the tunnel through a restart"
			;;
		ipt)
			if [ -n "$_g_lan" ]; then
				iptables -w 2 -t nat -N "${LAN_CHAIN}_N" >/dev/null 2>&1 || iptables -w 2 -t nat -F "${LAN_CHAIN}_N" >/dev/null 2>&1 || true
				iptables -w 2 -t nat -A "${LAN_CHAIN}_N" -m mark --mark "$BYPASS/0xff" -j RETURN >/dev/null 2>&1 || true
				iptables -w 2 -t nat -A "${LAN_CHAIN}_N" -p udp --dport 53 -j REDIRECT --to-ports "$_g_to" >/dev/null 2>&1 || true
				iptables -w 2 -t nat -A "${LAN_CHAIN}_N" -p tcp --dport 53 -j REDIRECT --to-ports "$_g_to" >/dev/null 2>&1 || true
				for _d in $_g_lan; do
					iptables -w 2 -t nat -I PREROUTING -i "$_d" -j "${LAN_CHAIN}_N" >/dev/null 2>&1 || true
				done
				ipt_swap nat "$LAN_CHAIN" PREROUTING
			fi
			# The owner match is not on every build; without it this half is
			# left undone, and said.
			if [ -n "$_g_uid" ]; then
				iptables -w 2 -N "${GUARD_CHAIN}_N" >/dev/null 2>&1 || iptables -w 2 -F "${GUARD_CHAIN}_N" >/dev/null 2>&1 || true
				if iptables -w 2 -A "${GUARD_CHAIN}_N" -m owner ! --uid-owner "$_g_uid" -j RETURN >/dev/null 2>&1; then
					iptables -w 2 -A "${GUARD_CHAIN}_N" -d 127.0.0.0/8 -j RETURN >/dev/null 2>&1 || true
					for _g_a in $_g_ex; do
						iptables -w 2 -A "${GUARD_CHAIN}_N" -d "$_g_a" -j RETURN >/dev/null 2>&1 || true
					done
					for _g_p in $_g_ports; do
						iptables -w 2 -A "${GUARD_CHAIN}_N" -p udp --dport "$_g_p" -j DROP >/dev/null 2>&1 || true
						iptables -w 2 -A "${GUARD_CHAIN}_N" -p tcp --dport "$_g_p" -j DROP >/dev/null 2>&1 || true
					done
					iptables -w 2 -I OUTPUT -j "${GUARD_CHAIN}_N" >/dev/null 2>&1 || true
					ipt_swap filter "$GUARD_CHAIN" OUTPUT
				else
					iptables -w 2 -F "${GUARD_CHAIN}_N" >/dev/null 2>&1 || true
					iptables -w 2 -X "${GUARD_CHAIN}_N" >/dev/null 2>&1 || true
					[ "${ZGZ_DNS_QUIET:-0}" = "1" ] || warn "iptables has no owner match here - dnsmasq may still ask the DNS forwardings set beside the tunnel"
				fi
			fi
			;;
	esac
	return 0
}

guard_down() {
	if command -v nft >/dev/null 2>&1; then
		nft delete table inet "$GUARD_TABLE" >/dev/null 2>&1 || true
	fi
	if command -v iptables >/dev/null 2>&1; then
		for _gc in "$GUARD_CHAIN" "${GUARD_CHAIN}_N"; do
			iptables -w 2 -S OUTPUT 2>/dev/null | grep -- "-j $_gc\$" | sed 's/^-A /-D /' |
				while read -r _r; do
					# shellcheck disable=SC2086
					iptables -w 2 $_r >/dev/null 2>&1 || true
				done
			iptables -w 2 -F "$_gc" >/dev/null 2>&1 || true
			iptables -w 2 -X "$_gc" >/dev/null 2>&1 || true
		done
		for _gc in "$LAN_CHAIN" "${LAN_CHAIN}_N"; do
			iptables -w 2 -t nat -S PREROUTING 2>/dev/null | grep -- "-j $_gc\$" | sed 's/^-A /-D /' |
				while read -r _r; do
					# shellcheck disable=SC2086
					iptables -w 2 -t nat $_r >/dev/null 2>&1 || true
				done
			iptables -w 2 -t nat -F "$_gc" >/dev/null 2>&1 || true
			iptables -w 2 -t nat -X "$_gc" >/dev/null 2>&1 || true
		done
	fi
	return 0
}

# Which dnsmasq read the drop-in: the processes running when it was last
# restarted with it in place. A drop-in on disk is not one dnsmasq has read -
# a restart that failed left the old one running without it - so only these
# very processes still running let a restart be skipped.
LOADED="$ZGZ_RUN/dns.loaded"

# What is said at a start, and not again every few minutes from the health
# check, which calls this too.
note() {
	[ "${ZGZ_DNS_QUIET:-0}" = "1" ] || log "$@"
}

# The daemon itself, as procd started it: not every process by that name,
# since dnsmasq forks one for each DNS-over-TCP connection, and those coming
# and going looked like a new dnsmasq that had to be restarted again.
dnsmasq_pids() {
	_dp="$(ubus call service list '{"name":"dnsmasq"}' 2>/dev/null |
		jsonfilter -e '@.dnsmasq.instances[*].pid' 2>/dev/null | sort -n | tr '\n' ' ')"
	[ -n "$_dp" ] || _dp="$(pgrep -o -x dnsmasq 2>/dev/null)"
	echo "$_dp"
}

cmd_up() {
	_mode="$(cfg dns_mode dnsmasq)"
	_port="$(cfg dns_port 1053)"

	case "$_mode" in
		off)
			# A drop-in left by a mode before this one, which a restart now
			# keeps in place, is taken out first.
			cmd_down
			note "dns_mode is off - leaving name resolution alone"
			return 0
			;;
		direct)
			# The firewall sends port 53 straight to the core in this mode;
			# there is nothing for dnsmasq to do. The devices' lookups are
			# still kept going there through a restart.
			dropin_down
			guard_up "$_port" 0
			return 0
			;;
	esac

	if ! dnsmasq_running; then
		guard_up "$_port" 0
		note "no dnsmasq on this router - name lookups will be redirected straight to the tunnel"
		return 0
	fi

	_dir="$(dnsmasq_confdir)" || _dir=""
	if [ -z "$_dir" ]; then
		guard_up "$_port" 0
		if [ "${ZGZ_DNS_QUIET:-0}" != "1" ]; then
			say_message "Could not find the directory dnsmasq reads its extra configuration from, so name lookups are being redirected straight into the tunnel instead. Local machine names will not resolve while connected."
			warn "no dnsmasq conf-dir found"
		fi
		return 0
	fi

	# In place before dnsmasq is pointed at the tunnel, so there is no moment
	# in which it is and its other servers are still open to it.
	guard_up 53 1

	# no-resolv so the addresses the ISP handed out are not consulted as well:
	# dnsmasq would ask every upstream at once and take the first answer, and
	# the first answer would routinely be the one this exists to avoid.
	cat > "$_dir/.$DROPIN.new" <<EOF
# Written by Zirgozar while the tunnel is up. Removed when it goes down.
no-resolv
server=127.0.0.1#$_port
EOF
	# Already there, as a restart of the tunnel leaves it, and read by the
	# dnsmasq now running: it is not restarted for nothing, and for a moment
	# with the ISP's servers.
	if cmp -s "$_dir/.$DROPIN.new" "$_dir/$DROPIN" && dnsmasq_running &&
	   [ "$(cat "$LOADED" 2>/dev/null)" = "$(dnsmasq_pids)" ]; then
		rm -f "$_dir/.$DROPIN.new"
		return 0
	fi
	mv -f "$_dir/.$DROPIN.new" "$_dir/$DROPIN"

	if ! reload_dnsmasq; then
		# Not read, so the next call - the next start, save or health check
		# - tries again rather than taking the file for done.
		rm -f "$LOADED"
		return 1
	fi
	# Its processes come up one after another, in a jail of its own, so they
	# are written down once they have stopped changing.
	_n=0; _p=""
	while [ "$_n" -lt 8 ]; do
		sleep 1
		_q="$(dnsmasq_pids)"
		[ -n "$_q" ] && [ "$_q" = "$_p" ] && break
		_p="$_q"; _n=$((_n + 1))
	done
	dnsmasq_pids > "$LOADED"
	log "name lookups now go through the tunnel (via $_dir/$DROPIN)"
	return 0
}

# dnsmasq taken off the tunnel, if it was on it.
dropin_down() {
	_dir="$(dnsmasq_confdir)" || _dir=""
	if [ -n "$_dir" ] && [ -f "$_dir/$DROPIN" ]; then
		rm -f "$_dir/$DROPIN"
		if dnsmasq_running; then
			reload_dnsmasq || true
		fi
		log "name lookups are back to normal"
	fi
	rm -f "$LOADED"
}

cmd_down() {
	dropin_down
	# Only once dnsmasq has let go of the tunnel, and whatever else happened:
	# a guard with nothing to guard would still keep dnsmasq off the servers
	# it is now meant to ask.
	guard_down
	return 0
}

cmd_where() {
	dnsmasq_confdir
	return 0
}

case "${1:-}" in
	up)    cmd_up ;;
	down)  cmd_down ;;
	where) cmd_where ;;
	*) echo "usage: $0 up|down|where" >&2; exit 1 ;;
esac
