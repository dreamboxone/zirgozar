#
# An isolated DNS resolver for tunnel traffic. The system resolver keeps DHCP
# and its own configuration. Only local DNS records are imported into the new
# instance; its sole upstream is the tunnel's DNS listener.

set -e

. "${ZGZ_LIB:-/usr/libexec}/zgz-common.sh"

DROPIN=zirgozar.conf

# Where dnsmasq reads its drop-ins from.
#
# Not /tmp/dnsmasq.d. OpenWrt names that directory after the config section,
# so on most routers it is /tmp/dnsmasq.cfg01411c.d or similar, and a program
# that assumes the tidy name writes a file nothing ever reads - and then
# reports success. The generated configuration says where it really is.
dnsmasq_confdir() {
	_d="$(sed -n 's/^-*conf-dir=\([^,]*\).*/\1/p' /var/etc/dnsmasq.conf.* 2>/dev/null | head -1)"
	if [ -n "$_d" ] && [ -d "$_d" ]; then
		echo "$_d"
		return 0
	fi
	echo ""
	return 1
}

dnsmasq_running() {
	pgrep -x dnsmasq >/dev/null 2>&1
}

reload_dnsmasq() {
	# A drop-in is only read at start-up, so this has to be a restart and not
	# a reload. Bounded, because a procd lock held by something that died
	# would otherwise hold the whole connect sequence open for ever.
	bounded 30 /etc/init.d/dnsmasq restart >/dev/null 2>&1 || {
		warn "dnsmasq would not restart - name lookups may not be going through the tunnel"
		return 1
	}
	return 0
}

# What keeps name lookups on the tunnel for as long as the drop-in points
# dnsmasq at it - kept and dropped with the drop-in, not with the tunnel's
# rules, which come down on every restart while the drop-in stays.
#
# Three things, in a table of their own - the third, a drop of any lookup
# still passing through the router to a server outside, for a connection
# that began before the redirect and so never took it; see guard_up:
#
# - The devices' lookups, sent to dnsmasq whatever server they were addressed
#   to. The tunnel's rules do the same, but go with them on a restart, and a
#   device with a server of its own - 8.8.8.8 set by hand - then asked it
#   straight out until the new core was up.
#
# - During a resolver restart, unmarked router DNS is blocked. Once it is
#   running, protect its actual process UIDs (including root), not a passwd
#   entry which may not match a custom build or jail. The core's existing
#   socket mark keeps its intentional bootstrap and split DNS working.
GUARD_TABLE=zirgozar_dns
GUARD_CHAIN=ZGZ_DNSOUT
ROUTER_CHAIN=ZGZ_DNSROUTER
LAN_CHAIN=ZGZ_DNSLAN
FWD_CHAIN=ZGZ_DNSFWD
BYPASS=0xff

# An address on the router's own network: reached straight out of one of its
# LAN interfaces, not by way of a gateway. A private address is not enough -
# 10.202.10.10, a resolver many here set by hand, is private and on the
# provider's network, reached by the WAN like any other.
lan_routed() {
	_lr="$(ip -4 route get "$1" 2>/dev/null | head -1)"
	case "$_lr" in ''|*" via "*) return 1 ;; esac
	_lr_dev="$(printf '%s\n' "$_lr" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
	for _lr_d in $(lan_devices); do
		[ "$_lr_d" = "$_lr_dev" ] && return 0
	done
	return 1
}

# Replace an iptables chain without a moment in which it is missing or empty:
# the new one is built beside it under another name, jumped to, and only then
# is the old one taken out and the new one given its name.
#   ipt_swap <table> <chain> <parent>
ipt_swap() {
	iptables -w 2 -t "$1" -S "$3" 2>/dev/null | grep -- "-j $2\$" | sed 's/^-A /-D /' |
		while read -r _r; do
			# shellcheck disable=SC2086
			iptables -w 2 -t "$1" $_r >/dev/null 2>&1 || true
		done
	iptables -w 2 -t "$1" -F "$2" >/dev/null 2>&1 || true
	iptables -w 2 -t "$1" -X "$2" >/dev/null 2>&1 || true
	iptables -w 2 -t "$1" -E "${2}_N" "$2" >/dev/null 2>&1 || true
}

#   guard_up <port> <dnsmasq>
# The devices' lookups go to <port>: 53, dnsmasq, which then asks the tunnel;
# or the core's own DNS port when lookups go straight into the tunnel, which
# during a restart simply has nothing listening - a lookup that fails, not one
# that leaves. Router DNS output is protected when the second argument is 1.
# Read host-visible effective and filesystem UIDs from procd daemon PIDs.
# Missing or unreadable process identity is an error, never an empty guard.
dnsmasq_uids() {
	_du_pids="$(dnsmasq_pids)" || return 1
	[ -n "$_du_pids" ] || return 1
	_du_ids=""
	for _du_pid in $_du_pids; do
		_du_one="$(awk '/^Uid:/ { print $3; print $5 }' "/proc/$_du_pid/status" 2>/dev/null)" || return 1
		[ -n "$_du_one" ] || return 1
		for _du_uid in $_du_one; do
			case "$_du_uid" in ''|*[!0-9]*) return 1 ;; esac
		done
		_du_ids="$_du_ids $_du_one"
	done
	printf '%s\n' $_du_ids | sort -un | tr '\n' ' '
}

guard_up() {
	_g_to="${1:-53}"
	_g_output="${2:-1}"
	_g_uids=""
	if [ "$_g_output" = "uids" ]; then
		_g_uids="$(dnsmasq_uids)" || return 1
		[ -n "$_g_uids" ] || return 1
		_g_output=1
	fi
	_g_lan=""
	[ "$(cfg_bool dns_hijack 1)" = "1" ] && _g_lan="$(lan_devices)"
	_g_ports="53"; _g_ex=""
	for _g_s in $(uci -q get 'dhcp.@dnsmasq[0].server' 2>/dev/null); do
		case "$_g_s" in
			*/*)
				_g_a="${_g_s##*/}"; _g_a="${_g_a%%#*}"; _g_a="${_g_a%%@*}"
				case "$_g_a" in *.*.*.*) lan_routed "$_g_a" && _g_ex="$_g_ex $_g_a" ;; esac
				;;
			*'#'*)
				_g_p="${_g_s#*#}"; _g_p="${_g_p%%@*}"
				case "$_g_p" in ''|*[!0-9]*) : ;; *) _g_ports="$_g_ports $_g_p" ;; esac
				;;
		esac
	done
	_g_ports="$(echo $_g_ports | tr ' ' '\n' | sort -un | tr '\n' ' ')"
	if [ "$_g_output" != "1" ] && [ -z "$_g_lan" ]; then
		guard_down
		return 0
	fi
	case "$(firewall_backend)" in
		nft)
			_g_nports="$(echo $_g_ports | sed 's/ /, /g')"
			_g_nex="$(echo $_g_ex | sed 's/ /, /g')"
			_g_nlan="$(echo $_g_lan | awk '{ for (i = 1; i <= NF; i++) printf "%s\"%s\"", (i > 1 ? ", " : ""), $i }')"
			# Declared, deleted and written again in one transaction, so it
			# is never missing while it is being replaced.
			{
				printf 'table inet %s\ndelete table inet %s\n' "$GUARD_TABLE" "$GUARD_TABLE"
				printf 'table inet %s {\n' "$GUARD_TABLE"
				if [ -n "$_g_nlan" ]; then
					printf '\tchain dns_lan {\n\t\ttype nat hook prerouting priority dstnat; policy accept;\n'
					printf '\t\tiifname != { %s } return\n' "$_g_nlan"
					printf '\t\tct direction reply return\n'
					printf '\t\tmeta mark & 0xff == %s return\n' "$BYPASS"
					printf '\t\tmeta l4proto { tcp, udp } th dport 53 counter redirect to :%s\n\t}\n' "$_g_to"
					# A redirect decides once, on a connection's first packet.
					# A lookup on a connection that began before it - a socket
					# a device kept open across the start, or across a change
					# of mode - goes on the way it began, out to the server it
					# names. A filter sees every packet, so any lookup still
					# going through the router rather than to it is dropped
					# here: one that was redirected never comes this way.
					printf '\tchain dns_fwd {\n\t\ttype filter hook forward priority filter; policy accept;\n'
					printf '\t\tiifname != { %s } return\n' "$_g_nlan"
					printf '\t\tmeta mark & 0xff == %s return\n' "$BYPASS"
					printf '\t\tmeta l4proto { tcp, udp } th dport 53 counter drop\n\t}\n'
				fi
				if [ "$_g_output" = "1" ]; then
					# Queries addressed to a DNS service on this router also
					# use the isolated resolver. Explicit marked core DNS
					# and direct bootstrap helpers are left alone.
					printf '\tchain dns_router {\n\t\ttype nat hook output priority dstnat; policy accept;\n'
					printf '\t\tct direction reply return\n'
					printf '\t\tmeta mark & 0xff == %s return\n' "$BYPASS"
					printf '\t\toifname "lo" meta l4proto { tcp, udp } th dport 53 counter redirect to :%s\n\t}\n' "$_g_to"
					printf '\tchain dnsmasq_out {\n\t\ttype filter hook output priority filter; policy accept;\n'
					printf '\t\tmeta mark & 0xff == %s return\n' "$BYPASS"
					if [ -n "$_g_uids" ]; then
						printf '\t\tmeta skuid != { %s } return\n' "$(echo $_g_uids | sed 's/ /, /g')"
					fi
					printf '\t\tip daddr 127.0.0.0/8 return\n'
					[ -z "$_g_nex" ] || printf '\t\tip daddr { %s } return\n' "$_g_nex"
					printf '\t\tip6 daddr ::1 return\n'
					printf '\t\tmeta l4proto { tcp, udp } th dport { %s } counter drop\n\t}\n' "$_g_nports"
				fi
				printf '}\n'
			} | nft -f - 2>"$ZGZ_RUN/dns-guard.err" || return 1
			if [ "$_g_output" = "1" ]; then
				nft list chain inet "$GUARD_TABLE" dnsmasq_out >/dev/null 2>&1 || return 1
				nft list chain inet "$GUARD_TABLE" dns_router >/dev/null 2>&1 || return 1
			fi
			if [ -n "$_g_lan" ]; then
				nft list chain inet "$GUARD_TABLE" dns_lan >/dev/null 2>&1 || return 1
				nft list chain inet "$GUARD_TABLE" dns_fwd >/dev/null 2>&1 || return 1
			fi
			;;
		ipt)
			if [ -n "$_g_lan" ]; then
				iptables -w 2 -t nat -N "${LAN_CHAIN}_N" >/dev/null 2>&1 || iptables -w 2 -t nat -F "${LAN_CHAIN}_N" >/dev/null 2>&1 || return 1
				iptables -w 2 -t nat -A "${LAN_CHAIN}_N" -m mark --mark "$BYPASS/0xff" -j RETURN >/dev/null 2>&1 || return 1
				iptables -w 2 -t nat -A "${LAN_CHAIN}_N" -p udp --dport 53 -j REDIRECT --to-ports "$_g_to" >/dev/null 2>&1 || return 1
				iptables -w 2 -t nat -A "${LAN_CHAIN}_N" -p tcp --dport 53 -j REDIRECT --to-ports "$_g_to" >/dev/null 2>&1 || return 1
				for _d in $_g_lan; do
					iptables -w 2 -t nat -I PREROUTING -i "$_d" -j "${LAN_CHAIN}_N" >/dev/null 2>&1 || return 1
				done
				ipt_swap nat "$LAN_CHAIN" PREROUTING
				for _d in $_g_lan; do
					iptables -w 2 -t nat -C PREROUTING -i "$_d" -j "$LAN_CHAIN" >/dev/null 2>&1 || return 1
				done
				# Lookups on connections from before the redirect - see the
				# nftables side.
				iptables -w 2 -N "${FWD_CHAIN}_N" >/dev/null 2>&1 || iptables -w 2 -F "${FWD_CHAIN}_N" >/dev/null 2>&1 || return 1
				iptables -w 2 -A "${FWD_CHAIN}_N" -m mark --mark "$BYPASS/0xff" -j RETURN >/dev/null 2>&1 || return 1
				iptables -w 2 -A "${FWD_CHAIN}_N" -p udp --dport 53 -j DROP >/dev/null 2>&1 || return 1
				iptables -w 2 -A "${FWD_CHAIN}_N" -p tcp --dport 53 -j DROP >/dev/null 2>&1 || return 1
				for _d in $_g_lan; do
					iptables -w 2 -I FORWARD -i "$_d" -j "${FWD_CHAIN}_N" >/dev/null 2>&1 || return 1
				done
				ipt_swap filter "$FWD_CHAIN" FORWARD
				for _d in $_g_lan; do
					iptables -w 2 -C FORWARD -i "$_d" -j "$FWD_CHAIN" >/dev/null 2>&1 || return 1
				done
			fi
			iptables -w 2 -t nat -N "${ROUTER_CHAIN}_N" >/dev/null 2>&1 || iptables -w 2 -t nat -F "${ROUTER_CHAIN}_N" >/dev/null 2>&1 || return 1
			iptables -w 2 -t nat -A "${ROUTER_CHAIN}_N" -m mark --mark "$BYPASS/0xff" -j RETURN >/dev/null 2>&1 || return 1
			iptables -w 2 -t nat -A "${ROUTER_CHAIN}_N" -o lo -p udp --dport 53 -j REDIRECT --to-ports "$_g_to" >/dev/null 2>&1 || return 1
			iptables -w 2 -t nat -A "${ROUTER_CHAIN}_N" -o lo -p tcp --dport 53 -j REDIRECT --to-ports "$_g_to" >/dev/null 2>&1 || return 1
			iptables -w 2 -t nat -I OUTPUT -j "${ROUTER_CHAIN}_N" >/dev/null 2>&1 || return 1
			ipt_swap nat "$ROUTER_CHAIN" OUTPUT
			iptables -w 2 -t nat -C OUTPUT -j "$ROUTER_CHAIN" >/dev/null 2>&1 || return 1
			# The core mark is the only external DNS exception.
			if [ "$_g_output" = "1" ]; then
				iptables -w 2 -N "${GUARD_CHAIN}_N" >/dev/null 2>&1 || iptables -w 2 -F "${GUARD_CHAIN}_N" >/dev/null 2>&1 || return 1
				if iptables -w 2 -A "${GUARD_CHAIN}_N" -m mark --mark "$BYPASS/0xff" -j RETURN >/dev/null 2>&1; then

					iptables -w 2 -A "${GUARD_CHAIN}_N" -d 127.0.0.0/8 -j RETURN >/dev/null 2>&1 || return 1
					for _g_a in $_g_ex; do
						iptables -w 2 -A "${GUARD_CHAIN}_N" -d "$_g_a" -j RETURN >/dev/null 2>&1 || return 1
					done
					for _g_u in ${_g_uids:-all}; do
						set --
						[ "$_g_u" = all ] || set -- -m owner --uid-owner "$_g_u"
						for _g_p in $_g_ports; do
							iptables -w 2 -A "${GUARD_CHAIN}_N" "$@" -p udp --dport "$_g_p" -j DROP >/dev/null 2>&1 || return 1
							iptables -w 2 -A "${GUARD_CHAIN}_N" "$@" -p tcp --dport "$_g_p" -j DROP >/dev/null 2>&1 || return 1
						done
					done
					iptables -w 2 -I OUTPUT -j "${GUARD_CHAIN}_N" >/dev/null 2>&1 || return 1
					ipt_swap filter "$GUARD_CHAIN" OUTPUT
					iptables -w 2 -C OUTPUT -j "$GUARD_CHAIN" >/dev/null 2>&1 || return 1
				else
					iptables -w 2 -F "${GUARD_CHAIN}_N" >/dev/null 2>&1 || return 1
					iptables -w 2 -X "${GUARD_CHAIN}_N" >/dev/null 2>&1 || return 1
					return 1
				fi
			fi
			;;
		*) return 1 ;;
	esac
	return 0
}

guard_down() {
	if command -v nft >/dev/null 2>&1; then
		nft delete table inet "$GUARD_TABLE" >/dev/null 2>&1 || true
	fi
	if command -v iptables >/dev/null 2>&1; then
		for _gc in "$ROUTER_CHAIN" "${ROUTER_CHAIN}_N"; do
			iptables -w 2 -t nat -S OUTPUT 2>/dev/null | grep -- "-j $_gc\$" | sed 's/^-A /-D /' |
				while read -r _r; do
					# shellcheck disable=SC2086
					iptables -w 2 -t nat $_r >/dev/null 2>&1 || true
				done
			iptables -w 2 -t nat -F "$_gc" >/dev/null 2>&1 || true
			iptables -w 2 -t nat -X "$_gc" >/dev/null 2>&1 || true
		 done
		for _gc in "$GUARD_CHAIN" "${GUARD_CHAIN}_N"; do
			iptables -w 2 -S OUTPUT 2>/dev/null | grep -- "-j $_gc\$" | sed 's/^-A /-D /' |
				while read -r _r; do
					# shellcheck disable=SC2086
					iptables -w 2 $_r >/dev/null 2>&1 || true
				done
			iptables -w 2 -F "$_gc" >/dev/null 2>&1 || true
			iptables -w 2 -X "$_gc" >/dev/null 2>&1 || true
		done
		for _gc in "$FWD_CHAIN" "${FWD_CHAIN}_N"; do
			iptables -w 2 -S FORWARD 2>/dev/null | grep -- "-j $_gc\$" | sed 's/^-A /-D /' |
				while read -r _r; do
					# shellcheck disable=SC2086
					iptables -w 2 $_r >/dev/null 2>&1 || true
				done
			iptables -w 2 -F "$_gc" >/dev/null 2>&1 || true
			iptables -w 2 -X "$_gc" >/dev/null 2>&1 || true
		done
		for _gc in "$LAN_CHAIN" "${LAN_CHAIN}_N"; do
			iptables -w 2 -t nat -S PREROUTING 2>/dev/null | grep -- "-j $_gc\$" | sed 's/^-A /-D /' |
				while read -r _r; do
					# shellcheck disable=SC2086
					iptables -w 2 -t nat $_r >/dev/null 2>&1 || true
				done
			iptables -w 2 -t nat -F "$_gc" >/dev/null 2>&1 || true
			iptables -w 2 -t nat -X "$_gc" >/dev/null 2>&1 || true
		done
	fi
	return 0
}

# Only daemon PIDs, not temporary TCP workers. The isolated resolver is a
# separate procd service and must be included in the second protection layer.
dnsmasq_pids() {
	_dp="$(ubus call service list 2>/dev/null |
		jsonfilter -e '@.dnsmasq.instances[*].pid' -e '@["zirgozar-dns"].instances.resolver.pid' 2>/dev/null | sort -un | tr '\n' ' ')"
	[ -n "$_dp" ] || _dp="$( { pgrep -o -x dnsmasq 2>/dev/null; private_pid 2>/dev/null; } | sort -un | tr '\n' ' ')"
	echo "$_dp"
}

private_pid() {
	_pp="$(cat "$ZGZ_RUN/resolver.pid" 2>/dev/null)" || return 1
	case "$_pp" in ''|*[!0-9]*) return 1 ;; esac
	[ "$(cat "/proc/$_pp/comm" 2>/dev/null)" = dnsmasq ] || return 1
	# Never signal a reused PID belonging to another dnsmasq instance.
	tr '\000' '\n' < "/proc/$_pp/cmdline" | grep -Fx -- "--conf-file=$ZGZ_RUN/resolver.conf" >/dev/null || return 1
	echo "$_pp"
}

private_ready() {
	local pid fd inode ids="" hex file
	pid="$(private_pid)" || return 1
	hex="$(printf '%04X' "$1")"
	for fd in /proc/"$pid"/fd/*; do
		inode="$(readlink "$fd" 2>/dev/null)" || continue
		case "$inode" in socket:*) inode="${inode#socket:[}"; inode="${inode%]}"; ids="$ids $inode" ;; esac
	done
	[ -n "$ids" ] || return 1
	set --
	for file in /proc/net/tcp /proc/net/tcp6 /proc/net/udp /proc/net/udp6; do
		[ ! -r "$file" ] || set -- "$@" "$file"
	done
	awk -v ids="$ids" -v port=":$hex" '
		BEGIN { n=split(ids,a," "); for(i=1;i<=n;i++) owned[a[i]]=1 }
		owned[$10] && toupper(substr($2,length($2)-4)) == port {
			if (FILENAME ~ /tcp/ && $4 == "0A") tcp=1
			if (FILENAME ~ /udp/ && $4 == "07") udp=1
		}
		END { exit !(tcp && udp) }
	' "$@"
}

private_stop() {
	rm -f "$ZGZ_RUN/resolver.enabled"
	bounded 20 /etc/init.d/zirgozar-dns stop >/dev/null 2>&1
}

private_up() {
	local target="$1" changed=0 n=0
	: > "$ZGZ_RUN/resolver-check.err"
	command -v dnsmasq >/dev/null 2>&1 || { echo "dnsmasq is not installed" > "$ZGZ_RUN/resolver-check.err"; return 1; }
	"$ZGZ_LIB/zgz-dns-local" config > "$ZGZ_RUN/resolver.conf.new" 2>>"$ZGZ_RUN/resolver-check.err" || return 1
	"$ZGZ_LIB/zgz-dns-local" hosts "$ZGZ_RUN/resolver.conf.new" 2>>"$ZGZ_RUN/resolver-check.err" || return 1
	dnsmasq --test --conf-file="$ZGZ_RUN/resolver.conf.new" > "$ZGZ_RUN/resolver-check.err" 2>&1 || return 1
	if ! cmp -s "$ZGZ_RUN/resolver.conf.new" "$ZGZ_RUN/resolver.conf"; then
		mv -f "$ZGZ_RUN/resolver.conf.new" "$ZGZ_RUN/resolver.conf" || return 1
		changed=1
	else
		rm -f "$ZGZ_RUN/resolver.conf.new"
	fi
	if [ "$changed" = 0 ] && private_ready "$target"; then return 0; fi
	touch "$ZGZ_RUN/resolver.enabled"
	bounded 30 /etc/init.d/zirgozar-dns restart >/dev/null 2>&1 || return 1
	while [ "$n" -lt 10 ]; do
		private_ready "$target" && return 0
		n=$((n + 1)); sleep 1
	done
	return 1
}

# Upgrade from the old shared-resolver implementation. UCI is never changed.
# Normal starts of this version do not restart the DHCP service.
legacy_cleanup() {
	local dir changed=0
	dir="$(dnsmasq_confdir)" || dir=""
	if [ -n "$dir" ] && [ -f "$dir/$DROPIN" ] &&
	   grep -q '^# Written by Zirgozar' "$dir/$DROPIN"; then
		rm -f "$dir/$DROPIN" || return 1
		changed=1
	fi
	if [ "$changed" = 1 ] || [ -f "$ZGZ_RUN/dns.main-stopped" ] || { [ -f "$ZGZ_RUN/dns.failed" ] && [ ! -f "$ZGZ_RUN/resolver.layout" ]; }; then
		reload_dnsmasq || return 1
		rm -f "$ZGZ_RUN/dns.main-stopped" "$ZGZ_RUN/dns.loaded"
	fi
	touch "$ZGZ_RUN/resolver.layout"
}

DNS_GUARD_VERIFIED=0
dns_failed() {
	touch "$ZGZ_RUN/dns.failed"
	warn "DNS protection failed: $*"
	for _df in "$ZGZ_RUN/dns-guard.err" "$ZGZ_RUN/resolver-check.err"; do
		[ ! -s "$_df" ] || warn "$(head -20 "$_df")"
	done
	private_stop || true
	say_status failed
	say_message "راه‌اندازی DNS اختصاصی ناموفق بود. محافظ موجود حفظ شده است؛ گزارش اجرا را بررسی و اتصال را دوباره راه‌اندازی کنید."
	if [ "$DNS_GUARD_VERIFIED" != 1 ]; then
		# A broken firewall cannot enforce a redirect. Do not leave the
		# original resolver free to answer through its old upstreams.
		touch "$ZGZ_RUN/dns.main-stopped"
		bounded 30 /etc/init.d/dnsmasq stop >/dev/null 2>&1 || true
		say_message "محافظ DNS تأیید نشد؛ سرویس اصلی dnsmasq برای جلوگیری از درخواست مستقیم متوقف شد. DNS و DHCP ممکن است تا رفع خطا در دسترس نباشند."
		if dnsmasq_running; then
			warn "the system resolver is still running; DNS protection is not guaranteed"
			say_message "محافظ DNS و توقف سرویس اصلی تأیید نشدند. جلوگیری از نشت تضمین نمی‌شود؛ اتصال را متوقف و گزارش اجرا را بررسی کنید."
		fi
	fi
	return 1
}

cmd_up() {
	local mode target
	mode="$(cfg dns_mode dnsmasq)"
	case "$mode" in
		off) cmd_down; return $? ;;
		dnsmasq) target="$(cfg dnsmasq_port 1054)" ;;
		direct) target="$(cfg dns_port 1053)" ;;
		*) dns_failed "unknown DNS mode"; return 1 ;;
	esac
	case "$target" in ''|*[!0-9]*) dns_failed "invalid DNS port"; return 1 ;; esac
	[ "$target" -gt 1023 ] && [ "$target" -le 65535 ] || { dns_failed "invalid DNS port"; return 1; }
	guard_up "$target" 1 || { dns_failed "firewall installation or verification failed"; return 1; }
	DNS_GUARD_VERIFIED=1
	legacy_cleanup || { dns_failed "could not migrate the system resolver"; return 1; }
	if [ "$mode" = dnsmasq ]; then
		private_up "$target" || { dns_failed "isolated resolver did not accept its configuration or open both DNS sockets"; return 1; }
	else
		private_stop || { dns_failed "could not stop the isolated resolver"; return 1; }
	fi
	if [ -n "$(dnsmasq_pids)" ]; then
		guard_up "$target" uids || { dns_failed "resolver identity or output guard verification failed"; return 1; }
	fi
	rm -f "$ZGZ_RUN/dns.failed" "$ZGZ_RUN/dns.loaded"
	[ "${ZGZ_DNS_QUIET:-0}" = 1 ] || log "DNS is isolated from the system upstream settings (port $target)"
	return 0
}

cmd_down() {
	private_stop || return 1
	legacy_cleanup || return 1
	guard_down
	rm -f "$ZGZ_RUN/resolver.conf" "$ZGZ_RUN/resolver.conf.new" "$ZGZ_RUN/resolver.pid" "$ZGZ_RUN/dns.failed" "$ZGZ_RUN/dns.loaded"
	return 0
}

# Health checks and a settings save may arrive together. Only the owner may
# release this lock; a failed waiter must never remove another operation's lock.
dns_lock() {
	local n=0 owner
	while ! mkdir "$ZGZ_RUN/dns.lock" 2>/dev/null; do
		owner="$(cat "$ZGZ_RUN/dns.lock/pid" 2>/dev/null)" || owner=""
		case "$owner" in ''|*[!0-9]*) : ;; *)
			if ! kill -0 "$owner" 2>/dev/null; then
				rm -f "$ZGZ_RUN/dns.lock/pid"
				rmdir "$ZGZ_RUN/dns.lock" 2>/dev/null || true
			fi ;;
		esac
		n=$((n + 1)); [ "$n" -lt 60 ] || return 1
		sleep 1
	done
	echo $$ > "$ZGZ_RUN/dns.lock/pid"
	trap 'dns_unlock' EXIT
	trap 'exit 1' INT TERM
}

dns_unlock() {
	[ "$(cat "$ZGZ_RUN/dns.lock/pid" 2>/dev/null)" = "$$" ] || return 0
	rm -f "$ZGZ_RUN/dns.lock/pid"
	rmdir "$ZGZ_RUN/dns.lock" 2>/dev/null || true
}

case "${1:-}" in
	up) dns_lock; cmd_up ;;
	down) dns_lock; cmd_down ;;
	where) dnsmasq_confdir ;;
	*) echo "usage: $0 up|down|where" >&2; exit 1 ;;
esac
